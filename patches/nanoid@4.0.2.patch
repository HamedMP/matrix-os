+// Validate before touching entropy state or entering a generation loop.
+export let validateSize = size => {
+  if (!Number.isInteger(size) || size < 0 || size > 0x7fffffff) {
+    throw new RangeError('Size must be an integer between 0 and 2147483647')
+  }
+  return size
+}
