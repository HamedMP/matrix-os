{
  "cli": {
    "version": ">= 20.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.14.0",
      "pnpm": "10.33.4"
    },
    // Each profile's `channel` binds its builds to an EAS Update channel, so a
    // published update only reaches builds from the matching profile. Builds made
    // before these channels existed cannot receive updates at all.
    //
    // `preview` and `production` are the two release channels. Updates are
    // published to `preview` and then promoted unchanged to `production`, so both
    // profiles read the `production` EAS environment: the promoted bundle must see
    // the same variables as the binary it lands on. Keep EXPO_PUBLIC_* values in
    // that EAS environment, not in a profile `env` block, which `eas update`
    // never reads.
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true
      }
    },
    "development-device": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "environment": "production",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      },
      "ios": {
        // Apple ID auth. ascAppId + appleTeamId are intentionally omitted so EAS
        // auto-resolves them (finds/creates the ASC app by bundleIdentifier and
        // derives the team from your authenticated session) during submit.
        // After the first successful submit, paste the real values here to skip
        // lookups: "ascAppId": "1234567890", "appleTeamId": "ABCDE12345".
        "appleId": "thehamedmp@gmail.com",
        "ascAppId": "6785629815",
        "appleTeamId": "PX4JL74Y2K"
        // Alternative (fully non-interactive CI): use an App Store Connect API key:
        //   "ascApiKeyPath": "./asc-api-key.p8",
        //   "ascApiKeyId": "XXXXXXXXXX",
        //   "ascApiKeyIssuerId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
