{
  "name": "@matrix-os/terminal-runtime",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./generation-closure": {
      "types": "./src/generation-closure.d.mts",
      "development": "./src/generation-closure.mjs",
      "default": "./dist/generation-closure.mjs"
    },
    "./generation-lock": {
      "types": "./src/generation-lock.ts",
      "development": "./src/generation-lock.ts",
      "default": "./dist/generation-lock.js"
    },
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./zellij-config": {
      "types": "./src/zellij-config.ts",
      "development": "./src/zellij-config.ts",
      "default": "./dist/zellij-config.js"
    },
    "./user-systemd-capacity": {
      "types": "./src/user-systemd-capacity.ts",
      "development": "./src/user-systemd-capacity.ts",
      "default": "./dist/user-systemd-capacity.js"
    },
    "./user-systemd-readiness": {
      "types": "./src/user-systemd-readiness.ts",
      "development": "./src/user-systemd-readiness.ts",
      "default": "./dist/user-systemd-readiness.js"
    },
    "./user-systemd-controller": {
      "types": "./src/user-systemd-controller.ts",
      "development": "./src/user-systemd-controller.ts",
      "default": "./dist/user-systemd-controller.js"
    }
  },
  "scripts": {
    "build": "tsc && cp src/*.mjs dist/"
  },
  "dependencies": {
    "@matrix-os/contracts": "workspace:*",
    "node-pty": "^1.1.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3"
  }
}
