{
  "name": "Calendar",
  "description": "Google and Outlook calendars with free-busy overlays and agent proposals you approve",
  "category": "productivity",
  "icon": "calendar",
  "author": "system",
  "version": "0.1.0",
  "slug": "calendar",
  "runtime": "vite",
  "runtimeVersion": "^1.0.0",
  "scope": "personal",
  "build": {
    "install": "pnpm install --ignore-workspace --prefer-offline",
    "command": "pnpm build",
    "output": "dist",
    "timeout": 180,
    "sourceGlobs": [
      "src/**",
      "../_shared/**",
      "../../system/icons/v3-*.png",
      "index.html",
      "matrix.json",
      "package.json",
      "tsconfig.json",
      "vite.config.ts"
    ]
  },
  "listingTrust": "first_party"
}
