#!/usr/bin/env bash
# Fingerprint fixed request files without following symlinks or unbounded reads.
update_file_identity() {
  python3 - "$@" <<'PY'
import hashlib
import os
import stat
import sys

digest = hashlib.sha256()
for path in sys.argv[1:]:
    try:
        info = os.lstat(path)
    except FileNotFoundError:
        digest.update(b"absent\0")
        continue
    digest.update(str((info.st_dev, info.st_ino, info.st_mode, info.st_size, info.st_mtime_ns)).encode())
    if stat.S_ISREG(info.st_mode) and info.st_size <= 65536:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        try:
            digest.update(os.read(fd, 65537))
        finally:
            os.close(fd)
    digest.update(b"\0")
print(digest.hexdigest())
PY
}

update_request_identity() {
  update_file_identity "$UPDATE_MARKER" "${1:-${UPDATE_TRIGGER:-$APP_DIR/.update-now}}" \
    "${UPDATE_VERSION_FILE:-$APP_DIR/.update-version}" "${UPDATE_CHANNEL_FILE:-$APP_DIR/.update-channel}"
}

# One fixed 195-byte record; fingerprints never contain transcript/credential data.
# Different/replaced target files remain eligible for fresh verification.
update_target_was_rejected() {
  local path="$1" index actual rejected
  case "$path" in
    "$UPDATE_MARKER") index=0 ;;
    "${UPDATE_VERSION_FILE:-$APP_DIR/.update-version}") index=1 ;;
    "${UPDATE_CHANNEL_FILE:-$APP_DIR/.update-channel}") index=2 ;;
    *) return 1 ;;
  esac
  actual="$(update_file_identity "$path")" || return 1
  rejected="$(python3 - "$APP_DIR/.update-rejected-targets" "$index" <<'PY_RECORD'
import os
import re
import stat
import sys
try:
    fd = os.open(sys.argv[1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
except FileNotFoundError:
    sys.exit(1)
try:
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_size != 195:
        sys.exit(1)
    data = os.read(fd, 196)
    if not re.fullmatch(rb"(?:[0-9a-f]{64}\n){3}", data):
        sys.exit(1)
    print(data.splitlines()[int(sys.argv[2])].decode())
finally:
    os.close(fd)
PY_RECORD
)" || return 1
  [ "$actual" = "$rejected" ]
}

# Claim the trigger by rename before comparing. A concurrently replaced trigger
# is restored with an exclusive hard link; an even newer trigger is never overwritten.
reject_unchanged_update_request() {
  local expected="$1" claimed actual marker_identity version_identity channel_identity record_temp restore_failed=false
  [ -n "$expected" ] || return 1
  if [ ! -e "$UPDATE_TRIGGER" ] && [ ! -L "$UPDATE_TRIGGER" ]; then return 0; fi
  marker_identity="$(update_file_identity "$UPDATE_MARKER")" || return 1
  version_identity="$(update_file_identity "${UPDATE_VERSION_FILE:-$APP_DIR/.update-version}")" || return 1
  channel_identity="$(update_file_identity "${UPDATE_CHANNEL_FILE:-$APP_DIR/.update-channel}")" || return 1
  claimed="$(mktemp "$APP_DIR/.update-rejected.XXXXXX")" || return 1
  if ! sudo mv -Tf -- "$UPDATE_TRIGGER" "$claimed"; then
    rm -f -- "$claimed"
    log "WARN: rejected update trigger could not be claimed"
    return 1
  fi
  if ! actual="$(update_request_identity "$claimed")" || [ "$actual" != "$expected" ]; then
    if ! sudo ln -- "$claimed" "$UPDATE_TRIGGER" 2>/dev/null; then
      if [ ! -e "$UPDATE_TRIGGER" ] && [ ! -L "$UPDATE_TRIGGER" ]; then
        log "ERROR: newer update trigger could not be restored"
        restore_failed=true
      fi
    fi
    if [ "$restore_failed" = true ]; then
      # Retain the claimed trigger for the operator; future cleanup is explicit.
      log "ERROR: retained claimed update trigger requires recovery"
      return 1
    fi
    sudo rm -f -- "$claimed"
    return 0
  fi
  record_temp="$(mktemp "$APP_DIR/.update-rejected-targets.XXXXXX")" || {
    sudo ln -- "$claimed" "$UPDATE_TRIGGER" 2>/dev/null || log "WARN: rejected trigger restoration deferred"
    return 1
  }
  if ! printf '%s\n%s\n%s\n' "$marker_identity" "$version_identity" "$channel_identity" > "$record_temp" \
    || ! mv -Tf -- "$record_temp" "$APP_DIR/.update-rejected-targets"; then
    rm -f -- "$record_temp"
    sudo ln -- "$claimed" "$UPDATE_TRIGGER" 2>/dev/null || log "WARN: rejected trigger restoration deferred"
    log "ERROR: rejected target record could not be stored"
    return 1
  fi
  # Retain the prepared target: a trigger-only apply can arrive at any point
  # in cleanup. Removing just the claimed trigger permits normal polling.
  # Polling refreshes this marker only when no explicit trigger is pending.
  sudo rm -f -- "$claimed"
  log "Permanently rejected unchanged update request; channel polling can resume"
}

requested_update_is_already_current() {
  local remote_version="$1"
  [ -f "$UPDATE_VERSION_FILE" ] && [ ! -L "$UPDATE_VERSION_FILE" ] || return 1
  [ "$remote_version" = "$(current_version)" ] || return 1
  [ ! -e "$UPDATE_PHASE_MARKER" ] && [ ! -L "$UPDATE_PHASE_MARKER" ] || return 1
  [ ! -e "$UPDATE_ERROR_MARKER" ] && [ ! -L "$UPDATE_ERROR_MARKER" ] || return 1
  installed_terminal_runtime_is_ready || return 1
}

consume_idempotent_update_request() {
  log "Exact requested version is already installed; consuming idempotent request"
  rm -f "$UPDATE_CHANNEL_FILE" "$UPDATE_VERSION_FILE"
  consume_update_trigger || log "WARN: failed to consume idempotent update trigger"
}

restore_funded_retry_claim() {
  local claimed="$1"
  if sudo ln -- "$claimed" "$UPDATE_TRIGGER" 2>/dev/null \
    || [ -e "$UPDATE_TRIGGER" ] || [ -L "$UPDATE_TRIGGER" ]; then
    sudo rm -f -- "$claimed"
  else
    log "ERROR: retained idempotent trigger claim requires recovery"
    return 1
  fi
}

schedule_current_funded_retry() {
  local expected="$1" claimed actual version version_identity channel_identity record_temp
  [ -n "$expected" ] && [ -f "$UPDATE_TRIGGER" ] && [ ! -L "$UPDATE_TRIGGER" ] || return 1
  version="$(head -c 129 "$UPDATE_VERSION_FILE")" || return 1
  [[ "$version" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] && [ "$version" = "$(current_version)" ] || return 1
  version_identity="$(update_file_identity "$UPDATE_VERSION_FILE")" || return 1
  channel_identity="$(update_file_identity "$UPDATE_CHANNEL_FILE")" || return 1
  claimed="$(mktemp "$APP_DIR/.update-idempotent.XXXXXXXX")" || return 1
  sudo mv -Tf -- "$UPDATE_TRIGGER" "$claimed" || { rm -f -- "$claimed"; return 1; }
  actual="$(update_request_identity "$claimed")" || actual=""
  if [ "$actual" != "$expected" ]; then
    restore_funded_retry_claim "$claimed" || return 1
    return 1
  fi
  # Retire only these exact consumed target identities, without unlinking paths
  # that may already hold a newer request. Never retire the prepared marker:
  # the next trigger-only apply must still see its pending newer release.
  record_temp="$(mktemp "$APP_DIR/.update-rejected-targets.XXXXXXXX")" || {
    restore_funded_retry_claim "$claimed" || return 1
    return 1
  }
  if ! printf '%064d\n%s\n%s\n' 0 "$version_identity" "$channel_identity" > "$record_temp" \
    || ! mv -Tf -- "$record_temp" "$APP_DIR/.update-rejected-targets"; then
    rm -f -- "$record_temp"
    restore_funded_retry_claim "$claimed" || return 1
    return 1
  fi
  sudo rm -f -- "$claimed" || return 1
  funded_host_bootstrap retry "$version" || log "WARN: funded host retry deferred"
}
