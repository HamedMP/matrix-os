#!/usr/bin/env python3
"""Owner CLI for the typed Matrix root update service."""

from __future__ import annotations

import json
import re
import socket
import struct
import sys
from typing import Any

MAX_FRAME_BYTES = 128 * 1024
SOCKET_PATH = "/run/matrix-update-runtime/update.sock"
CHANNELS = {"stable", "canary", "beta", "dev"}
VERSION_RE = re.compile(r"^(?:v[0-9]|main-[A-Za-z0-9])[A-Za-z0-9._-]{0,127}$")
USAGE = (
    "Usage: matrix-update "
    "[apply|rollback|repair|status|stable|canary|beta|dev|v<version>|main-<build>]"
)


def request_for(argument: str) -> dict[str, Any]:
    if argument == "apply":
        return {
            "schemaVersion": 1,
            "operation": "Apply",
            "target": {"kind": "channel", "value": "stable"},
        }
    if argument in CHANNELS:
        return {
            "schemaVersion": 1,
            "operation": "Apply",
            "target": {"kind": "channel", "value": argument},
        }
    if VERSION_RE.fullmatch(argument):
        return {
            "schemaVersion": 1,
            "operation": "Apply",
            "target": {"kind": "version", "value": argument},
        }
    operations = {
        "repair": "Repair",
        "rollback": "Rollback",
        "status": "Status",
    }
    operation = operations.get(argument)
    if operation is None:
        raise ValueError("invalid argument")
    return {"schemaVersion": 1, "operation": operation}


def read_exact(connection: socket.socket, size: int) -> bytes:
    chunks: list[bytes] = []
    remaining = size
    while remaining:
        chunk = connection.recv(remaining)
        if not chunk:
            raise RuntimeError("truncated response")
        chunks.append(chunk)
        remaining -= len(chunk)
    return b"".join(chunks)


def call_service(request: dict[str, Any]) -> dict[str, Any]:
    payload = json.dumps(request, separators=(",", ":")).encode("utf-8")
    if not payload or len(payload) > MAX_FRAME_BYTES:
        raise RuntimeError("request exceeds bound")
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(10)
        connection.connect(SOCKET_PATH)
        connection.sendall(struct.pack(">I", len(payload)) + payload)
        (length,) = struct.unpack(">I", read_exact(connection, 4))
        if length == 0 or length > MAX_FRAME_BYTES:
            raise RuntimeError("invalid response")
        response = json.loads(read_exact(connection, length))
    if not isinstance(response, dict) or response.get("schemaVersion") != 1:
        raise RuntimeError("invalid response")
    return response


def main() -> int:
    arguments = sys.argv[1:]
    if arguments[:1] == ["--no-tail"]:
        arguments = arguments[1:]
    if len(arguments) > 1:
        print(USAGE, file=sys.stderr)
        return 2
    argument = arguments[0] if arguments else "apply"
    try:
        request = request_for(argument)
    except ValueError:
        print(USAGE, file=sys.stderr)
        return 2
    try:
        response = call_service(request)
    except (json.JSONDecodeError, OSError, RuntimeError, TimeoutError):
        print("Update service unavailable.", file=sys.stderr)
        return 1
    if response.get("ok") is not True:
        print("Update request rejected.", file=sys.stderr)
        return 1
    print(f"Update service: {response.get('status', 'accepted')}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
