#!/usr/bin/env python3
"""Owner CLI for the typed Matrix root update service."""

from __future__ import annotations

import json
import re
import socket
import struct
import sys
from typing import Any

MAX_FRAME_BYTES = 128 * 1024
SOCKET_PATH = "/run/matrix-update-runtime/update.sock"
CHANNELS = {"stable", "canary", "beta", "dev"}
STATUSES = {"accepted", "failed", "idle", "running"}
PHASES = {
    "idle",
    "admitted",
    "resolving",
    "downloading",
    "validating",
    "extracting",
    "preparing",
    "committing",
    "health_check",
    "rollback",
    "failed",
}
FAILURE_CODES = {
    "operation_failed",
    "prepared_release_metadata_invalid",
    "staging_invalid",
    "insufficient_disk_space",
    "bundle_download_failed",
    "bundle_size_mismatch",
    "bundle_checksum_mismatch",
    "bundle_archive_invalid",
    "bundle_validation_timeout",
    "bundle_extraction_failed",
    "bundle_extraction_timeout",
    "bundle_shape_invalid",
    "bundle_ownership_timeout",
    "rollback_ownership_timeout",
    "terminal_runtime_candidate_invalid",
    "terminal_runtime_generation_install_failed",
    "update_runtime_install_failed",
    "privilege_boundary_install_failed",
    "terminal_runtime_wrapper_install_failed",
    "zellij_candidate_staging_failed",
    "zellij_candidate_commit_failed",
    "zellij_candidate_metadata_failed",
    "zellij_installed_digest_mismatch",
    "terminal_runtime_legacy_migration_failed",
    "systemd_unit_install_failed",
    "terminal_runtime_supervisor_enable_failed",
    "terminal_runtime_supervisor_start_failed",
    "terminal_runtime_supervisor_cleanup_failed",
    "update_runtime_enable_failed",
    "legacy_update_bridge_disable_failed",
    "health_check_failed",
}
VERSION_RE = re.compile(r"^(?:v[0-9]|main-[A-Za-z0-9])[A-Za-z0-9._-]{0,127}$")
USAGE = (
    "Usage: matrix-update "
    "[apply|rollback|repair|status|diagnose|stable|canary|beta|dev|v<version>|main-<build>]"
)


def request_for(argument: str) -> dict[str, Any]:
    if argument == "apply":
        return {
            "schemaVersion": 1,
            "operation": "Apply",
            "target": {"kind": "channel", "value": "stable"},
        }
    if argument in CHANNELS:
        return {
            "schemaVersion": 1,
            "operation": "Apply",
            "target": {"kind": "channel", "value": argument},
        }
    if VERSION_RE.fullmatch(argument):
        return {
            "schemaVersion": 1,
            "operation": "Apply",
            "target": {"kind": "version", "value": argument},
        }
    operations = {
        "repair": "Repair",
        "rollback": "Rollback",
        "status": "Status",
        "diagnose": "Status",
    }
    operation = operations.get(argument)
    if operation is None:
        raise ValueError("invalid argument")
    request: dict[str, Any] = {"schemaVersion": 1, "operation": operation}
    if argument == "diagnose":
        request["diagnostics"] = True
    return request


def read_exact(connection: socket.socket, size: int) -> bytes:
    chunks: list[bytes] = []
    remaining = size
    while remaining:
        chunk = connection.recv(remaining)
        if not chunk:
            raise RuntimeError("truncated response")
        chunks.append(chunk)
        remaining -= len(chunk)
    return b"".join(chunks)


def call_service(request: dict[str, Any]) -> dict[str, Any]:
    payload = json.dumps(request, separators=(",", ":")).encode("utf-8")
    if not payload or len(payload) > MAX_FRAME_BYTES:
        raise RuntimeError("request exceeds bound")
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(10)
        connection.connect(SOCKET_PATH)
        connection.sendall(struct.pack(">I", len(payload)) + payload)
        (length,) = struct.unpack(">I", read_exact(connection, 4))
        if length == 0 or length > MAX_FRAME_BYTES:
            raise RuntimeError("invalid response")
        response = json.loads(read_exact(connection, length))
    if not isinstance(response, dict) or response.get("schemaVersion") != 1:
        raise RuntimeError("invalid response")
    return response


def main() -> int:
    arguments = sys.argv[1:]
    if arguments[:1] == ["--no-tail"]:
        arguments = arguments[1:]
    if len(arguments) > 1:
        print(USAGE, file=sys.stderr)
        return 2
    argument = arguments[0] if arguments else "apply"
    try:
        request = request_for(argument)
    except ValueError:
        print(USAGE, file=sys.stderr)
        return 2
    try:
        response = call_service(request)
    except (json.JSONDecodeError, OSError, RuntimeError, TimeoutError):
        print("Update service unavailable.", file=sys.stderr)
        return 1
    if response.get("ok") is not True:
        print("Update request rejected.", file=sys.stderr)
        return 1
    status = response.get("status")
    if status not in STATUSES:
        print("Update service unavailable.", file=sys.stderr)
        return 1
    if argument == "diagnose":
        phase = response.get("phase")
        failure_code = response.get("failureCode")
        if (
            phase not in PHASES
            or (failure_code is not None and failure_code not in FAILURE_CODES)
            or set(response) != {
                "schemaVersion",
                "ok",
                "status",
                "phase",
                "failureCode",
            }
        ):
            print("Update service unavailable.", file=sys.stderr)
            return 1
        print(
            f"Update service: {status} "
            f"phase={phase} failure={failure_code or 'none'}"
        )
        return 0
    if set(response) != {"schemaVersion", "ok", "status"}:
        print("Update service unavailable.", file=sys.stderr)
        return 1
    print(f"Update service: {status}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
