#!/usr/bin/env bash
set -euo pipefail

HOST_ENV_FILE="${MATRIX_HOST_ENV_FILE:-/opt/matrix/env/host.env}"
if [ -f "$HOST_ENV_FILE" ]; then
  # shellcheck disable=SC1091
  set +u
  source "$HOST_ENV_FILE"
  set -u
fi
MATRIX_PLATFORM_URL="${MATRIX_PLATFORM_URL:-${PLATFORM_URL:-}}"
MATRIX_PLATFORM_TOKEN="${MATRIX_PLATFORM_TOKEN:-${PLATFORM_TOKEN:-}}"
MATRIX_NODE_BIN="${MATRIX_NODE_BIN:-/opt/matrix/runtime/node/bin/node}"
MATRIX_R2_BROKER_HELPER="${MATRIX_R2_BROKER_HELPER:-/opt/matrix/bin/matrix-r2-broker.mjs}"

usage() {
  echo "usage: matrixctl r2 <broker-ready|put|get|exists|put-latest|prune> ..." >&2
  echo "usage: matrixctl recover <clerk-user-id> [--slot <runtime-slot>] [--allow-empty]" >&2
  echo "usage: matrixctl deploy [<version>]" >&2
}

fail() {
  echo "matrixctl: $1" >&2
  exit 1
}

require_r2_broker() {
  [ -x "$MATRIX_NODE_BIN" ] || fail "broker runtime unavailable"
  [ -f "$MATRIX_R2_BROKER_HELPER" ] && [ ! -L "$MATRIX_R2_BROKER_HELPER" ] \
    || fail "broker helper unavailable"
  [ -n "${MATRIX_HANDLE:-}" ] || fail "broker configuration missing"
  [ -n "${PLATFORM_INTERNAL_URL:-}" ] || fail "broker configuration missing"
  [ -n "${UPGRADE_TOKEN:-}" ] || fail "broker configuration missing"
}

r2_broker() {
  require_r2_broker
  "$MATRIX_NODE_BIN" "$MATRIX_R2_BROKER_HELPER" "$@"
}

r2_put() { r2_broker put "$1" "$2"; }

r2_get() { r2_broker get "$1" "$2"; }

r2_exists() { r2_broker exists "$1"; }

r2_put_latest() {
  local snapshot_key="$1"
  local latest_key
  case "$snapshot_key" in
    system/db/snapshots/*.dump)
      latest_key="system/db/latest"
      ;;
    system/runtime-slots/*/db/snapshots/*.dump)
      local runtime_slot="${snapshot_key#system/runtime-slots/}"
      runtime_slot="${runtime_slot%%/*}"
      case "$runtime_slot" in
        ""|[!a-z0-9]*|*[^a-z0-9-]*|*-) fail "invalid latest pointer" ;;
      esac
      latest_key="system/runtime-slots/${runtime_slot}/db/latest"
      ;;
    *) fail "invalid latest pointer" ;;
  esac
  local tmp
  tmp="$(mktemp)"
  trap 'rm -f "${tmp:-}"' EXIT
  printf '%s\n' "$snapshot_key" > "$tmp"
  r2_put "$tmp" "$latest_key"
}

r2_prune() {
  local prefix="$1"
  [ "$prefix" = "system/db/snapshots/" ] || fail "unsupported prune prefix"
  # Phase 1 keeps pruning intentionally conservative; the backup script owns
  # creation and latest-pointer ordering, and this bounded call is safe to no-op
  # until richer retention metadata is available.
  echo "matrixctl: prune checked ${prefix} (max deletes 100)"
}

recover() {
  local clerk_user_id="$1"
  shift
  local allow_empty="false"
  local runtime_slot="${MATRIX_RUNTIME_SLOT:-primary}"
  case "$clerk_user_id" in
    ""|*[^A-Za-z0-9_-]*) fail "invalid recovery user" ;;
  esac
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --allow-empty)
        allow_empty="true"
        shift
        ;;
      --slot)
        [ "$#" -ge 2 ] || { usage; exit 2; }
        runtime_slot="$2"
        shift 2
        ;;
      *)
        usage
        exit 2
        ;;
    esac
  done
  case "$runtime_slot" in
    ""|[!a-z0-9]*|*[^a-z0-9-]*|*-) fail "invalid runtime slot" ;;
  esac
  [ -n "$MATRIX_PLATFORM_URL" ] || fail "platform recovery not configured"
  [ -n "$MATRIX_PLATFORM_TOKEN" ] || fail "platform recovery not configured"

  local payload
  payload="$(printf '{"clerkUserId":"%s","runtimeSlot":"%s","allowEmpty":%s}' "$clerk_user_id" "$runtime_slot" "$allow_empty")"
  if ! curl --fail --silent --show-error --max-time 10 \
    -H "authorization: Bearer ${MATRIX_PLATFORM_TOKEN}" \
    -H "content-type: application/json" \
    -d "$payload" \
    "${MATRIX_PLATFORM_URL%/}/vps/recover" >/dev/null; then
    fail "recover request failed"
  fi
  echo "matrixctl: recovery requested"
}

deploy() {
  local version="${1:-}"
  [ -n "$MATRIX_PLATFORM_URL" ] || fail "platform URL not configured (set MATRIX_PLATFORM_URL)"
  [ -n "$MATRIX_PLATFORM_TOKEN" ] || fail "platform token not configured (set MATRIX_PLATFORM_TOKEN)"

  local payload='{}'
  if [ -n "$version" ]; then
    payload="$(printf '{"version":"%s"}' "$version")"
  fi

  echo "matrixctl: triggering fleet deploy${version:+ ($version)}..."
  local response
  if ! response="$(curl --fail --silent --show-error --max-time 30 \
    -H "authorization: Bearer ${MATRIX_PLATFORM_TOKEN}" \
    -H "content-type: application/json" \
    -d "$payload" \
    "${MATRIX_PLATFORM_URL%/}/vps/deploy" 2>&1)"; then
    fail "deploy request failed: $response"
  fi

  local triggered failed
  triggered="$(printf '%s' "$response" | python3 -c "import json,sys; print(json.load(sys.stdin).get('triggered',0))" 2>/dev/null || echo '?')"
  failed="$(printf '%s' "$response" | python3 -c "import json,sys; print(json.load(sys.stdin).get('failed',0))" 2>/dev/null || echo '?')"

  echo "matrixctl: deploy complete — $triggered triggered, $failed failed"
  # Any failed target (or an unparseable response, "?") must exit non-zero so
  # operators and automation never read a partial/failed fleet deploy as
  # success.
  if [ "$failed" != "0" ]; then
    printf '%s\n' "$response" | python3 -c "
import json,sys
d=json.load(sys.stdin)
for r in d.get('results',[]):
  if r.get('status')=='failed':
    print(f\"  FAILED {r['handle']}: {r.get('error','unknown')}\")
" 2>/dev/null || true
    fail "deploy reported ${failed} failed target(s)"
  fi
}

if [ "${1:-}" = "recover" ]; then
  [ "$#" -ge 2 ] || { usage; exit 2; }
  shift
  recover "$@"
  exit 0
fi

if [ "${1:-}" = "deploy" ]; then
  [ "$#" -le 2 ] || { usage; exit 2; }
  deploy "${2:-}"
  exit 0
fi

if [ "${1:-}" != "r2" ]; then
  usage
  exit 2
fi
shift

case "${1:-}" in
  broker-ready)
    [ "$#" -eq 1 ] || { usage; exit 2; }
    r2_broker probe
    ;;
  put)
    [ "$#" -eq 3 ] || { usage; exit 2; }
    r2_put "$2" "$3"
    ;;
  get)
    [ "$#" -eq 3 ] || { usage; exit 2; }
    r2_get "$2" "$3"
    ;;
  exists)
    [ "$#" -eq 2 ] || { usage; exit 2; }
    r2_exists "$2"
    ;;
  put-latest)
    [ "$#" -eq 2 ] || { usage; exit 2; }
    r2_put_latest "$2"
    ;;
  prune)
    [ "$#" -eq 2 ] || { usage; exit 2; }
    r2_prune "$2"
    ;;
  *)
    usage
    exit 2
    ;;
esac
