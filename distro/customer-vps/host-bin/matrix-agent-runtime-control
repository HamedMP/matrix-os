#!/usr/bin/env bash
set -euo pipefail
umask 077

validate_request() {
  case "${1:-}" in
    status)
      [ "$#" -eq 1 ] || return 1
      ;;
    install|switch|stop|cancel-install|uninstall)
      [ "$#" -eq 2 ] || return 1
      case "${2:-}" in
        hermes|openclaw) ;;
        *) return 1 ;;
      esac
      ;;
    *) return 1 ;;
  esac
}

validate_request "$@" || { printf '{"ok":false,"code":"invalid_request"}\n'; exit 2; }

# All mutations cross one validated, root-owned host-control boundary. This
# keeps the visible terminal command unprivileged and gives the hardened sudo
# policy one exact executable to allow instead of exposing installer commands.
if [ "${1:-}" != status ] && [ "$(id -u)" -ne 0 ]; then
  exec sudo -n /opt/matrix/bin/matrix-agent-runtime-control "$@"
fi

if [ -r /opt/matrix/env/host.env ]; then
  source /opt/matrix/env/host.env
fi
if [ -r /opt/matrix/bin/matrix-owner-env ]; then
  source /opt/matrix/bin/matrix-owner-env
  matrix_export_owner_env
fi

MATRIX_RUNTIME_HOME="${MATRIX_RUNTIME_HOME:-${MATRIX_HOME:-/home/matrix/home}}"
MATRIX_NODE_PREFIX="${MATRIX_NODE_PREFIX:-/opt/matrix/runtime/node}"
MATRIX_RUNTIME_USER="${MATRIX_RUNTIME_USER:-matrix}"
MATRIX_RUNTIME_GROUP="${MATRIX_RUNTIME_GROUP:-$MATRIX_RUNTIME_USER}"
install_timeout_seconds=1810
action_timeout_seconds=50
cancel_timeout_seconds=25
active_wait_seconds=45
# This root-owned directory holds control state only, never owner data. Status
# reads need no lock; cancellation stops the unit while fencing any late launch.
readonly state_dir=/var/lib/matrix-agent-runtime
ensure_control_state() {
  [ ! -L "$state_dir" ] || { printf '{"ok":false,"code":"runtime_unavailable"}\n'; exit 3; }
  install -d -o root -g root -m 0755 "$state_dir"
}
acquire_control_lock() {
  ensure_control_state
  [ ! -L "$state_dir/host-control.lock" ] || { printf '{"ok":false,"code":"runtime_unavailable"}\n'; exit 3; }
  exec 9>"$state_dir/host-control.lock"
  flock -w 30 9 || { printf '{"ok":false,"code":"runtime_busy"}\n'; exit 4; }
}

is_active() {
  systemctl is-active --quiet "$1"
}

is_enabled() {
  systemctl is-enabled --quiet "$1"
}

print_status() {
  local hermes_installed=false hermes_running=false openclaw_installed=false openclaw_running=false
  [ -x "$MATRIX_RUNTIME_HOME/.local/bin/hermes" ] && hermes_installed=true
  [ -x "$MATRIX_NODE_PREFIX/bin/openclaw" ] && openclaw_installed=true
  is_active matrix-hermes-dashboard.service && hermes_running=true
  is_active matrix-openclaw-gateway.service && openclaw_running=true
  printf '{"ok":true,"hermes":{"installed":%s,"running":%s},"openclaw":{"installed":%s,"running":%s}}\n' \
    "$hermes_installed" "$hermes_running" "$openclaw_installed" "$openclaw_running"
}

wait_active() {
  local unit="$1" deadline=$((SECONDS + active_wait_seconds))
  while [ "$SECONDS" -lt "$deadline" ]; do
    is_active "$unit" && return 0
    sleep 0.5
  done
  return 1
}

openclaw_admission_ready() {
  local memory_available_kib disk_available_kib
  memory_available_kib="$(awk '/^MemAvailable:/ { print $2 }' /proc/meminfo)"
  disk_available_kib="$(df -Pk "$MATRIX_RUNTIME_HOME" | awk 'NR == 2 { print $4 }')"
  [ "$memory_available_kib" -ge 786432 ] && [ "$disk_available_kib" -ge 1048576 ]
}

install_runtime() {
  local runtime="$1" installer executable
  case "$runtime" in
    hermes)
      installer=/opt/matrix/bin/matrix-install-hermes
      executable="$MATRIX_RUNTIME_HOME/.local/bin/hermes"
      ;;
    openclaw)
      installer=/opt/matrix/bin/matrix-install-openclaw
      executable="$MATRIX_NODE_PREFIX/bin/openclaw"
      ;;
    *) printf '{"ok":false,"code":"invalid_request"}\n'; exit 2 ;;
  esac

  acquire_control_lock
  rm -f -- "$state_dir/disabled-$runtime"
  # Stop automatic installation before opening the user-visible managed unit.
  if [ "$runtime" = hermes ]; then
    timeout "$action_timeout_seconds" systemctl stop matrix-hermes.service || { printf '{"ok":false,"code":"install_failed"}\n'; exit 5; }
  fi
  [ -x "$installer" ] || { printf '{"ok":false,"code":"runtime_unavailable"}\n'; exit 3; }
  if [ ! -x "$executable" ]; then
    if ! systemd-run --unit="matrix-agent-install-$runtime" --wait --pipe --collect \
      --service-type=exec --property=KillMode=control-group \
      --property="RuntimeMaxSec=$install_timeout_seconds" --property=TimeoutStopSec=15 \
      "$installer"; then
      printf '{"ok":false,"code":"install_failed"}\n'
      exit 5
    fi
  fi
  [ -x "$executable" ] || { printf '{"ok":false,"code":"install_failed"}\n'; exit 5; }
  printf '{"ok":true,"runtime":"%s","installed":true}\n' "$runtime"
}

stop_install_unit() {
  local unit="matrix-agent-install-$1.service" load_state deadline="${2:-0}" remaining="$action_timeout_seconds"
  if [ "$deadline" -gt 0 ]; then remaining=$((deadline - SECONDS)); [ "$remaining" -gt 0 ] || return 1; fi
  load_state="$(timeout "$remaining" systemctl show --property=LoadState --value "$unit")" || return 1
  [ "$load_state" = not-found ] && return 0
  if [ "$deadline" -gt 0 ]; then remaining=$((deadline - SECONDS)); [ "$remaining" -gt 0 ] || return 1; fi
  timeout "$remaining" systemctl stop "$unit"
}

cancel_install() {
  local runtime="$1" deadline=$((SECONDS + cancel_timeout_seconds)) remaining
  ensure_control_state
  [ ! -L "$state_dir/host-control.lock" ] || { printf '{"ok":false,"code":"cancellation_failed"}\n'; exit 5; }
  exec 9>"$state_dir/host-control.lock"
  # Install holds this lock before launching systemd-run and until its --wait
  # child drains. A not-found unit alone cannot prove a pending launch stopped.
  while true; do
    if ! stop_install_unit "$runtime" "$deadline"; then
      printf '{"ok":false,"code":"cancellation_failed"}\n'; exit 5
    fi
    flock -n 9 && break
    [ "$SECONDS" -lt "$deadline" ] || { printf '{"ok":false,"code":"cancellation_failed"}\n'; exit 5; }
    sleep 0.1
  done
  # With the installer lock held, no earlier launch can now create another unit.
  if ! stop_install_unit "$runtime" "$deadline"; then
    printf '{"ok":false,"code":"cancellation_failed"}\n'; exit 5
  fi
  remaining=$((deadline - SECONDS))
  if [ "$remaining" -le 0 ] || { [ "$runtime" = hermes ] && ! timeout "$remaining" systemctl stop matrix-hermes.service; }; then
    printf '{"ok":false,"code":"cancellation_failed"}\n'; exit 5
  fi
  printf '{"ok":true,"runtime":"%s","cancelled":true}\n' "$runtime"
}

mark_runtime_disabled() {
  local runtime="$1" marker="$state_dir/disabled-$1"
  # Root-owned control state: a concurrent exclusive creator is a successful
  # repeat only if its winner is a regular file, never an owner-data symlink.
  [ ! -L "$marker" ] || { printf '{"ok":false,"code":"uninstall_failed"}\n'; exit 5; }
  if [ ! -f "$marker" ]; then
    (set -o noclobber; printf 'disabled\n' >"$marker") || {
      [ -f "$marker" ] && [ ! -L "$marker" ] || { printf '{"ok":false,"code":"uninstall_failed"}\n'; exit 5; }
    }
  fi
}

managed_hermes_launcher() {
  local launcher="$1" install_dir="${HERMES_HOME:-$MATRIX_RUNTIME_HOME/.hermes}/hermes-agent"
  if [ -L "$launcher" ]; then
    [ "$(readlink "$launcher")" = "$install_dir/venv/bin/hermes" ]
  elif [ -f "$launcher" ]; then
    # Exact shim emitted by the pinned upstream installer, not a path heuristic.
    cmp -s "$launcher" <(printf '#!/usr/bin/env bash\nunset PYTHONPATH\nunset PYTHONHOME\nexec "%s/venv/bin/python" "%s/hermes" "$@"\n' "$install_dir" "$install_dir")
  else
    [ ! -e "$launcher" ]
  fi
}

uninstall_runtime() {
  local runtime="$1" unit launcher
  ensure_control_state
  # The durable opt-out is written before stopping services so reconciliation
  # cannot reinstall a package during or after a partial uninstall.
  mark_runtime_disabled "$runtime"
  if ! stop_install_unit "$runtime"; then
    printf '{"ok":false,"code":"uninstall_failed"}\n'; exit 5
  fi
  if [ "$runtime" = hermes ] && ! timeout "$action_timeout_seconds" systemctl disable --now matrix-hermes.service; then
    printf '{"ok":false,"code":"uninstall_failed"}\n'; exit 5
  fi
  acquire_control_lock
  # An installer holding the lock may have cleared the early cancellation
  # marker. Reassert the durable opt-out before removing any runtime files.
  mark_runtime_disabled "$runtime"
  case "$runtime" in
    hermes) unit=matrix-hermes-dashboard.service ;;
    openclaw) unit=matrix-openclaw-gateway.service ;;
  esac
  if ! timeout "$action_timeout_seconds" systemctl disable --now "$unit"; then
    printf '{"ok":false,"code":"uninstall_failed"}\n'; exit 5
  fi
  case "$runtime" in
    hermes)
      # Hermes stores its code and personal state together in .hermes. Retain
      # that entire directory; remove only the managed executable entrypoint.
      for directory in "$MATRIX_RUNTIME_HOME" "$MATRIX_RUNTIME_HOME/.local" "$MATRIX_RUNTIME_HOME/.local/bin"; do
        [ ! -L "$directory" ] || { printf '{"ok":false,"code":"uninstall_failed"}\n'; exit 5; }
      done
      launcher="$MATRIX_RUNTIME_HOME/.local/bin/hermes"
      managed_hermes_launcher "$launcher" || { printf '{"ok":false,"code":"uninstall_failed"}\n'; exit 5; }
      if ! timeout "$action_timeout_seconds" setpriv --reuid "$MATRIX_RUNTIME_USER" --regid "$MATRIX_RUNTIME_GROUP" --init-groups rm -f -- "$launcher"; then
        printf '{"ok":false,"code":"uninstall_failed"}\n'; exit 5
      fi
      if [ -L /usr/local/bin/hermes ] && [ "$(readlink /usr/local/bin/hermes)" = "$launcher" ]; then
        rm -f -- /usr/local/bin/hermes
      fi
      ;;
    openclaw)
      [ -x "$MATRIX_NODE_PREFIX/bin/npm" ] || { printf '{"ok":false,"code":"uninstall_failed"}\n'; exit 5; }
      if ! timeout 300 setpriv --reuid "$MATRIX_RUNTIME_USER" --regid "$MATRIX_RUNTIME_GROUP" --init-groups \
        env HOME="$MATRIX_RUNTIME_HOME" PATH="$MATRIX_NODE_PREFIX/bin:/usr/local/bin:/usr/bin:/bin" \
        "$MATRIX_NODE_PREFIX/bin/npm" uninstall --global --ignore-scripts --prefix "$MATRIX_NODE_PREFIX" openclaw; then
        printf '{"ok":false,"code":"uninstall_failed"}\n'; exit 5
      fi
      ;;
  esac
  printf '{"ok":true,"runtime":"%s","installed":false}\n' "$runtime"
}

switch_runtime() {
  local runtime="$1" target_unit other_unit prior_active=false prior_enabled=false
  case "$runtime" in
    hermes)
      [ -x "$MATRIX_RUNTIME_HOME/.local/bin/hermes" ] || { printf '{"ok":false,"code":"runtime_unavailable"}\n'; exit 3; }
      target_unit=matrix-hermes-dashboard.service
      other_unit=matrix-openclaw-gateway.service
      ;;
    openclaw)
      [ -x "$MATRIX_NODE_PREFIX/bin/openclaw" ] || { printf '{"ok":false,"code":"runtime_unavailable"}\n'; exit 3; }
      [ -s "$MATRIX_RUNTIME_HOME/system/agent-runtime/openclaw.env" ] || { printf '{"ok":false,"code":"auth_required"}\n'; exit 3; }
      openclaw_admission_ready || { printf '{"ok":false,"code":"resources_unavailable"}\n'; exit 3; }
      target_unit=matrix-openclaw-gateway.service
      other_unit=matrix-hermes-dashboard.service
      ;;
    *) printf '{"ok":false,"code":"invalid_request"}\n'; exit 2 ;;
  esac

  is_active "$other_unit" && prior_active=true
  is_enabled "$other_unit" && prior_enabled=true
  if ! timeout "$action_timeout_seconds" systemctl disable --now "$other_unit"; then
    printf '{"ok":false,"code":"deactivation_failed"}\n'
    exit 5
  fi
  if ! timeout "$action_timeout_seconds" systemctl enable --now "$target_unit" || ! wait_active "$target_unit"; then
    timeout "$action_timeout_seconds" systemctl disable --now "$target_unit" || true
    if [ "$prior_enabled" = true ]; then
      if ! timeout "$action_timeout_seconds" systemctl enable --now "$other_unit" || ! wait_active "$other_unit"; then
        printf '{"ok":false,"code":"rollback_failed"}\n'
        exit 6
      fi
    elif [ "$prior_active" = true ]; then
      if ! timeout "$action_timeout_seconds" systemctl start "$other_unit" || ! wait_active "$other_unit"; then
        printf '{"ok":false,"code":"rollback_failed"}\n'
        exit 6
      fi
    fi
    printf '{"ok":false,"code":"activation_failed"}\n'
    exit 5
  fi
  printf '{"ok":true,"runtime":"%s"}\n' "$runtime"
}

stop_runtime() {
  local runtime="$1" unit
  case "$runtime" in
    hermes) unit=matrix-hermes-dashboard.service ;;
    openclaw) unit=matrix-openclaw-gateway.service ;;
    *) printf '{"ok":false,"code":"invalid_request"}\n'; exit 2 ;;
  esac
  if ! timeout "$action_timeout_seconds" systemctl disable --now "$unit"; then
    printf '{"ok":false,"code":"deactivation_failed"}\n'
    exit 5
  fi
  printf '{"ok":true,"runtime":"%s"}\n' "$runtime"
}

case "${1:-}" in
  status)
    print_status
    ;;
  install)
    install_runtime "$2"
    ;;
  cancel-install)
    cancel_install "$2"
    ;;
  uninstall)
    uninstall_runtime "$2"
    ;;
  switch)
    acquire_control_lock
    case "${2:-}" in
      hermes) switch_runtime hermes ;;
      openclaw) switch_runtime openclaw ;;
      *) printf '{"ok":false,"code":"invalid_request"}\n'; exit 2 ;;
    esac
    ;;
  stop)
    acquire_control_lock
    case "${2:-}" in
      hermes) stop_runtime hermes ;;
      openclaw) stop_runtime openclaw ;;
      *) printf '{"ok":false,"code":"invalid_request"}\n'; exit 2 ;;
    esac
    ;;
  *) printf '{"ok":false,"code":"invalid_request"}\n'; exit 2 ;;
esac
