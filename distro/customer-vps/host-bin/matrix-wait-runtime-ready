#!/usr/bin/env bash
set -euo pipefail

readonly READY_MARKER="/opt/matrix/register-complete"
readonly READY_TIMEOUT_SECONDS="${MATRIX_OPTIONAL_TOOLS_READY_TIMEOUT_SECONDS:-900}"
readonly START_DELAY_SECONDS="${MATRIX_OPTIONAL_TOOLS_START_DELAY_SECONDS:-90}"

valid_duration() {
  [[ "$1" =~ ^[0-9]{1,4}$ ]] && [ "$1" -le 3600 ]
}

if ! valid_duration "$READY_TIMEOUT_SECONDS" || ! valid_duration "$START_DELAY_SECONDS"; then
  echo "matrix-wait-runtime-ready: invalid bounded duration" >&2
  exit 64
fi

deadline=$(( $(date +%s) + READY_TIMEOUT_SECONDS ))
while [ ! -f "$READY_MARKER" ] || [ -L "$READY_MARKER" ]; do
  if [ "$(date +%s)" -ge "$deadline" ]; then
    echo "matrix-wait-runtime-ready: runtime readiness timed out" >&2
    exit 75
  fi
  sleep 2
done

ready_at="$(stat -c %Y "$READY_MARKER")"
delay_until=$(( ready_at + START_DELAY_SECONDS ))
remaining=$(( delay_until - $(date +%s) ))
if [ "$remaining" -gt 0 ]; then
  sleep "$remaining"
fi
