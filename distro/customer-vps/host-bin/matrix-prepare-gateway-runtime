#!/usr/bin/env bash
set -euo pipefail

node_path="/opt/matrix/runtime/node"
node_modules="$node_path/lib/node_modules"
node_bin="$node_path/bin"
runtime_root="/opt/matrix/runtime"
mode="${1:-}"

case "$mode" in
  "--prepare-supervised-v1") ;;
  *)
    echo "matrix-prepare-gateway-runtime: invalid_mode" >&2
    exit 1
    ;;
esac

for required in "$runtime_root" "$node_path" "$node_modules" "$node_bin"; do
  [ -d "$required" ] && [ ! -L "$required" ] || {
    echo "matrix-prepare-gateway-runtime: invalid_node_runtime" >&2
    exit 1
  }
done
if [ "$(stat -c %U "$runtime_root")" != "root" ] ||
  find -P "$runtime_root" -maxdepth 0 -perm /022 -print -quit | grep -q .; then
  echo "matrix-prepare-gateway-runtime: invalid_runtime_root" >&2
  exit 1
fi

chown root:matrix "$node_path" "$node_modules" "$node_bin"
chmod g+rwX "$node_modules" "$node_bin"
while IFS= read -r -d '' directory; do
  chown root:matrix "$directory"
  chmod g+rws "$directory"
done < <(
  find -P "$node_path" -xdev \
    \( -path "$node_modules" -o -path "$node_modules/*" -o \
       -path "$node_bin" -o -path "$node_bin/*" \) \
    -type d -print0
)
