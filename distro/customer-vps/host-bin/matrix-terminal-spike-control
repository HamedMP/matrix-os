#!/usr/bin/env bash
set -euo pipefail
if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
  echo "spike_control_invalid_request" >&2
  exit 2
fi
operation="$1"
pr_head_sha="$2"
case "$operation" in
  launch | pack)
    [ "$#" -eq 2 ] || { echo "spike_control_invalid_request" >&2; exit 2; }
    ;;
  activation-watch-arm | activation-watch-run | activation-watch-status)
    [ "$#" -eq 2 ] || { echo "spike_control_invalid_request" >&2; exit 2; }
    ;;
  acceptance-launch | acceptance-status | acceptance-reboot | acceptance-resume | acceptance-pack)
    [ "$#" -eq 3 ] && [[ "$3" =~ ^[1-9][0-9]{0,19}-[1-9][0-9]{0,5}$ ]] ||
      { echo "spike_control_invalid_request" >&2; exit 2; }
    ;;
  *)
    echo "spike_control_invalid_request" >&2
    exit 2
    ;;
esac
if [[ ! "$pr_head_sha" =~ ^[0-9a-f]{40}$ ]]; then
  echo "spike_control_invalid_request" >&2
  exit 2
fi
if [ "$(id -u)" -ne 0 ]; then
  echo "spike_control_requires_root" >&2
  exit 3
fi
watch_copy="/run/matrix-terminal-activation-watch"
watch_root="/var/lib/matrix-terminal-activation-watch"
watch_result="/var/lib/matrix-terminal-activation-watch/result"
watch_unit="matrix-terminal-activation-watch@${pr_head_sha}.service"
legacy_watch_unit="matrix-terminal-activation-watch.service"
write_watch_result() {
  temporary="$(mktemp --tmpdir="$watch_root" .result.XXXXXXXXXX)"
  printf '%s\n' "$1" >"$temporary"
  chmod 0600 "$temporary"
  mv -f -- "$temporary" "$watch_result"
  sync -f "$watch_result"
  sync -f "$watch_root"
}
activation_watch_rescue() {
  exec /usr/bin/python3 - "$pr_head_sha" "$watch_result" \
    /opt/matrix/env/host.env <<'PY'
import hmac
import json
import os
import re
import stat
import sys
from http.server import BaseHTTPRequestHandler, HTTPServer

head_sha, result_path, environment_path = sys.argv[1:4]

def read_pinned(path, metadata, maximum):
    descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    try:
        opened = os.fstat(descriptor)
        if (metadata.st_dev, metadata.st_ino) != (opened.st_dev, opened.st_ino):
            raise ValueError("replaced file")
        payload = os.read(descriptor, maximum + 1)
    finally:
        os.close(descriptor)
    if len(payload) > maximum:
        raise ValueError("oversized file")
    return payload

def load_token(path):
    metadata = os.lstat(path)
    if (
        not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != 0
        or metadata.st_mode & 0o022
        or metadata.st_nlink != 1
        or metadata.st_size < 1
        or metadata.st_size > 64 * 1024
    ):
        raise ValueError("invalid environment")
    for line in read_pinned(path, metadata, 64 * 1024).decode().splitlines():
        if line.startswith("UPGRADE_TOKEN="):
            token = line.removeprefix("UPGRADE_TOKEN=").strip()
            if re.fullmatch(r"[0-9a-f]{64}", token):
                return token
    raise ValueError("missing token")

def load_result(path):
    metadata = os.lstat(path)
    if (
        not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != 0
        or stat.S_IMODE(metadata.st_mode) != 0o600
        or metadata.st_nlink != 1
        or metadata.st_size < 1
        or metadata.st_size > 256
    ):
        raise ValueError("invalid result")
    result = read_pinned(path, metadata, 256).decode().strip()
    if not re.fullmatch(
        r"activation_watch_timeout state=(idle|running|failed|unknown) "
        r"phase=[a-z_]{1,32} failure=(none|[a-z0-9_]{1,64}) "
        r"gateway=[a-z]+ supervisor=[a-z]+ recovery=rescue",
        result,
    ):
        raise ValueError("invalid result")
    return result

token = load_token(environment_path)
result = load_result(result_path)
expected_command = ["/usr/bin/sudo", "/opt/matrix/bin/matrix-terminal-spike-control", "activation-watch-status", head_sha]

class Handler(BaseHTTPRequestHandler):
    server_version = "MatrixPreviewRescue/1"
    sys_version = ""

    def log_message(self, _format, *_args):
        return

    def respond(self, status, payload):
        encoded = json.dumps(payload, separators=(",", ":")).encode()
        self.send_response(status)
        self.send_header("content-type", "application/json")
        self.send_header("content-length", str(len(encoded)))
        self.send_header("connection", "close")
        self.end_headers()
        self.wfile.write(encoded)

    def do_POST(self):
        authorization = self.headers.get("authorization", "")
        supplied = authorization.removeprefix("Bearer ")
        try:
            length = int(self.headers.get("content-length", "0"))
        except ValueError:
            length = 0
        if (
            self.path != "/api/terminal/run"
            or not hmac.compare_digest(supplied, token)
            or not 0 < length <= 128 * 1024
        ):
            self.respond(404, {"error": "unavailable"})
            return
        try:
            request = json.loads(self.rfile.read(length))
        except (UnicodeDecodeError, json.JSONDecodeError):
            self.respond(400, {"error": "invalid_request"})
            return
        if request != {"command": expected_command, "timeoutMs": 10000}:
            self.respond(400, {"error": "invalid_request"})
            return
        self.respond(
            200,
            {
                "exitCode": 0,
                "timedOut": False,
                "truncated": False,
                "signal": None,
                "stdout": f"{result}\n",
                "stderr": "",
            },
        )

HTTPServer(("127.0.0.1", 4000), Handler).serve_forever()
PY
}
if [ "$operation" = activation-watch-arm ]; then
  systemctl stop "$legacy_watch_unit" >/dev/null 2>&1 || true
  systemctl stop "$watch_unit" >/dev/null 2>&1 || true
  systemctl reset-failed "$watch_unit" >/dev/null 2>&1 || true
  [ ! -L "$watch_root" ] || { echo spike_control_invalid_state >&2; exit 3; }
  install -d -o root -g root -m 0700 "$watch_root"
  rm -f -- "$watch_result"
  install -o root -g root -m 0700 "$0" "$watch_copy"
  if ! systemctl start "$watch_unit"; then
    echo spike_control_watch_start_failed >&2
    exit 3
  fi
  echo activation_watch_armed
  exit 0
fi
if [ "$operation" = activation-watch-status ]; then
  metadata="$(stat -c '%U:%G:%a:%h:%s' "$watch_result" 2>/dev/null || true)"
  if [ ! -f "$watch_result" ] || [ -L "$watch_result" ] ||
    [[ ! "$metadata" =~ ^root:root:600:1:([1-9][0-9]{0,2})$ ]] ||
    [ "${BASH_REMATCH[1]:-257}" -gt 256 ]; then
    echo activation_watch_pending
    exit 0
  fi
  exec /bin/cat "$watch_result"
fi
if [ "$operation" = activation-watch-run ]; then
  seen_running=false
  for _ in $(seq 1 300); do
    state="$(cat /run/matrix-update-runtime/operation-state 2>/dev/null || true)"
    [ "$state" = running ] && seen_running=true
    if [ "$seen_running" = true ] && [ "$state" = idle ] &&
      systemctl is-active --quiet matrix-gateway.service &&
      systemctl is-active --quiet matrix-terminal-runtime.service &&
      curl --fail --silent --max-time 2 http://127.0.0.1:4000/health >/dev/null; then
      write_watch_result activation_watch_success
      exit 0
    fi
    sleep 1
  done
  state="$(cat /run/matrix-update-runtime/operation-state 2>/dev/null || true)"
  phase="$(cat /run/matrix-update-runtime/operation-phase 2>/dev/null || true)"
  [[ "$state" =~ ^(idle|running|failed)$ ]] || state=unknown
  [[ "$phase" =~ ^[a-z_]{1,32}$ ]] || phase=unknown
  failure="$(cat /run/matrix-update-runtime/last-failure-code 2>/dev/null || true)"
  [[ "$failure" =~ ^[a-z0-9_]{1,64}$ ]] || failure=none
  gateway="$(systemctl is-active matrix-gateway.service 2>/dev/null || true)"
  supervisor="$(systemctl is-active matrix-terminal-runtime.service 2>/dev/null || true)"
  systemctl restart matrix-update-runtime.service
  recovery=failed
  for _ in $(seq 1 30); do
    [ -S /run/matrix-update-runtime/update.sock ] && break
    sleep 1
  done
  if /opt/matrix/bin/matrix-update rollback >/dev/null 2>&1; then
    for _ in $(seq 1 180); do
      if [ "$(cat /run/matrix-update-runtime/operation-state 2>/dev/null || true)" = idle ] &&
        systemctl is-active --quiet matrix-gateway.service &&
        curl --fail --silent --max-time 2 http://127.0.0.1:4000/health >/dev/null; then
        recovery=rollback
        break
      fi
      sleep 1
    done
  fi
  if [ "$recovery" = failed ]; then recovery=rescue; fi
  write_watch_result \
    "activation_watch_timeout state=$state phase=$phase failure=$failure gateway=$gateway supervisor=$supervisor recovery=$recovery"
  if [ "$recovery" = rescue ]; then
    systemctl stop matrix-gateway.service >/dev/null 2>&1 || true
    activation_watch_rescue
  fi
  exit 1
fi
case "$operation" in
  launch)
    target="/opt/matrix/libexec/terminal-runtime/current/spikes/launch-remote.sh"
    ;;
  pack)
    target="/opt/matrix/libexec/terminal-runtime/current/spikes/pack-evidence.sh"
    ;;
  acceptance-launch | acceptance-status | acceptance-reboot | acceptance-resume | acceptance-pack)
    target="/opt/matrix/libexec/terminal-runtime/current/spikes/production-acceptance.sh"
    set -- "${operation#acceptance-}" "$pr_head_sha" "$3"
    ;;
esac
if [ ! -f "$target" ] || [ -L "$target" ] || [ ! -x "$target" ]; then
  failure_code=""
  failure_code_path="/run/matrix-update-runtime/last-failure-code"
  if [ -f "$failure_code_path" ] && [ ! -L "$failure_code_path" ]; then
    IFS= read -r failure_code <"$failure_code_path" || true
  fi
  if [[ "$failure_code" =~ ^[a-z0-9_]{1,64}$ ]]; then
    echo "spike_control_unavailable_${failure_code}" >&2
    exit 3
  fi
  echo "spike_control_unavailable" >&2
  exit 3
fi
if [[ "$operation" == acceptance-* ]]; then
  exec "$target" "$@"
fi
exec "$target" "$pr_head_sha"
