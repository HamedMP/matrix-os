#!/usr/bin/env bash
set -euo pipefail

HOST_ENV_FILE="/opt/matrix/env/host.env"
NODE_BIN="/opt/matrix/runtime/node/bin/node"
SERVER_PATH="/opt/matrix/app/packages/integrations-mcp/dist/cli.js"

require_scoped=false
if [ "$#" -gt 0 ]; then
  if [ "$#" -ne 1 ] || [ "$1" != "--require-scoped-capability" ]; then
    echo "matrix-integrations-mcp: unsupported launcher arguments" >&2
    exit 3
  fi
  require_scoped=true
fi

read_host_value() {
  local key value
  key="$1"
  value="$(awk -F= -v key="$key" '$1 == key {sub(/^[^=]*=/, ""); print; exit}' "$HOST_ENV_FILE")"
  [ -n "$value" ] || return 1
  printf '%s\n' "$value"
}

# Hermes sanitizes the stdio MCP child's environment. Recover only the
# run-scoped bearer from its process ancestry; never pass the host machine
# token into a Hermes-owned MCP process.
parent_pid="$PPID"
ancestor_parent() {
  awk '/^PPid:/ {print $2; exit}' "/proc/$1/status" 2>/dev/null
}
read_ancestor_capability() {
  local pid="$parent_pid" depth entry
  for depth in {1..8}; do
    [ "$pid" -gt 1 ] 2>/dev/null || return 1
    if [ -r "/proc/$pid/environ" ]; then
      while IFS= read -r -d '' entry; do
        case "$entry" in
          MATRIX_AGENT_INTEGRATIONS_TOKEN=*) printf '%s' "${entry#*=}"; return 0 ;;
        esac
      done < "/proc/$pid/environ"
    fi
    pid="$(ancestor_parent "$pid")"
  done
  return 1
}
has_hermes_chat_ancestor() {
  local pid="$parent_pid" depth command
  for depth in {1..8}; do
    [ "$pid" -gt 1 ] 2>/dev/null || return 1
    command="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
    case "$command" in *tui_gateway.entry*) return 0 ;; esac
    pid="$(ancestor_parent "$pid")"
  done
  return 1
}
scoped_token="${MATRIX_AGENT_INTEGRATIONS_TOKEN:-}"
if [ -z "$scoped_token" ]; then
  scoped_token="$(read_ancestor_capability || true)"
fi
if [ "$require_scoped" = true ] && [ -z "$scoped_token" ]; then
  echo "matrix-integrations-mcp: run capability is unavailable" >&2
  exit 3
fi
if has_hermes_chat_ancestor && [ -z "$scoped_token" ]; then
  echo "matrix-integrations-mcp: run capability is unavailable" >&2
  exit 3
fi
if [ -n "$scoped_token" ]; then
  if [[ ! "$scoped_token" =~ ^[a-f0-9]{64}$ ]] || [ ! -x "$NODE_BIN" ] || [ ! -f "$SERVER_PATH" ]; then
    echo "matrix-integrations-mcp: run capability or runtime is invalid" >&2
    exit 3
  fi
  exec /usr/bin/env -i \
    PATH="/opt/matrix/runtime/node/bin:/usr/local/bin:/usr/bin:/bin" \
    GATEWAY_URL="http://127.0.0.1:4000" \
    MATRIX_AGENT_INTEGRATIONS_TOKEN="$scoped_token" \
    "$NODE_BIN" "$SERVER_PATH"
fi

if [ ! -r "$HOST_ENV_FILE" ]; then
  echo "matrix-integrations-mcp: Matrix identity is unavailable" >&2
  exit 3
fi
MATRIX_AUTH_TOKEN_VALUE="$(read_host_value MATRIX_AUTH_TOKEN)" || {
  echo "matrix-integrations-mcp: Matrix authentication is unavailable" >&2
  exit 3
}
MATRIX_CLERK_USER_ID_VALUE="$(read_host_value MATRIX_CLERK_USER_ID)" || {
  echo "matrix-integrations-mcp: Matrix identity is unavailable" >&2
  exit 3
}
if [[ ! "$MATRIX_AUTH_TOKEN_VALUE" =~ ^[A-Za-z0-9._~+/=-]{16,512}$ ]] || \
   [[ ! "$MATRIX_CLERK_USER_ID_VALUE" =~ ^[A-Za-z0-9_-]{1,128}$ ]]; then
  echo "matrix-integrations-mcp: Matrix identity is invalid" >&2
  exit 3
fi
if [ -n "${MATRIX_CLERK_USER_ID:-}" ] && [ "$MATRIX_CLERK_USER_ID" != "$MATRIX_CLERK_USER_ID_VALUE" ]; then
  echo "matrix-integrations-mcp: owner identity is unavailable" >&2
  exit 3
fi
if [ ! -x "$NODE_BIN" ] || [ ! -f "$SERVER_PATH" ]; then
  echo "matrix-integrations-mcp: runtime is unavailable" >&2
  exit 3
fi

# Start from an empty environment so database, storage, analytics, and provider
# secrets in host.env cannot cross into the agent-owned MCP process.
exec /usr/bin/env -i \
  PATH="/opt/matrix/runtime/node/bin:/usr/local/bin:/usr/bin:/bin" \
  GATEWAY_URL="http://127.0.0.1:4000" \
  MATRIX_AUTH_TOKEN="$MATRIX_AUTH_TOKEN_VALUE" \
  MATRIX_CLERK_USER_ID="$MATRIX_CLERK_USER_ID_VALUE" \
  "$NODE_BIN" "$SERVER_PATH"
