#!/usr/bin/env bash
set -euo pipefail

# Matrix OS Sync Agent — polls for bundle updates, applies on trigger, rollback support.
#
# Env (from host.env):  MATRIX_MACHINE_ID, MATRIX_HOST_BUNDLE_URL, PLATFORM_INTERNAL_URL
# Trigger files:        /opt/matrix/app/.update-now   — apply pending update
#                       /opt/matrix/app/.rollback-now  — rollback to previous version
#                       /opt/matrix/app/.update-repair-now — clean safe temp artifacts and retry
# Signals:              SIGUSR1 — alternative apply-update trigger

source /opt/matrix/env/host.env

readonly APP_DIR="/opt/matrix/app"
readonly STAGING_DIR="/opt/matrix/staging"
readonly BIN_DIR="/opt/matrix/bin"
readonly VERSION_FILE="$APP_DIR/BUNDLE_VERSION"
readonly RELEASE_FILE="/opt/matrix/release.json"
readonly RELEASE_ROLLBACK_FILE="/opt/matrix/release.json.rollback"
readonly UPDATE_MARKER="$APP_DIR/.update-available.json"
readonly UPDATE_TRIGGER="$APP_DIR/.update-now"
readonly UPDATE_CHANNEL_FILE="$APP_DIR/.update-channel"
readonly UPDATE_VERSION_FILE="$APP_DIR/.update-version"
readonly UPDATE_ERROR_MARKER="$APP_DIR/.update-error.json"
readonly UPDATE_PHASE_MARKER="$STAGING_DIR/update-phase"
readonly UPDATE_REPAIR_TRIGGER="$APP_DIR/.update-repair-now"
readonly ROLLBACK_TRIGGER="$APP_DIR/.rollback-now"
readonly HEALTH_URL="http://127.0.0.1:4000/health"
readonly AUTO_APPLY_FAILED_MARKER="$APP_DIR/.auto-apply-failed"
readonly STAGING_ARTIFACT_TTL_SECONDS="${MATRIX_STAGING_ARTIFACT_TTL_SECONDS:-86400}"
readonly STAGING_CLEANUP_INTERVAL_SECONDS="${MATRIX_STAGING_CLEANUP_INTERVAL_SECONDS:-3600}"
readonly UPDATE_FREE_BUFFER_KB="${MATRIX_UPDATE_FREE_BUFFER_KB:-1048576}"
readonly UPDATE_EXPANSION_FACTOR="${MATRIX_UPDATE_EXPANSION_FACTOR:-8}"
readonly LEGACY_UPGRADE_DIR="/opt/matrix-upgrade"
readonly LEGACY_UPGRADE_TTL_SECONDS="${MATRIX_LEGACY_UPGRADE_TTL_SECONDS:-86400}"
readonly SYMPHONY_ENV_FILE="/opt/matrix/env/symphony.env"
readonly TERMINAL_RUNTIME_ROOT="/opt/matrix/terminal-runtime"
readonly TERMINAL_RUNTIME_GENERATION_FILE="TERMINAL_RUNTIME_GENERATION"
readonly TERMINAL_RUNTIME_MAX_GENERATIONS="${MATRIX_TERMINAL_RUNTIME_MAX_GENERATIONS:-8}"
# Keys this agent owns and rewrites on every sync from platform-provided values.
# Any other key in symphony.env (e.g. an operator-set SYMPHONY_LINEAR_PROJECT_SLUG)
# is preserved across updates instead of being wiped.
readonly SYMPHONY_MANAGED_KEYS="MATRIX_HANDLE PLATFORM_INTERNAL_URL UPGRADE_TOKEN"

log() { echo "matrix-sync-agent: $(date -u +%Y-%m-%dT%H:%M:%SZ) $*"; }
current_version() { cat "$VERSION_FILE" 2>/dev/null || echo "unknown"; }
platform_url() { echo "${MATRIX_UPDATE_MANIFEST_BASE_URL:-${PLATFORM_INTERNAL_URL:-https://app.matrix-os.com}}"; }
staged_release_metadata=""

cleanup_staged_release_metadata() {
  if [ -n "$staged_release_metadata" ]; then
    sudo rm -f -- "$staged_release_metadata" || true
    staged_release_metadata=""
  fi
}

stage_release_metadata() {
  local source="$1" expected_version="$2" actual_version incoming
  staged_release_metadata=""
  [ -f "$source" ] && [ ! -L "$source" ] || {
    log "ERROR: bundle release metadata is missing or invalid"
    return 1
  }
  actual_version="$(python3 - "$source" <<'PY'
import json
import os
import stat
import sys

fd = os.open(sys.argv[1], os.O_RDONLY | os.O_NOFOLLOW)
try:
    metadata = os.fstat(fd)
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_size < 2 or metadata.st_size > 65536:
        raise ValueError("invalid release metadata")
    payload = os.read(fd, 65537)
    if len(payload) > 65536:
        raise ValueError("oversized release metadata")
    version = json.loads(payload).get("version")
    if not isinstance(version, str):
        raise ValueError("missing release version")
    print(version)
finally:
    os.close(fd)
PY
  )" || return 1
  [ "$actual_version" = "$expected_version" ] || {
    log "ERROR: bundle release metadata does not match the requested version"
    return 1
  }
  if [ -L "$RELEASE_FILE" ] || { [ -e "$RELEASE_FILE" ] && [ ! -f "$RELEASE_FILE" ]; }; then
    log "ERROR: installed release metadata has an invalid file type"
    return 1
  fi
  incoming="$RELEASE_FILE.incoming.$$"
  sudo rm -f -- "$incoming" || return 1
  if ! sudo install -o root -g matrix -m 0644 "$source" "$incoming"; then
    sudo rm -f -- "$incoming"
    return 1
  fi
  staged_release_metadata="$incoming"
}

commit_release_metadata() {
  local rollback_incoming
  [ -n "$staged_release_metadata" ] && [ -f "$staged_release_metadata" ] && [ ! -L "$staged_release_metadata" ] || return 1
  rollback_incoming="$RELEASE_ROLLBACK_FILE.incoming.$$"
  sudo rm -f -- "$rollback_incoming" || return 1
  if [ -f "$RELEASE_FILE" ] && [ ! -L "$RELEASE_FILE" ]; then
    if ! sudo install -o root -g matrix -m 0644 "$RELEASE_FILE" "$rollback_incoming" \
      || ! sudo mv -Tf "$rollback_incoming" "$RELEASE_ROLLBACK_FILE"; then
      sudo rm -f -- "$rollback_incoming"
      return 1
    fi
  else
    sudo rm -f -- "$RELEASE_ROLLBACK_FILE" || return 1
  fi
  sudo mv -Tf "$staged_release_metadata" "$RELEASE_FILE" || return 1
  staged_release_metadata=""
}

restore_rollback_release_metadata() {
  [ -f "$RELEASE_ROLLBACK_FILE" ] && [ ! -L "$RELEASE_ROLLBACK_FILE" ] || return 1
  sudo mv -Tf "$RELEASE_ROLLBACK_FILE" "$RELEASE_FILE" || return 1
}

rollback_release_metadata_is_ready() {
  local rollback_app="$1" expected_version actual_version
  [ -d "$rollback_app" ] && [ ! -L "$rollback_app" ] || return 1
  [ -f "$rollback_app/BUNDLE_VERSION" ] && [ ! -L "$rollback_app/BUNDLE_VERSION" ] || return 1
  IFS= read -r expected_version <"$rollback_app/BUNDLE_VERSION" || return 1
  actual_version="$(python3 - "$RELEASE_ROLLBACK_FILE" <<'PY'
import json
import os
import stat
import sys

fd = os.open(sys.argv[1], os.O_RDONLY | os.O_NOFOLLOW)
try:
    metadata = os.fstat(fd)
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_size < 2 or metadata.st_size > 65536:
        raise ValueError("invalid rollback release metadata")
    payload = os.read(fd, 65537)
    if len(payload) > 65536:
        raise ValueError("oversized rollback release metadata")
    version = json.loads(payload).get("version")
    if not isinstance(version, str):
        raise ValueError("missing rollback release version")
    print(version)
finally:
    os.close(fd)
PY
  )" || return 1
  [ "$actual_version" = "$expected_version" ]
}

# Echo the lines of an existing symphony.env that this agent does not manage so
# operator-set configuration survives a host bundle update. Blank and comment
# lines are kept; managed KEY= lines are dropped (re-emitted with fresh values
# by write_symphony_env). Group-readable file (root:matrix 0640), so the matrix
# user that runs this agent can read it directly.
preserve_unmanaged_symphony_env() {
  local existing_file="$1"
  [ -f "$existing_file" ] || return 0
  local line key
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      '' | '#'*)
        printf '%s\n' "$line"
        ;;
      *=*)
        key="${line%%=*}"
        case " $SYMPHONY_MANAGED_KEYS " in
          *" $key "*) : ;; # managed key: re-emitted with fresh value elsewhere
          *) printf '%s\n' "$line" ;;
        esac
        ;;
      *)
        printf '%s\n' "$line"
        ;;
    esac
  done <"$existing_file"
}

write_symphony_env() {
  local status=0
  local temp_file
  temp_file="$(mktemp)"
  {
    printf 'MATRIX_HANDLE=%s\n' "${MATRIX_HANDLE:?MATRIX_HANDLE is required}"
    printf 'PLATFORM_INTERNAL_URL=%s\n' "${PLATFORM_INTERNAL_URL:?PLATFORM_INTERNAL_URL is required}"
    printf 'UPGRADE_TOKEN=%s\n' "${UPGRADE_TOKEN:?UPGRADE_TOKEN is required}"
    preserve_unmanaged_symphony_env "$SYMPHONY_ENV_FILE"
  } >"$temp_file"
  sudo install -o root -g matrix -m 0640 "$temp_file" "$SYMPHONY_ENV_FILE" || status=$?
  rm -f "$temp_file"
  return "$status"
}

install_host_bin_payload() {
  local source_dir="$1" source name incoming destination
  [ -d "$source_dir" ] && [ ! -L "$source_dir" ] || return 1
  sudo install -d -o root -g root -m 0755 "$BIN_DIR" || return 1
  while IFS= read -r -d '' source; do
    name="${source##*/}"
    [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] || return 1
    incoming="$BIN_DIR/.${name}.incoming.$$"
    destination="$BIN_DIR/$name"
    if [ -L "$destination" ] || { [ -e "$destination" ] && [ ! -f "$destination" ]; }; then
      log "ERROR: invalid installed host-bin destination for $name"
      return 1
    fi
    sudo rm -f -- "$incoming" || return 1
    if ! sudo install -o root -g root -m 0755 "$source" "$incoming" \
      || ! sudo mv -Tf "$incoming" "$destination"; then
      sudo rm -f -- "$incoming"
      return 1
    fi
  done < <(find "$source_dir" -mindepth 1 -maxdepth 1 -type f -print0)
}

install_terminal_runtime_bootstrap_helpers() {
  local source_dir="$1" name source incoming destination
  [ -d "$source_dir" ] && [ ! -L "$source_dir" ] || return 1
  sudo install -d -o root -g root -m 0755 "$BIN_DIR" || return 1
  for name in matrix-terminal-generation-id matrix-terminal-generation-gc.py; do
    source="$source_dir/$name"
    incoming="$BIN_DIR/.${name}.incoming.$$"
    destination="$BIN_DIR/$name"
    [ -f "$source" ] && [ ! -L "$source" ] || return 1
    if [ -L "$destination" ] || { [ -e "$destination" ] && [ ! -f "$destination" ]; }; then
      log "ERROR: invalid installed terminal helper destination for $name"
      return 1
    fi
    sudo rm -f -- "$incoming" || return 1
    if ! sudo install -o root -g root -m 0755 "$source" "$incoming" \
      || ! sudo mv -Tf "$incoming" "$destination"; then
      sudo rm -f -- "$incoming"
      return 1
    fi
  done
}

default_update_channel() {
  local channel="${MATRIX_UPDATE_CHANNEL:-}"
  case "$channel" in
    stable|canary|beta|dev) echo "$channel"; return 0 ;;
  esac
  if [ -f "$RELEASE_FILE" ]; then
    channel="$(python3 -c "import json,sys; print(json.load(open(sys.argv[1])).get('channel',''))" "$RELEASE_FILE" 2>/dev/null || true)"
    case "$channel" in
      stable|canary|beta|dev) echo "$channel"; return 0 ;;
    esac
  fi
  echo "stable"
}
manifest_url() {
  local channel
  channel="$(default_update_channel)"
  echo "$(platform_url)/system-bundles/channels/${channel}.json"
}
release_url_for_version() { echo "$(platform_url)/system-bundles/releases/$1.json"; }
release_url_for_channel() { echo "$(platform_url)/system-bundles/channels/$1.json"; }

json_field() { python3 -c "import json,sys; print(json.load(sys.stdin).get(sys.argv[1],''))" "$2" <<< "$1"; }

compare_host_bundle_versions() {
  local candidate="$1" current="$2"
  python3 - "$candidate" "$current" <<'PY'
import re
import sys

def parse(value):
    match = re.fullmatch(r"v?(\d{4})\.(\d{2})\.(\d{2})[-.](\d+)", value)
    if not match:
        return None
    return tuple(int(part) for part in match.groups())

candidate = parse(sys.argv[1])
current = parse(sys.argv[2])
if candidate is None or current is None:
    print("unknown")
elif candidate > current:
    print("newer")
elif candidate < current:
    print("older")
else:
    print("equal")
PY
}

terminal_runtime_generation_for_dir() {
  local generation_dir="$1"
  [ -d "$generation_dir" ] && [ ! -L "$generation_dir" ] || return 1
  [ -f "$BIN_DIR/matrix-terminal-generation-id" ] &&
    [ ! -L "$BIN_DIR/matrix-terminal-generation-id" ] &&
    [ -x "$BIN_DIR/matrix-terminal-generation-id" ] || return 1
  [ -f "$generation_dir/zellij" ] && [ ! -L "$generation_dir/zellij" ] || return 1
  [ -f "$generation_dir/matrix-terminal-user-keeper.mjs" ] && [ ! -L "$generation_dir/matrix-terminal-user-keeper.mjs" ] || return 1
  [ -f "$generation_dir/matrix-terminal-attach.mjs" ] && [ ! -L "$generation_dir/matrix-terminal-attach.mjs" ] || return 1
  "$BIN_DIR/matrix-terminal-generation-id" \
    "$generation_dir/zellij" \
    "$generation_dir/matrix-terminal-user-keeper.mjs" \
    "$generation_dir/matrix-terminal-attach.mjs"
}

activate_terminal_runtime_generation() {
  local generation="$1" generation_dir="$TERMINAL_RUNTIME_ROOT/generations/$1" link_tmp
  [[ "$generation" =~ ^gen_[0-9a-f]{64}$ ]] || {
    log "ERROR: invalid terminal runtime generation marker"
    return 1
  }
  [ "$(terminal_runtime_generation_for_dir "$generation_dir")" = "$generation" ] || {
    log "ERROR: terminal runtime generation verification failed"
    return 1
  }
  link_tmp="$TERMINAL_RUNTIME_ROOT/.current.$$"
  sudo rm -f -- "$link_tmp" || return 1
  sudo ln -s "generations/$generation" "$link_tmp" || return 1
  sudo mv -Tf "$link_tmp" "$TERMINAL_RUNTIME_ROOT/current" || return 1
  sudo install -o root -g root -m 0755 \
    "$generation_dir/matrix-terminal-attach.mjs" \
    /usr/local/bin/matrix-terminal-attach || return 1
}

reload_terminal_user_manager() {
  local matrix_uid
  matrix_uid="$(id -u matrix)"
  sudo -u matrix env \
    HOME=/home/matrix/home \
    XDG_RUNTIME_DIR="/run/user/$matrix_uid" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$matrix_uid/bus" \
    /usr/bin/timeout --signal=KILL 30 /usr/bin/systemctl --user daemon-reload
}

cleanup_terminal_runtime_generations() {
  local max_generations="$TERMINAL_RUNTIME_MAX_GENERATIONS" candidate installed_count removed
  [ -f "$BIN_DIR/matrix-terminal-generation-gc.py" ] &&
    [ ! -L "$BIN_DIR/matrix-terminal-generation-gc.py" ] || return 1
  if [[ ! "$max_generations" =~ ^[0-9]+$ ]] || [ "$max_generations" -lt 2 ] || [ "$max_generations" -gt 32 ]; then
    max_generations=8
  fi
  if ! removed="$(sudo python3 "$BIN_DIR/matrix-terminal-generation-gc.py" --delete \
    "$TERMINAL_RUNTIME_ROOT" \
    "/home/matrix/home/system/terminal-runtimes" \
    "$APP_DIR" \
    "$APP_DIR.rollback" \
    "$max_generations")"; then
    log "ERROR: terminal runtime generation cleanup failed closed"
    return 1
  fi
  while IFS= read -r candidate; do
    [ -n "$candidate" ] || continue
    [[ "$candidate" =~ ^gen_[0-9a-f]{64}$ ]] || return 1
    log "Removed unreferenced terminal runtime generation $candidate"
  done <<< "$removed"
  installed_count="$(find "$TERMINAL_RUNTIME_ROOT/generations" -mindepth 1 -maxdepth 1 -type d -name 'gen_*' -print 2>/dev/null | wc -l)"
  if [ "$installed_count" -gt "$max_generations" ]; then
    log "ERROR: terminal runtime generation cap reached by active or recoverable sessions"
    return 1
  fi
}

install_terminal_runtime_payload() {
  local extract_dir="$1" generation source_dir destination_dir incoming_dir
  [ -f "$extract_dir/app/$TERMINAL_RUNTIME_GENERATION_FILE" ] || return 0
  generation="$(cat "$extract_dir/app/$TERMINAL_RUNTIME_GENERATION_FILE")" || return 1
  [[ "$generation" =~ ^gen_[0-9a-f]{64}$ ]] || {
    log "ERROR: invalid terminal runtime generation in bundle"
    return 1
  }
  source_dir="$extract_dir/terminal-runtime/generations/$generation"
  [ "$(terminal_runtime_generation_for_dir "$source_dir")" = "$generation" ] || {
    log "ERROR: bundled terminal runtime generation verification failed"
    return 1
  }

  sudo install -d -o root -g root -m 0755 "$TERMINAL_RUNTIME_ROOT/generations" || return 1
  destination_dir="$TERMINAL_RUNTIME_ROOT/generations/$generation"
  if [ -e "$destination_dir" ]; then
    [ ! -L "$destination_dir" ] && [ "$(terminal_runtime_generation_for_dir "$destination_dir")" = "$generation" ] || {
      log "ERROR: installed terminal runtime generation is inconsistent"
      return 1
    }
  else
    incoming_dir="$TERMINAL_RUNTIME_ROOT/generations/.incoming-${generation}-$$"
    sudo rm -rf -- "$incoming_dir"
    if ! sudo cp -a "$source_dir" "$incoming_dir"; then
      sudo rm -rf -- "$incoming_dir"
      return 1
    fi
    if ! sudo chown -R root:root "$incoming_dir" \
      || ! sudo chmod 0755 "$incoming_dir" "$incoming_dir/zellij" "$incoming_dir/matrix-terminal-user-keeper.mjs" "$incoming_dir/matrix-terminal-attach.mjs" \
      || ! sudo mv "$incoming_dir" "$destination_dir"; then
      sudo rm -rf -- "$incoming_dir"
      return 1
    fi
  fi

  if [ -d "$extract_dir/user-systemd" ]; then
    sudo install -d -o root -g root -m 0755 /etc/systemd/user || return 1
    sudo find "$extract_dir/user-systemd" -maxdepth 1 -type f \( -name 'matrix-*.service' -o -name 'matrix-*.slice' \) \
      -exec install -o root -g root -m 0644 {} /etc/systemd/user/ \; || return 1
    reload_terminal_user_manager || return 1
  fi
  activate_terminal_runtime_generation "$generation" || return 1
  cleanup_terminal_runtime_generations || return 1
  log "Installed terminal runtime generation $generation"
}

write_update_error() {
  local code="$1" message="$2" version="${3:-}" available_kb="${4:-}" required_kb="${5:-}" temp
  if [ -L "$UPDATE_ERROR_MARKER" ] || { [ -e "$UPDATE_ERROR_MARKER" ] && [ ! -f "$UPDATE_ERROR_MARKER" ]; }; then
    log "ERROR: update error marker has an invalid file type"
    return 1
  fi
  temp="$(mktemp "$APP_DIR/.update-error.json.XXXXXX")" || return 1
  if ! python3 - "$temp" "$code" "$message" "$version" "$available_kb" "$required_kb" <<'PY'
import json
import sys
from datetime import datetime, timezone

path, code, message, version, available_kb, required_kb = sys.argv[1:7]
payload = {
    "code": code,
    "message": message,
    "failedAt": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
}
if version:
    payload["version"] = version
for key, value in (("availableKb", available_kb), ("requiredKb", required_kb)):
    if value:
        try:
            payload[key] = int(value)
        except ValueError:
            pass
with open(path, "w", encoding="utf-8") as handle:
    json.dump(payload, handle, separators=(",", ":"))
    handle.write("\n")
PY
  then
    rm -f -- "$temp"
    return 1
  fi
  if ! mv -fT "$temp" "$UPDATE_ERROR_MARKER"; then
    rm -f -- "$temp"
    return 1
  fi
}

write_update_phase() {
  local phase="$1" temp
  case "$phase" in
    prepare|download|verify|extract|terminal-runtime|app-install|host-bin|health) ;;
    *) return 1 ;;
  esac
  temp="$(mktemp "$STAGING_DIR/.update-phase.XXXXXX")" || return 1
  if ! printf '%s\n' "$phase" >"$temp" || ! mv -fT "$temp" "$UPDATE_PHASE_MARKER"; then
    rm -f -- "$temp"
    return 1
  fi
}

consume_update_trigger() {
  sudo rm -f -- "$UPDATE_TRIGGER"
}

recover_interrupted_update() {
  local phase version=""
  [ -f "$UPDATE_PHASE_MARKER" ] && [ ! -L "$UPDATE_PHASE_MARKER" ] || return 0
  [ -f "$UPDATE_MARKER" ] && [ ! -L "$UPDATE_MARKER" ] || {
    rm -f -- "$UPDATE_PHASE_MARKER"
    return 0
  }
  [ ! -e "$UPDATE_ERROR_MARKER" ] && [ ! -L "$UPDATE_ERROR_MARKER" ] || return 0
  phase="$(cat "$UPDATE_PHASE_MARKER" 2>/dev/null || true)"
  case "$phase" in
    prepare|download|verify|extract|terminal-runtime|app-install|host-bin|health) ;;
    *) phase=unknown ;;
  esac
  version="$(json_field "$(cat "$UPDATE_MARKER")" version 2>/dev/null || true)"
  log "ERROR: interrupted update recovered at bounded phase $phase"
  write_update_error "apply_interrupted" "The update process was interrupted before completion." "$version"
}

fetch_manifest() {
  local url="$1" manifest
  if ! manifest="$(curl --fail --silent --show-error --max-time 15 "$url" 2>&1)"; then
    log "WARN: failed to fetch release metadata from $url"; return 1
  fi
  printf '%s' "$manifest"
}

write_prepared_update_marker() {
  local manifest="$1" temp
  if [ -L "$UPDATE_MARKER" ] || { [ -e "$UPDATE_MARKER" ] && [ ! -f "$UPDATE_MARKER" ]; }; then
    log "ERROR: prepared update marker has an invalid file type"
    return 1
  fi
  temp="$(mktemp "$APP_DIR/.update-available.json.XXXXXX")" || return 1
  if ! printf '%s\n' "$manifest" >"$temp" || ! mv -fT "$temp" "$UPDATE_MARKER"; then
    rm -f -- "$temp"
    return 1
  fi
}

download_bundle() {
  local version="$1" expected_sha256="$2" expected_size="$3" bundle_url="$4" bundle_file="$5"
  local attempt refreshed refreshed_version refreshed_sha256 refreshed_size refreshed_url partial_size
  local -a continue_args
  rm -f -- "$bundle_file"
  for attempt in 1 2; do
    continue_args=()
    if [ "$attempt" -eq 2 ]; then
      if ! refreshed="$(fetch_manifest "$(release_url_for_version "$version")")"; then
        continue
      fi
      refreshed_version="$(json_field "$refreshed" version)"
      refreshed_sha256="$(json_field "$refreshed" sha256)"
      refreshed_size="$(json_field "$refreshed" size)"
      refreshed_url="$(json_field "$refreshed" url)"
      if ! [ "$refreshed_version" = "$version" ] ||
        ! [ "$refreshed_sha256" = "$expected_sha256" ] ||
        ! [ "$refreshed_size" = "$expected_size" ] || [ -z "$refreshed_url" ]; then
        write_update_error "download_metadata_changed" \
          "The immutable release metadata changed during download." "$version"
        rm -f -- "$bundle_file"
        return 1
      fi
      bundle_url="$refreshed_url"
      if [ -f "$bundle_file" ] && [ ! -L "$bundle_file" ]; then
        partial_size="$(stat -c %s "$bundle_file" 2>/dev/null || true)"
        if [[ "$expected_size" =~ ^[0-9]+$ ]] && [[ "$partial_size" =~ ^[0-9]+$ ]] &&
          [ "$partial_size" -eq "$expected_size" ]; then
          return 0
        fi
        if [[ "$partial_size" =~ ^[1-9][0-9]*$ ]] &&
          { [[ ! "$expected_size" =~ ^[0-9]+$ ]] || [ "$partial_size" -lt "$expected_size" ]; }; then
          continue_args=(--continue-at -)
        else
          rm -f -- "$bundle_file"
        fi
      else
        rm -f -- "$bundle_file"
      fi
    fi
    if /usr/bin/timeout --signal=KILL 1800 curl --fail --location \
      --connect-timeout 10 --max-time 1770 --http1.1 \
      "${continue_args[@]}" "$bundle_url" -o "$bundle_file"; then
      [ -f "$bundle_file" ] && [ ! -L "$bundle_file" ] && return 0
    fi
    log "WARN: bundle download attempt $attempt failed"
  done
  write_update_error "download_failed" "The release bundle download failed." "$version"
  rm -f -- "$bundle_file"
  return 1
}

prepare_triggered_update_action=apply

installed_terminal_runtime_is_ready() {
  local marker="$APP_DIR/$TERMINAL_RUNTIME_GENERATION_FILE" generation generation_dir asset actual_generation
  [ -f "$marker" ] && [ ! -L "$marker" ] || return 1
  IFS= read -r generation <"$marker" || return 1
  [[ "$generation" =~ ^gen_[0-9a-f]{64}$ ]] || return 1

  generation_dir="$TERMINAL_RUNTIME_ROOT/generations/$generation"
  [ -d "$generation_dir" ] && [ ! -L "$generation_dir" ] || return 1
  for asset in matrix-terminal-user-keeper.mjs matrix-terminal-attach.mjs; do
    [ -f "$generation_dir/$asset" ] && [ ! -L "$generation_dir/$asset" ] || return 1
  done
  [ -f "$generation_dir/zellij" ] && [ ! -L "$generation_dir/zellij" ] &&
    [ -x "$generation_dir/zellij" ] || return 1
  [ -f "$BIN_DIR/matrix-terminal-generation-id" ] &&
    [ ! -L "$BIN_DIR/matrix-terminal-generation-id" ] &&
    [ -x "$BIN_DIR/matrix-terminal-generation-id" ] || return 1
  actual_generation="$("$BIN_DIR/matrix-terminal-generation-id" \
    "$generation_dir/zellij" \
    "$generation_dir/matrix-terminal-user-keeper.mjs" \
    "$generation_dir/matrix-terminal-attach.mjs" 2>/dev/null)" || return 1
  [ "$actual_generation" = "$generation" ]
}

requested_update_is_already_current() {
  local remote_version="$1"
  [ -f "$UPDATE_VERSION_FILE" ] && [ ! -L "$UPDATE_VERSION_FILE" ] || return 1
  [ "$remote_version" = "$(current_version)" ] || return 1
  [ ! -e "$UPDATE_PHASE_MARKER" ] && [ ! -L "$UPDATE_PHASE_MARKER" ] || return 1
  [ ! -e "$UPDATE_ERROR_MARKER" ] && [ ! -L "$UPDATE_ERROR_MARKER" ] || return 1
  installed_terminal_runtime_is_ready || return 1
}

consume_idempotent_update_request() {
  log "Exact requested version is already installed; consuming idempotent request"
  rm -f "$UPDATE_CHANNEL_FILE" "$UPDATE_VERSION_FILE"
  consume_update_trigger || log "WARN: failed to consume idempotent update trigger"
}

prepare_triggered_update() {
  local url="" target="" requested_version=""
  prepare_triggered_update_action=apply
  if [ -f "$UPDATE_VERSION_FILE" ]; then
    target="$(cat "$UPDATE_VERSION_FILE" 2>/dev/null || true)"
    [ -n "$target" ] || { log "WARN: update version file is empty"; return 1; }
    requested_version="$target"
    url="$(release_url_for_version "$target")"
  elif [ -f "$UPDATE_CHANNEL_FILE" ]; then
    target="$(cat "$UPDATE_CHANNEL_FILE" 2>/dev/null || true)"
    [ -n "$target" ] || { log "WARN: update channel file is empty"; return 1; }
    url="$(release_url_for_channel "$target")"
  elif [ -f "$UPDATE_MARKER" ]; then
    local manifest remote_version marker_channel
    manifest="$(cat "$UPDATE_MARKER")"
    remote_version="$(json_field "$manifest" version)"
    if [ -z "$remote_version" ]; then
      log "WARN: prepared release metadata missing 'version' field"; return 1
    fi
    marker_channel="$(json_field "$manifest" channel)"
    log "Prepared requested update target ${marker_channel:-prepared}: $remote_version"
    return 0
  else
    target="$(default_update_channel)"
    url="$(manifest_url)"
  fi

  local manifest remote_version
  manifest="$(fetch_manifest "$url")" || return 1
  remote_version="$(json_field "$manifest" version)"
  if [ -z "$remote_version" ]; then
    log "WARN: release metadata missing 'version' field"; return 1
  fi
  if [ -n "$requested_version" ] && ! [ "$remote_version" = "$requested_version" ]; then
    log "ERROR: immutable update target did not match fetched release metadata"
    write_update_error "update_target_mismatch" \
      "The fetched release metadata did not match the requested version." "$requested_version"
    return 1
  fi
  if requested_update_is_already_current "$remote_version"; then
    prepare_triggered_update_action=already-current
    return 0
  fi
  if [ ! -f "$UPDATE_VERSION_FILE" ] && [ ! -f "$UPDATE_CHANNEL_FILE" ] && [ "$remote_version" = "$(current_version)" ]; then
    log "No update available on ${target} — nothing to apply"
    rm -f "$UPDATE_MARKER"
    return 1
  fi
  write_prepared_update_marker "$manifest" || return 1
  log "Prepared requested update target ${target}: $remote_version"
}

# ── Poll for updates ─────────────────────────────────────────────────
check_for_update() {
  local url manifest remote_version cur
  url="$(manifest_url)"
  if ! manifest="$(curl --fail --silent --show-error --max-time 15 "$url" 2>&1)"; then
    log "WARN: failed to fetch manifest from $url"; return 1
  fi
  remote_version="$(json_field "$manifest" version)"
  if [ -z "$remote_version" ]; then
    log "WARN: manifest missing 'version' field"; return 1
  fi
  cur="$(current_version)"
  if [ "$remote_version" = "$cur" ]; then
    rm -f "$UPDATE_MARKER"
    return 0
  fi

  local version_comparison
  version_comparison="$(compare_host_bundle_versions "$remote_version" "$cur")"
  if [ "$version_comparison" = "older" ]; then
    log "Ignoring older channel release: $remote_version (current: $cur)"
    rm -f "$UPDATE_MARKER" "$UPDATE_ERROR_MARKER"
    return 0
  fi

  local severity update_type
  severity="$(json_field "$manifest" severity)"
  update_type="$(json_field "$manifest" updateType)"

  log "Update available: $remote_version (current: $cur, severity: ${severity:-normal})"
  write_prepared_update_marker "$manifest" || return 1

  if [ "$severity" = "security" ] || [ "$update_type" = "auto" ]; then
    if [ -f "$AUTO_APPLY_FAILED_MARKER" ] && [ "$(cat "$AUTO_APPLY_FAILED_MARKER" 2>/dev/null)" = "$remote_version" ]; then
      log "Skipping auto-apply for $remote_version — previous attempt failed (use .update-now to retry)"
    else
      log "Auto-apply update $remote_version (severity=${severity:-normal}, updateType=${update_type:-manual})"
      if ! run_apply_update; then
        echo "$remote_version" > "$AUTO_APPLY_FAILED_MARKER"
        log "Auto-apply failed — will not retry automatically (use .update-now to force)"
      else
        rm -f "$AUTO_APPLY_FAILED_MARKER"
      fi
    fi
  fi
}

# ── Apply update ─────────────────────────────────────────────────────
apply_update() {
  local trigger_source="${1:-other}"
  if [ ! -f "$UPDATE_MARKER" ]; then
    log "No update available — nothing to apply"; return 1
  fi
  local manifest version sha256 bundle_url cur bundle_file extract_dir
  manifest="$(cat "$UPDATE_MARKER")"
  version="$(json_field "$manifest" version)"
  sha256="$(json_field "$manifest" sha256)"
  bundle_url="$(json_field "$manifest" url)"
  bundle_url="${bundle_url:-$MATRIX_HOST_BUNDLE_URL}"
  cur="$(current_version)"
  log "Starting update from $cur to $version"

  sudo mkdir -p "$STAGING_DIR"
  sudo chown matrix:matrix "$STAGING_DIR"
  if ! ensure_update_headroom "$(json_field "$manifest" size)" "$version"; then
    if [ "$trigger_source" = explicit ]; then
      consume_update_trigger || log "WARN: failed to consume update trigger"
    fi
    return 1
  fi
  rm -f "$UPDATE_ERROR_MARKER"
  if ! write_update_phase prepare; then
    if [ "$trigger_source" = explicit ]; then
      consume_update_trigger || log "WARN: failed to consume update trigger"
    fi
    return 1
  fi
  # Keep the explicit request durable until an atomic phase marker exists. If
  # the agent is interrupted before this point, systemd can restart it and the
  # still-present trigger will retry the prepared immutable manifest. Once the
  # phase is durable, startup recovery can report apply_interrupted instead.
  if [ "$trigger_source" = explicit ]; then
    consume_update_trigger || return 1
  fi
  bundle_file="$STAGING_DIR/bundle-${version}.tar.gz"
  extract_dir="$STAGING_DIR/bundle-${version}"

  log "Downloading bundle..."
  write_update_phase download || return 1
  if ! download_bundle "$version" "$sha256" "$(json_field "$manifest" size)" "$bundle_url" "$bundle_file"; then
    log "ERROR: download failed"
    return 1
  fi

  # Verify checksum
  write_update_phase verify || return 1
  if [ -n "$sha256" ]; then
    local actual_sha256
    actual_sha256="$(sha256sum "$bundle_file" | awk '{print $1}')"
    if [ "$actual_sha256" != "$sha256" ]; then
      log "ERROR: checksum mismatch (expected $sha256, got $actual_sha256)"
      write_update_error "checksum_mismatch" "The release bundle checksum did not match." "$version"
      rm -f "$bundle_file"; return 1
    fi
    log "Checksum verified"
  else
    log "WARN: no sha256 in manifest, skipping verification"
  fi

  # Extract and validate
  log "Extracting bundle..."
  write_update_phase extract || return 1
  mkdir -p "$extract_dir"
  if ! tar -xzf "$bundle_file" -C "$extract_dir"; then
    log "ERROR: extraction failed"
    write_update_error "bundle_extract_failed" "The release bundle could not be extracted." "$version"
    rm -rf "$extract_dir" "$bundle_file"; return 1
  fi
  if [ ! -d "$extract_dir/app" ]; then
    log "ERROR: extracted bundle missing 'app' directory"
    write_update_error "bundle_layout_invalid" "The release bundle layout was invalid." "$version"
    rm -rf "$extract_dir" "$bundle_file"; return 1
  fi
  if ! install_terminal_runtime_bootstrap_helpers "$extract_dir/bin"; then
    log "ERROR: Terminal runtime helper bootstrap failed; aborting before app replacement"
    write_update_error "terminal_runtime_helper_install_failed" "The terminal runtime verification helpers could not be installed." "$version"
    rm -rf "$extract_dir" "$bundle_file"
    return 1
  fi
  write_update_phase terminal-runtime || return 1
  if ! install_terminal_runtime_payload "$extract_dir"; then
    log "ERROR: Terminal runtime installation failed; aborting before app replacement"
    write_update_error "terminal_runtime_install_failed" "The terminal runtime assets could not be installed." "$version"
    rm -rf "$extract_dir" "$bundle_file"
    return 1
  fi
  if ! stage_release_metadata "$extract_dir/release.json" "$version"; then
    log "ERROR: Release metadata staging failed; aborting before app replacement"
    write_update_error "release_metadata_invalid" "The release metadata could not be staged safely." "$version"
    rm -rf "$extract_dir" "$bundle_file"
    return 1
  fi

  # Stop services, backup, install
  if ! write_update_phase app-install; then
    cleanup_staged_release_metadata
    return 1
  fi
  log "Stopping services..."
  sudo systemctl stop matrix-symphony matrix-gateway matrix-shell || true
  sudo rm -rf "$APP_DIR.rollback"
  if [ -d "$APP_DIR" ]; then
    sudo mv "$APP_DIR" "$APP_DIR.rollback"
    log "Backed up current app to $APP_DIR.rollback"
  fi
  sudo mv "$extract_dir/app" "$APP_DIR"
  sudo chown -R matrix:matrix "$APP_DIR"
  echo "$version" | sudo tee "$VERSION_FILE" >/dev/null
  log "Installed app $version"
  if [ -d "$extract_dir/bin" ]; then
    if ! write_update_phase host-bin || ! install_host_bin_payload "$extract_dir/bin"; then
      log "ERROR: host-bin installation failed — rolling back"
      if do_rollback false; then
        write_update_error "post_install_host_bin_failed" "The host update helpers could not be installed and the previous release was restored." "$version"
      else
        write_update_error "post_install_rollback_failed" "The host update helpers could not be installed and rollback did not complete." "$version"
      fi
      cleanup_staged_release_metadata
      rm -rf "$extract_dir" "$bundle_file"
      return 1
    fi
    log "Updated bin scripts"
  fi
  write_symphony_env
  log "Updated Symphony env"

  if [ -d "$extract_dir/systemd" ]; then
    sudo install -d -o root -g root -m 0755 /etc/systemd/system
    sudo find "$extract_dir/systemd" -maxdepth 1 -name 'matrix-*.service' -exec install -o root -g root -m 0644 {} /etc/systemd/system/ \;
    sudo systemctl daemon-reload
    log "Installed systemd units"
    if [ -f "$extract_dir/systemd/matrix-code-server.service" ]; then
      sudo systemctl enable matrix-code-server.service
      sudo systemctl start --no-block matrix-code-server.service || true
      log "Code-server runtime service enabled"
    fi
    if [ -f "$extract_dir/systemd/matrix-developer-tools.service" ]; then
      sudo systemctl enable matrix-developer-tools.service
      sudo systemctl start --no-block matrix-developer-tools.service || true
      log "Developer tools runtime service enabled"
    fi
    if [ -f "$extract_dir/systemd/matrix-code.service" ]; then
      sudo systemctl enable matrix-code.service
      sudo systemctl start --no-block matrix-code.service || true
      log "Code editor service enabled"
    fi
    if [ -f "$extract_dir/systemd/matrix-symphony.service" ]; then
      sudo systemctl enable matrix-symphony.service
      sudo systemctl start --no-block matrix-symphony.service || true
      log "Symphony service enabled"
    fi
    if [ -f "$extract_dir/systemd/matrix-hermes-dashboard.service" ]; then
      sudo systemctl enable matrix-hermes-dashboard.service
      sudo systemctl restart --no-block matrix-hermes-dashboard.service || true
      log "Hermes dashboard service refreshed"
    fi
    if [ -x /opt/matrix/messaging/bin/synapse ] && [ -x /opt/matrix/messaging/bin/mautrix-telegram ] && [ -x /opt/matrix/messaging/bin/mautrix-whatsapp ]; then
      sudo systemctl enable matrix-homeserver.service matrix-bridge-telegram.service matrix-bridge-whatsapp.service
      sudo systemctl start --no-block matrix-homeserver.service matrix-bridge-telegram.service matrix-bridge-whatsapp.service || true
      log "Messaging services enabled"
    else
      log "Messaging runtimes missing; units installed but not enabled"
    fi
  fi

  # Start services and health-check
  log "Starting services..."
  if ! sudo systemctl start matrix-gateway matrix-shell; then
    log "ERROR: updated services failed to start — rolling back"
    if do_rollback false; then
      write_update_error "post_install_service_start_failed" "The updated services failed to start and the previous release was restored." "$version"
    else
      write_update_error "post_install_rollback_failed" "The updated services failed to start and rollback did not complete." "$version"
    fi
    cleanup_staged_release_metadata
    rm -rf "$extract_dir" "$bundle_file"
    return 1
  fi
  log "Running health check..."
  write_update_phase health || return 1
  local healthy=false
  for _ in $(seq 1 18); do
    if curl --fail --silent --max-time 5 "$HEALTH_URL" >/dev/null 2>&1; then
      healthy=true; break
    fi
    sleep 5
  done
  if [ "$healthy" = true ]; then
    if commit_release_metadata; then
      log "Updated release metadata"
      log "Health check passed — update to $version complete"
      rm -f "$UPDATE_MARKER" "$UPDATE_ERROR_MARKER"
    else
      log "ERROR: release metadata commit failed — rolling back"
      if do_rollback false; then
        write_update_error "post_install_release_metadata_failed" "The release metadata could not be committed and the previous release was restored." "$version"
      else
        write_update_error "post_install_rollback_failed" "The release metadata could not be committed and rollback did not complete." "$version"
      fi
      cleanup_staged_release_metadata
      rm -rf "$extract_dir" "$bundle_file"
      return 1
    fi
  else
    log "ERROR: health check failed — rolling back"
    if do_rollback false; then
      write_update_error "post_install_health_failed" "The updated gateway failed its health check and the previous release was restored." "$version"
    else
      write_update_error "post_install_rollback_failed" "The updated gateway failed its health check and rollback did not complete." "$version"
    fi
    cleanup_staged_release_metadata
    rm -rf "$extract_dir" "$bundle_file"
    return 1
  fi
  rm -rf "$extract_dir" "$bundle_file"
  clean_staging || true
  rm -f -- "$UPDATE_PHASE_MARKER"
  restart_sync_agent_after_update
}

run_apply_update() {
  local trigger_source="${1:-other}" status version=""
  if apply_update "$trigger_source"; then
    return 0
  else
    status=$?
  fi
  if [ ! -e "$UPDATE_ERROR_MARKER" ] && [ ! -L "$UPDATE_ERROR_MARKER" ]; then
    if [ -f "$UPDATE_MARKER" ] && [ ! -L "$UPDATE_MARKER" ]; then
      version="$(json_field "$(cat "$UPDATE_MARKER")" version 2>/dev/null || true)"
    fi
    write_update_error "apply_failed" "The update failed outside a classified apply phase." "$version"
  fi
  return "$status"
}

# ── Rollback ─────────────────────────────────────────────────────────
do_rollback() {
  local restore_release_metadata="${1:-true}"
  if [ ! -d "$APP_DIR.rollback" ]; then
    log "ERROR: no rollback available at $APP_DIR.rollback"; return 1
  fi
  if [ "$restore_release_metadata" = true ] && ! rollback_release_metadata_is_ready "$APP_DIR.rollback"; then
    log "ERROR: rollback release metadata is unavailable or inconsistent"
    return 1
  fi
  log "Rolling back..."
  sudo systemctl stop matrix-symphony matrix-gateway matrix-shell || true
  if [ -d "$APP_DIR" ]; then
    sudo mkdir -p "$STAGING_DIR"
    sudo chown matrix:matrix "$STAGING_DIR"
    sudo mv "$APP_DIR" "$STAGING_DIR/failed-$(date +%s)"
  fi
  sudo mv "$APP_DIR.rollback" "$APP_DIR"
  sudo chown -R matrix:matrix "$APP_DIR"
  if [ "$restore_release_metadata" = true ]; then
    restore_rollback_release_metadata || {
      log "ERROR: rollback release metadata restore failed"
      return 1
    }
  fi
  if [ -f "$APP_DIR/$TERMINAL_RUNTIME_GENERATION_FILE" ]; then
    activate_terminal_runtime_generation "$(cat "$APP_DIR/$TERMINAL_RUNTIME_GENERATION_FILE")"
  fi
  cleanup_terminal_runtime_generations || log "WARN: terminal generation cleanup remains above cap after rollback"
  sudo systemctl start matrix-gateway matrix-shell
  sudo systemctl start --no-block matrix-symphony || true
  local healthy=false
  for _ in $(seq 1 18); do
    if curl --fail --silent --max-time 5 "$HEALTH_URL" >/dev/null 2>&1; then
      healthy=true; break
    fi
    sleep 5
  done
  if [ "$healthy" = true ]; then
    log "Rollback complete (now at $(current_version))"
  else
    log "ERROR: rollback health check failed — services may be down"
    return 1
  fi
}

# ── Signal handling ──────────────────────────────────────────────────
update_requested=false
on_sigusr1() { update_requested=true; }
trap on_sigusr1 USR1

# ── Staging cleanup ──────────────────────────────────────────────────
clean_staging() {
  [ -d "$STAGING_DIR" ] || return 0
  local count=0 now cutoff path
  now="$(date +%s)"
  cutoff=$((now - STAGING_ARTIFACT_TTL_SECONDS))
  while IFS= read -r -d '' path; do
    [ -e "$path" ] || continue
    [ ! -L "$path" ] || continue
    if [ "$(stat -c %Y "$path" 2>/dev/null || echo "$now")" -gt "$cutoff" ]; then
      continue
    fi
    sudo rm -rf -- "$path"
    count=$((count + 1))
  done < <(find "$STAGING_DIR" -mindepth 1 -maxdepth 1 \( -name 'failed-*' -o -name 'bundle-*' \) -print0)
  if [ "$count" -gt 0 ]; then
    log "Cleaned $count stale staging artifacts"
  fi
  return 0
}

clean_staging_now() {
  [ -d "$STAGING_DIR" ] || return 0
  local count=0 path
  while IFS= read -r -d '' path; do
    [ -e "$path" ] || continue
    [ ! -L "$path" ] || continue
    sudo rm -rf -- "$path"
    count=$((count + 1))
  done < <(find "$STAGING_DIR" -mindepth 1 -maxdepth 1 \( -name 'failed-*' -o -name 'bundle-*' \) -print0)
  if [ "$count" -gt 0 ]; then
    log "Cleaned $count update staging artifacts"
  fi
  return 0
}

clean_legacy_upgrade_artifacts() {
  [ -d "$LEGACY_UPGRADE_DIR" ] || return 0
  local count=0 now cutoff path
  now="$(date +%s)"
  cutoff=$((now - LEGACY_UPGRADE_TTL_SECONDS))
  while IFS= read -r -d '' path; do
    [ -e "$path" ] || continue
    [ ! -L "$path" ] || continue
    if [ "$(stat -c %Y "$path" 2>/dev/null || echo "$now")" -gt "$cutoff" ]; then
      continue
    fi
    sudo rm -f -- "$path"
    count=$((count + 1))
  done < <(find "$LEGACY_UPGRADE_DIR" -maxdepth 1 -type f \( -name 'matrix-host-bundle.tar.gz' -o -name 'matrix-host-bundle.tar.gz.sha256' \) -print0)
  if [ "$count" -gt 0 ]; then
    log "Cleaned $count stale legacy upgrade artifacts"
  fi
  return 0
}

required_update_free_kb() {
  local bundle_size_bytes="${1:-}"
  if [ -z "$bundle_size_bytes" ] || [[ "$bundle_size_bytes" == *[!0-9]* ]]; then
    echo $((UPDATE_FREE_BUFFER_KB + 5242880))
    return 0
  fi
  local bundle_kb
  bundle_kb=$(((bundle_size_bytes + 1023) / 1024))
  echo $((bundle_kb * UPDATE_EXPANSION_FACTOR + UPDATE_FREE_BUFFER_KB))
}

ensure_update_headroom() {
  local bundle_size_bytes="${1:-}" version="${2:-}"
  clean_staging || true
  clean_legacy_upgrade_artifacts || true

  local available required
  required="$(required_update_free_kb "$bundle_size_bytes")"
  available="$(df -Pk "$STAGING_DIR" | awk 'NR==2 {print $4}')"
  if [ -z "$available" ]; then
    log "WARN: could not determine free disk space before update"
    return 0
  fi
  if [ "$available" -lt "$required" ]; then
    log "ERROR: insufficient disk space for update (available: ${available}KB, required: ${required}KB)"
    write_update_error "insufficient_disk_space" "Not enough free disk space to install this update." "$version" "$available" "$required"
    return 1
  fi
  log "Update disk headroom OK (available: ${available}KB, required: ${required}KB)"
  return 0
}

clean_repairable_tmp_artifacts() {
  local staging_device tmp_device
  staging_device="$(df -Pk "$STAGING_DIR" 2>/dev/null | awk 'NR==2 {print $1}')"
  tmp_device="$(df -Pk /tmp 2>/dev/null | awk 'NR==2 {print $1}')"
  if [ -n "$staging_device" ] && [ -n "$tmp_device" ] && [ "$staging_device" != "$tmp_device" ]; then
    log "WARN: /tmp and update staging are on different filesystems; temp cleanup may not free update staging space"
  fi

  local count=0 path
  while IFS= read -r -d '' path; do
    [ -e "$path" ] || continue
    [ ! -L "$path" ] || continue
    sudo rm -f -- "$path"
    count=$((count + 1))
  done < <(find /tmp -xdev -user matrix -type f -mtime +1 \( -name '*.so' -o -path '/tmp/node-compile-cache/*' \) -print0)
  if [ "$count" -gt 0 ]; then
    log "Cleaned $count stale Matrix-owned temp files"
  fi
  return 0
}

restart_sync_agent_after_update() {
  log "Restarting sync agent to load updated agent code"
  sudo systemctl restart --no-block matrix-sync-agent.service || log "WARN: failed to restart matrix-sync-agent.service"
}

perform_update_repair() {
  log "Starting safe update repair cleanup"
  clean_staging_now || true
  clean_legacy_upgrade_artifacts || true
  clean_repairable_tmp_artifacts || true
  rm -f "$UPDATE_ERROR_MARKER"
  log "Repair complete; retrying pending update"
}

last_staging_cleanup=0

maybe_clean_staging() {
  local now
  now="$(date +%s)"
  if [ $((now - last_staging_cleanup)) -lt "$STAGING_CLEANUP_INTERVAL_SECONDS" ]; then
    return 0
  fi
  last_staging_cleanup="$now"
  clean_staging || true
}

# ── Main loop ────────────────────────────────────────────────────────
log "Started for ${MATRIX_MACHINE_ID} (version: $(current_version))"
if [ -x "$BIN_DIR/matrix-ensure-swap" ]; then
  sudo "$BIN_DIR/matrix-ensure-swap" || log "WARN: swap ensure failed (non-fatal)"
fi
mkdir -p "$STAGING_DIR"
clean_staging
clean_legacy_upgrade_artifacts || true
recover_interrupted_update
last_staging_cleanup="$(date +%s)"

while true; do
  # React to trigger files and signals
  if [ -f "$UPDATE_TRIGGER" ]; then
    rm -f "$AUTO_APPLY_FAILED_MARKER"
    if prepare_triggered_update; then
      if [ "$prepare_triggered_update_action" = already-current ]; then
        consume_idempotent_update_request
      elif run_apply_update explicit; then
        rm -f "$UPDATE_CHANNEL_FILE" "$UPDATE_VERSION_FILE"
      else
        log "Update failed — will retry on next trigger"
      fi
    else
      log "Requested release metadata fetch failed — skipping apply"
      rm -f "$UPDATE_MARKER"
      consume_update_trigger || log "WARN: failed to consume update trigger"
    fi
  fi
  if [ -f "$ROLLBACK_TRIGGER" ]; then
    sudo rm -f "$ROLLBACK_TRIGGER"
    do_rollback || log "Rollback failed"
  fi
  if [ -f "$UPDATE_REPAIR_TRIGGER" ]; then
    sudo rm -f "$UPDATE_REPAIR_TRIGGER"
    perform_update_repair
    if prepare_triggered_update; then
      if [ "$prepare_triggered_update_action" = already-current ]; then
        consume_idempotent_update_request
      elif run_apply_update; then
        rm -f "$UPDATE_CHANNEL_FILE" "$UPDATE_VERSION_FILE"
      else
        log "Update repair retry failed — will retry on next trigger"
      fi
    else
      log "Requested release metadata fetch failed after repair — skipping apply"
      rm -f "$UPDATE_MARKER"
    fi
  fi
  if [ "$update_requested" = true ]; then
    update_requested=false
    if prepare_triggered_update; then
      if [ "$prepare_triggered_update_action" = already-current ]; then
        consume_idempotent_update_request
      elif run_apply_update; then
        rm -f "$UPDATE_CHANNEL_FILE" "$UPDATE_VERSION_FILE"
      else
        log "Update (via SIGUSR1) failed — will retry on next trigger"
      fi
    else
      log "Requested release metadata fetch failed — skipping apply"
      rm -f "$UPDATE_MARKER"
    fi
  fi

  # Poll for new version
  check_for_update || true
  maybe_clean_staging

  # Sleep in 6s increments (50x = 5 min) so we react quickly to triggers
  for _ in $(seq 1 50); do
    sleep 6
