#!/usr/bin/env bash
set -euo pipefail

# Matrix OS Sync Agent — polls for bundle updates, applies on trigger, rollback support.
#
# Env (from host.env):  MATRIX_MACHINE_ID, MATRIX_HOST_BUNDLE_URL, PLATFORM_INTERNAL_URL
# Root protocol request: /run/matrix-update-runtime/request.json
# Legacy owner markers are accepted only after strict no-follow validation so
# the current and previous gateway bundle remain update-compatible.

[ "${1:-}" = "--worker" ] || {
  echo "matrix-sync-agent: worker_mode_required" >&2
  exit 2
}
[ "$(id -u)" -eq 0 ] || {
  echo "matrix-sync-agent: root_required" >&2
  exit 1
}

source /opt/matrix/env/host.env

readonly APP_DIR="/opt/matrix/app"
readonly STAGING_DIR="/opt/matrix/staging"
readonly BIN_DIR="/opt/matrix/bin"
readonly UPDATE_RUNTIME_DIR="/run/matrix-update-runtime"
readonly TYPED_REQUEST="$UPDATE_RUNTIME_DIR/request.json"
readonly INFLIGHT_REQUEST="$UPDATE_RUNTIME_DIR/inflight.json"
readonly ROLLBACK_STATE_DIR="$STAGING_DIR/rollback-state"
readonly TERMINAL_RUNTIME_LIBEXEC="/opt/matrix/libexec/terminal-runtime"
readonly TERMINAL_RUNTIME_GENERATIONS="/opt/matrix/libexec/terminal-runtime/v1"
readonly TERMINAL_RUNTIME_CURRENT="/opt/matrix/libexec/terminal-runtime/current"
readonly TERMINAL_RUNTIME_FAILED_UPDATE_SNAPSHOT="$ROLLBACK_STATE_DIR/terminal-runtime.failed-update"
readonly ZELLIJ_BINARY="$BIN_DIR/zellij"
readonly ZELLIJ_BUILD_METADATA="$BIN_DIR/zellij.build.json"
readonly ZELLIJ_ROLLBACK_DIR="$ROLLBACK_STATE_DIR/zellij.rollback"
readonly VERSION_FILE="$APP_DIR/BUNDLE_VERSION"
readonly RELEASE_FILE="/opt/matrix/release.json"
readonly UPDATE_MARKER="$UPDATE_RUNTIME_DIR/update-available.json"
readonly UPDATE_CHANNEL_FILE="$UPDATE_RUNTIME_DIR/update-channel"
readonly UPDATE_VERSION_FILE="$UPDATE_RUNTIME_DIR/update-version"
readonly UPDATE_ERROR_MARKER="$UPDATE_RUNTIME_DIR/update-error.json"
readonly AUTO_APPLY_FAILED_MARKER="$UPDATE_RUNTIME_DIR/auto-apply-failed"
readonly OPERATION_STATE="$UPDATE_RUNTIME_DIR/operation-state"
readonly LEGACY_UPDATE_TRIGGER="$APP_DIR/.update-now"
readonly LEGACY_UPDATE_CHANNEL_FILE="$APP_DIR/.update-channel"
readonly LEGACY_UPDATE_VERSION_FILE="$APP_DIR/.update-version"
readonly LEGACY_UPDATE_REPAIR_TRIGGER="$APP_DIR/.update-repair-now"
readonly LEGACY_ROLLBACK_TRIGGER="$APP_DIR/.rollback-now"
readonly HEALTH_URL="http://127.0.0.1:4000/health"
readonly STAGING_ARTIFACT_TTL_SECONDS="${MATRIX_STAGING_ARTIFACT_TTL_SECONDS:-86400}"
readonly STAGING_CLEANUP_INTERVAL_SECONDS="${MATRIX_STAGING_CLEANUP_INTERVAL_SECONDS:-3600}"
readonly UPDATE_FREE_BUFFER_KB="${MATRIX_UPDATE_FREE_BUFFER_KB:-1048576}"
readonly UPDATE_EXPANSION_FACTOR="${MATRIX_UPDATE_EXPANSION_FACTOR:-8}"
readonly LEGACY_UPGRADE_DIR="/opt/matrix-upgrade"
readonly LEGACY_UPGRADE_TTL_SECONDS="${MATRIX_LEGACY_UPGRADE_TTL_SECONDS:-86400}"
readonly SYMPHONY_ENV_FILE="/opt/matrix/env/symphony.env"
# Keys this agent owns and rewrites on every sync from platform-provided values.
# Any other key in symphony.env (e.g. an operator-set SYMPHONY_LINEAR_PROJECT_SLUG)
# is preserved across updates instead of being wiped.
readonly SYMPHONY_MANAGED_KEYS="MATRIX_HANDLE PLATFORM_INTERNAL_URL UPGRADE_TOKEN"

terminal_runtime_candidate=""
terminal_runtime_generation_id=""

log() { echo "matrix-sync-agent: $(date -u +%Y-%m-%dT%H:%M:%SZ) $*"; }
current_version() {
  python3 - "$VERSION_FILE" <<'PY' 2>/dev/null || printf 'unknown\n'
import os
import re
import stat
import sys

path = sys.argv[1]
metadata = os.lstat(path)
if (
    not stat.S_ISREG(metadata.st_mode)
    or metadata.st_nlink != 1
    or metadata.st_size < 1
    or metadata.st_size > 128
):
    raise SystemExit(1)
descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
try:
    value = os.read(descriptor, 129).decode("utf-8").strip()
finally:
    os.close(descriptor)
if not re.fullmatch(r"(?:v[0-9]|main-[A-Za-z0-9])[A-Za-z0-9._-]{0,127}", value):
    raise SystemExit(1)
print(value)
PY
}
platform_url() { echo "${MATRIX_UPDATE_MANIFEST_BASE_URL:-${PLATFORM_INTERNAL_URL:-https://app.matrix-os.com}}"; }

secure_staging_directory() {
  if [ -L "$STAGING_DIR" ]; then
    log "ERROR: staging_directory_symlink"
    return 1
  fi
  install -d -o root -g root -m 0700 "$STAGING_DIR"
  chown root:root "$STAGING_DIR"
  chmod 0700 "$STAGING_DIR"
  if [ -L "$ROLLBACK_STATE_DIR" ]; then
    log "ERROR: rollback_state_directory_symlink"
    return 1
  fi
  install -d -o root -g root -m 0700 "$ROLLBACK_STATE_DIR"
  chown root:root "$ROLLBACK_STATE_DIR"
  chmod 0700 "$ROLLBACK_STATE_DIR"
}

verify_terminal_runtime_generation() {
  local generation_dir="$1" expected_id="$2"
  local manifest="$generation_dir/runtime-manifest.sha256"
  local listed_count actual_count computed_id
  [ -d "$generation_dir" ] || return 1
  [ ! -L "$generation_dir" ] || return 1
  [ -f "$manifest" ] && [ ! -L "$manifest" ] || return 1
  if find "$generation_dir" -mindepth 1 ! -type d ! -type f -print -quit |
    grep -q .; then
    return 1
  fi
  if find "$generation_dir" -type f -links +1 -print -quit | grep -q .; then
    return 1
  fi
  if ! awk '
    length($1) != 64 || $1 !~ /^[0-9a-f]+$/ { exit 1 }
    $2 !~ /^[A-Za-z0-9._\/-]+$/ || $2 ~ /^\// || $2 ~ /(^|\/)\.\.(\/|$)/ {
      exit 1
    }
    { count += 1; paths[$2] += 1 }
    END {
      if (count < 1 || count > 4096) exit 1
      for (path in paths) if (paths[path] != 1) exit 1
    }
  ' "$manifest"; then
    return 1
  fi
  listed_count="$(awk 'END { print NR + 0 }' "$manifest")"
  actual_count="$(
    find "$generation_dir" -type f ! -path "$manifest" |
      wc -l
  )"
  [ "$listed_count" = "$actual_count" ] || return 1
  if ! (cd "$generation_dir" && sha256sum --strict -c runtime-manifest.sha256 >/dev/null); then
    return 1
  fi
  computed_id="$(sha256sum "$manifest" | awk '{print $1}')"
  [ "$computed_id" = "$expected_id" ]
}

prepare_terminal_runtime_candidate() {
  local bundle_root="$1"
  local runtime_root="$bundle_root/libexec/terminal-runtime"
  local current_target companion
  local -a generations=()
  local entry_count root_entry_count
  terminal_runtime_candidate=""
  terminal_runtime_generation_id=""
  [ -e "$runtime_root" ] || return 0
  for companion in \
    "$bundle_root/bin/matrix-terminal-supervisor" \
    "$bundle_root/bin/matrix-terminal-keeper" \
    "$bundle_root/bin/matrix-terminal-pane" \
    "$bundle_root/bin/matrix-terminal-runtime-op" \
    "$bundle_root/systemd/matrix-terminal-runtime.service" \
    "$bundle_root/systemd/matrix-terminal-session@.service" \
    "$bundle_root/systemd/matrix-terminal.slice"; do
    [ -f "$companion" ] && [ ! -L "$companion" ] || return 1
  done
  [ -d "$runtime_root/v1" ] && [ ! -L "$runtime_root/v1" ] || return 1
  [ -L "$runtime_root/current" ] || return 1
  root_entry_count="$(
    find "$runtime_root" -mindepth 1 -maxdepth 1 -print | wc -l
  )"
  [ "$root_entry_count" -eq 2 ] || return 1
  entry_count="$(
    find "$runtime_root/v1" -mindepth 1 -maxdepth 1 -print | wc -l
  )"
  [ "$entry_count" -eq 1 ] || return 1
  mapfile -d '' generations < <(
    find "$runtime_root/v1" -mindepth 1 -maxdepth 1 -type d -print0
  )
  [ "${#generations[@]}" -eq 1 ] || return 1
  terminal_runtime_generation_id="$(basename "${generations[0]}")"
  [[ "$terminal_runtime_generation_id" =~ ^[0-9a-f]{64}$ ]] || return 1
  current_target="$(readlink "$runtime_root/current")"
  [ "$current_target" = "v1/$terminal_runtime_generation_id" ] || return 1
  verify_terminal_runtime_generation \
    "${generations[0]}" \
    "$terminal_runtime_generation_id" || return 1
  terminal_runtime_candidate="${generations[0]}"
}

install_terminal_runtime_generation() {
  [ -n "$terminal_runtime_candidate" ] || return 0
  local generation_root="$TERMINAL_RUNTIME_GENERATIONS"
  local generation_dir="$generation_root/$terminal_runtime_generation_id"
  local generation_next="$generation_root/.${terminal_runtime_generation_id}.next"
  local current_next="$TERMINAL_RUNTIME_LIBEXEC/.current.next"
  install -d -o root -g root -m 0755 "$generation_root"
  if [ ! -d "$generation_dir" ]; then
    rm -rf -- "$generation_next"
    install -d -o root -g root -m 0755 "$generation_next"
    cp -a -- "$terminal_runtime_candidate/." "$generation_next/"
    chown -R root:root "$generation_next"
    if ! verify_terminal_runtime_generation \
      "$generation_next" \
      "$terminal_runtime_generation_id"; then
      rm -rf -- "$generation_next"
      return 1
    fi
    mv -- "$generation_next" "$generation_dir"
  elif ! verify_terminal_runtime_generation \
    "$generation_dir" \
    "$terminal_runtime_generation_id"; then
    return 1
  fi
  rm -f -- "$current_next"
  ln -s "v1/$terminal_runtime_generation_id" "$current_next"
  mv -T -- "$current_next" "$TERMINAL_RUNTIME_CURRENT"
}

install_terminal_runtime_wrappers() {
  local source_dir="$1"
  local wrapper wrapper_name wrapper_next
  for wrapper in \
    "$source_dir/matrix-terminal-supervisor" \
    "$source_dir/matrix-terminal-keeper" \
    "$source_dir/matrix-terminal-pane" \
    "$source_dir/matrix-terminal-runtime-op"; do
    [ -f "$wrapper" ] || return 1
    [ ! -L "$wrapper" ] || return 1
    wrapper_name="$(basename "$wrapper")"
    wrapper_next="$BIN_DIR/.${wrapper_name}.next"
    install -o root -g root -m 0755 "$wrapper" "$wrapper_next"
    mv -f -- "$wrapper_next" "$BIN_DIR/$wrapper_name"
  done
}

install_update_runtime_bins() {
  local source_dir="$1" name next
  for name in \
    matrix-update-service \
    matrix-sync-agent \
    matrix-update \
    matrix-validate-host-bundle; do
    [ -f "$source_dir/$name" ] && [ ! -L "$source_dir/$name" ] || return 1
    next="$BIN_DIR/.${name}.next"
    install -o root -g root -m 0755 "$source_dir/$name" "$next"
    mv -f -- "$next" "$BIN_DIR/$name"
  done
}

install_systemd_units_atomic() {
  local source_dir="$1"
  local unit_source unit_name unit_next
  install -d -o root -g root -m 0755 /etc/systemd/system
  while IFS= read -r -d '' unit_source; do
    unit_name="$(basename "$unit_source")"
    if [[ ! "$unit_name" =~ ^matrix-[A-Za-z0-9@_.-]+\.(service|slice)$ ]]; then
      return 1
    fi
    unit_next="/etc/systemd/system/.${unit_name}.next"
    install -o root -g root -m 0644 "$unit_source" "$unit_next"
    mv -f -- "$unit_next" "/etc/systemd/system/$unit_name"
  done < <(
    find "$source_dir" -maxdepth 1 -type f \
      \( -name 'matrix-*.service' -o -name 'matrix-*.slice' \) -print0
  )
}

backup_terminal_runtime_for_failed_update() {
  local snapshot_next="${TERMINAL_RUNTIME_FAILED_UPDATE_SNAPSHOT}.next"
  local artifact name
  rm -rf -- "$snapshot_next" "$TERMINAL_RUNTIME_FAILED_UPDATE_SNAPSHOT"
  install -d -o root -g root -m 0700 \
    "$snapshot_next/bin" \
    "$snapshot_next/systemd"
  if [ -L "$TERMINAL_RUNTIME_CURRENT" ]; then
    local current_target
    current_target="$(readlink "$TERMINAL_RUNTIME_CURRENT")"
    [[ "$current_target" =~ ^v1/[0-9a-f]{64}$ ]] || return 1
    printf '%s\n' "$current_target" |
      tee "$snapshot_next/current-target" >/dev/null
    chown root:root "$snapshot_next/current-target"
    chmod 0600 "$snapshot_next/current-target"
  fi
  for artifact in \
    "$BIN_DIR/matrix-terminal-supervisor" \
    "$BIN_DIR/matrix-terminal-keeper" \
    "$BIN_DIR/matrix-terminal-pane" \
    "$BIN_DIR/matrix-terminal-runtime-op"; do
    name="$(basename "$artifact")"
    if [ -e "$artifact" ] || [ -L "$artifact" ]; then
      [ -f "$artifact" ] && [ ! -L "$artifact" ] || return 1
      install -o root -g root -m 0700 \
        "$artifact" "$snapshot_next/bin/$name"
    fi
  done
  for artifact in \
    /etc/systemd/system/matrix-terminal-runtime.service \
    /etc/systemd/system/matrix-terminal-session@.service \
    /etc/systemd/system/matrix-terminal.slice; do
    name="$(basename "$artifact")"
    if [ -e "$artifact" ] || [ -L "$artifact" ]; then
      [ -f "$artifact" ] && [ ! -L "$artifact" ] || return 1
      install -o root -g root -m 0600 \
        "$artifact" "$snapshot_next/systemd/$name"
    fi
  done
  if systemctl is-enabled --quiet matrix-terminal-runtime.service; then
    touch "$snapshot_next/supervisor-was-enabled"
    chown root:root "$snapshot_next/supervisor-was-enabled"
    chmod 0600 "$snapshot_next/supervisor-was-enabled"
  fi
  if systemctl is-active --quiet matrix-terminal-runtime.service; then
    touch "$snapshot_next/supervisor-was-active"
    chown root:root "$snapshot_next/supervisor-was-active"
    chmod 0600 "$snapshot_next/supervisor-was-active"
  fi
  mv -- "$snapshot_next" "$TERMINAL_RUNTIME_FAILED_UPDATE_SNAPSHOT"
}

terminate_new_terminal_runtime_supervisor_after_failed_start() {
  local snapshot="$TERMINAL_RUNTIME_FAILED_UPDATE_SNAPSHOT"
  [ -d "$snapshot" ] && [ ! -L "$snapshot" ] || return 1
  [ ! -f "$snapshot/supervisor-was-active" ] || return 1
  systemctl stop matrix-terminal-runtime.service || return 1
  systemctl reset-failed matrix-terminal-runtime.service ||
    log "WARN: terminal_runtime_supervisor_reset_failed"
  if systemctl is-active --quiet matrix-terminal-runtime.service; then
    return 1
  fi
}

restore_terminal_runtime_after_failed_update() {
  local snapshot="$TERMINAL_RUNTIME_FAILED_UPDATE_SNAPSHOT"
  local artifact name restore_next
  [ -d "$snapshot" ] && [ ! -L "$snapshot" ] || return 0
  if [ -f "$snapshot/current-target" ] && [ ! -L "$snapshot/current-target" ]; then
    local current_target current_next
    current_target="$(cat "$snapshot/current-target")"
    [[ "$current_target" =~ ^v1/[0-9a-f]{64}$ ]] || return 1
    [ -d "$TERMINAL_RUNTIME_LIBEXEC/$current_target" ] || return 1
    current_next="$TERMINAL_RUNTIME_LIBEXEC/.current.rollback-next"
    rm -f -- "$current_next"
    ln -s "$current_target" "$current_next"
    mv -T -- "$current_next" "$TERMINAL_RUNTIME_CURRENT"
  else
    rm -f -- "$TERMINAL_RUNTIME_CURRENT"
  fi
  for name in \
    matrix-terminal-supervisor \
    matrix-terminal-keeper \
    matrix-terminal-pane \
    matrix-terminal-runtime-op; do
    artifact="$snapshot/bin/$name"
    if [ -f "$artifact" ] && [ ! -L "$artifact" ]; then
      restore_next="$BIN_DIR/.${name}.rollback-next"
      install -o root -g root -m 0755 "$artifact" "$restore_next"
      mv -f -- "$restore_next" "$BIN_DIR/$name"
    else
      rm -f -- "$BIN_DIR/$name"
    fi
  done
  for name in \
    matrix-terminal-runtime.service \
    matrix-terminal-session@.service \
    matrix-terminal.slice; do
    artifact="$snapshot/systemd/$name"
    if [ -f "$artifact" ] && [ ! -L "$artifact" ]; then
      restore_next="/etc/systemd/system/.${name}.rollback-next"
      install -o root -g root -m 0644 "$artifact" "$restore_next"
      mv -f -- "$restore_next" "/etc/systemd/system/$name"
    else
      rm -f -- "/etc/systemd/system/$name"
    fi
  done
  if [ ! -f "$snapshot/supervisor-was-enabled" ]; then
    systemctl disable matrix-terminal-runtime.service >/dev/null 2>&1 || true
  fi
  systemctl daemon-reload
  rm -rf -- "$snapshot"
}

# Echo the lines of an existing symphony.env that this agent does not manage so
# operator-set configuration survives a host bundle update. Blank and comment
# lines are kept; managed KEY= lines are dropped (re-emitted with fresh values
# by write_symphony_env). Group-readable file (root:matrix 0640), so the matrix
# owner gateway can read its non-secret configuration directly.
preserve_unmanaged_symphony_env() {
  local existing_file="$1"
  [ -f "$existing_file" ] || return 0
  local line key
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      '' | '#'*)
        printf '%s\n' "$line"
        ;;
      *=*)
        key="${line%%=*}"
        case " $SYMPHONY_MANAGED_KEYS " in
          *" $key "*) : ;; # managed key: re-emitted with fresh value elsewhere
          *) printf '%s\n' "$line" ;;
        esac
        ;;
      *)
        printf '%s\n' "$line"
        ;;
    esac
  done <"$existing_file"
}

write_symphony_env() {
  local status=0
  local temp_file
  temp_file="$(mktemp)"
  {
    printf 'MATRIX_HANDLE=%s\n' "${MATRIX_HANDLE:?MATRIX_HANDLE is required}"
    printf 'PLATFORM_INTERNAL_URL=%s\n' "${PLATFORM_INTERNAL_URL:?PLATFORM_INTERNAL_URL is required}"
    printf 'UPGRADE_TOKEN=%s\n' "${UPGRADE_TOKEN:?UPGRADE_TOKEN is required}"
    preserve_unmanaged_symphony_env "$SYMPHONY_ENV_FILE"
  } >"$temp_file"
  install -o root -g matrix -m 0640 "$temp_file" "$SYMPHONY_ENV_FILE" || status=$?
  rm -f "$temp_file"
  return "$status"
}

clear_zellij_rollback() {
  rm -rf -- "$ZELLIJ_ROLLBACK_DIR"
}

backup_zellij_for_rollback() {
  local rollback_next="${ZELLIJ_ROLLBACK_DIR}.next"
  rm -rf -- "$rollback_next"
  install -d -o root -g root -m 0700 "$rollback_next"
  if [ -f "$ZELLIJ_BINARY" ]; then
    install -o root -g root -m 0700 "$ZELLIJ_BINARY" "$rollback_next/zellij"
    touch "$rollback_next/had-binary"
  fi
  if [ -f "$ZELLIJ_BUILD_METADATA" ]; then
    install -o root -g root -m 0600 "$ZELLIJ_BUILD_METADATA" "$rollback_next/zellij.build.json"
    touch "$rollback_next/had-build-metadata"
  fi
  chown root:root "$rollback_next"/had-* 2>/dev/null || true
  chmod 0600 "$rollback_next"/had-* 2>/dev/null || true
  clear_zellij_rollback
  mv -- "$rollback_next" "$ZELLIJ_ROLLBACK_DIR"
}

restore_zellij_after_rollback() {
  [ -d "$ZELLIJ_ROLLBACK_DIR" ] || return 0
  local zellij_restore_next="$BIN_DIR/.zellij.rollback-next"
  local metadata_restore_next="$BIN_DIR/.zellij.build.json.rollback-next"

  if [ -f "$ZELLIJ_ROLLBACK_DIR/had-binary" ] && [ -f "$ZELLIJ_ROLLBACK_DIR/zellij" ]; then
    install -o root -g root -m 0755 "$ZELLIJ_ROLLBACK_DIR/zellij" "$zellij_restore_next"
    mv -f -- "$zellij_restore_next" "$ZELLIJ_BINARY"
  else
    rm -f -- "$ZELLIJ_BINARY"
  fi
  if [ -f "$ZELLIJ_ROLLBACK_DIR/had-build-metadata" ] && [ -f "$ZELLIJ_ROLLBACK_DIR/zellij.build.json" ]; then
    install -o root -g root -m 0644 "$ZELLIJ_ROLLBACK_DIR/zellij.build.json" "$metadata_restore_next"
    mv -f -- "$metadata_restore_next" "$ZELLIJ_BUILD_METADATA"
  else
    rm -f -- "$ZELLIJ_BUILD_METADATA"
  fi
  clear_zellij_rollback
}
default_update_channel() {
  local channel="${MATRIX_UPDATE_CHANNEL:-}"
  case "$channel" in
    stable|canary|beta|dev) echo "$channel"; return 0 ;;
  esac
  if [ -f "$RELEASE_FILE" ]; then
    channel="$(python3 -c "import json,sys; print(json.load(open(sys.argv[1])).get('channel',''))" "$RELEASE_FILE" 2>/dev/null || true)"
    case "$channel" in
      stable|canary|beta|dev) echo "$channel"; return 0 ;;
    esac
  fi
  echo "stable"
}
manifest_url() {
  local channel
  channel="$(default_update_channel)"
  echo "$(platform_url)/system-bundles/channels/${channel}.json"
}
release_url_for_version() { echo "$(platform_url)/system-bundles/releases/$1.json"; }
release_url_for_channel() { echo "$(platform_url)/system-bundles/channels/$1.json"; }

json_field() { python3 -c "import json,sys; print(json.load(sys.stdin).get(sys.argv[1],''))" "$2" <<< "$1"; }
valid_update_channel() { [[ "${1:-}" =~ ^(stable|canary|beta|dev)$ ]]; }
valid_update_version() {
  [[ "${1:-}" =~ ^(v[0-9]|main-[A-Za-z0-9])[A-Za-z0-9._-]{0,127}$ ]]
}

write_update_error() {
  local code="$1" message="$2" version="${3:-}" available_kb="${4:-}" required_kb="${5:-}"
  python3 - "$UPDATE_ERROR_MARKER" "$code" "$message" "$version" "$available_kb" "$required_kb" <<'PY'
import json
import sys
from datetime import datetime, timezone

path, code, message, version, available_kb, required_kb = sys.argv[1:7]
payload = {
    "code": code,
    "message": message,
    "failedAt": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
}
if version:
    payload["version"] = version
for key, value in (("availableKb", available_kb), ("requiredKb", required_kb)):
    if value:
        try:
            payload[key] = int(value)
        except ValueError:
            pass
with open(path, "w", encoding="utf-8") as handle:
    json.dump(payload, handle, separators=(",", ":"))
    handle.write("\n")
PY
}

sanitize_manifest() {
  python3 -c '
import json
import re
import sys

try:
    raw = json.load(sys.stdin)
    version = raw.get("version")
    sha256 = raw.get("sha256") or raw.get("bundleSha256")
    if not sha256 and isinstance(raw.get("files"), dict):
        bundle = raw["files"].get("bundle")
        if isinstance(bundle, dict):
            sha256 = bundle.get("sha256")
    size = raw.get("size")
    if size is None and isinstance(raw.get("files"), dict):
        bundle = raw["files"].get("bundle")
        if isinstance(bundle, dict):
            size = bundle.get("size")
    if not isinstance(version, str) or not re.fullmatch(
        r"(?:v[0-9]|main-[A-Za-z0-9])[A-Za-z0-9._-]{0,127}", version
    ):
        raise ValueError("version")
    if not isinstance(sha256, str) or not re.fullmatch(r"[0-9a-f]{64}", sha256):
        raise ValueError("sha256")
    if (
        not isinstance(size, int)
        or isinstance(size, bool)
        or size <= 0
        or size > 8 * 1024 * 1024 * 1024
    ):
        raise ValueError("size")
    channel = raw.get("channel")
    if channel not in {"stable", "canary", "beta", "dev", None}:
        raise ValueError("channel")
    severity = raw.get("severity")
    if severity not in {"security", "critical", "normal", None}:
        raise ValueError("severity")
    update_type = raw.get("updateType")
    if update_type not in {"auto", "manual", None}:
        raise ValueError("updateType")
    json.dump(
        {
            "version": version,
            "sha256": sha256,
            "size": size,
            "channel": channel,
            "severity": severity,
            "updateType": update_type,
        },
        sys.stdout,
        separators=(",", ":"),
        sort_keys=True,
    )
except (AttributeError, json.JSONDecodeError, TypeError, ValueError):
    raise SystemExit(1)
'
}

fetch_manifest() {
  local url="$1" manifest
  if ! manifest="$(curl --fail --silent --show-error --max-time 15 "$url" 2>&1)"; then
    log "WARN: release_metadata_fetch_failed"; return 1
  fi
  if ! printf '%s' "$manifest" | sanitize_manifest; then
    log "WARN: release_metadata_invalid"
    return 1
  fi
}

prepare_triggered_update() {
  local url="" target=""
  if [ -f "$UPDATE_VERSION_FILE" ]; then
    target="$(cat "$UPDATE_VERSION_FILE" 2>/dev/null || true)"
    valid_update_version "$target" || { log "WARN: update_version_invalid"; return 1; }
    url="$(release_url_for_version "$target")"
  elif [ -f "$UPDATE_CHANNEL_FILE" ]; then
    target="$(cat "$UPDATE_CHANNEL_FILE" 2>/dev/null || true)"
    valid_update_channel "$target" || { log "WARN: update_channel_invalid"; return 1; }
    url="$(release_url_for_channel "$target")"
  elif [ -f "$UPDATE_MARKER" ]; then
    local manifest remote_version marker_channel
    if ! manifest="$(sanitize_manifest <"$UPDATE_MARKER")"; then
      log "WARN: prepared_release_metadata_invalid"
      rm -f "$UPDATE_MARKER"
      return 1
    fi
    remote_version="$(json_field "$manifest" version)"
    if [ -z "$remote_version" ]; then
      log "WARN: prepared release metadata missing 'version' field"; return 1
    fi
    marker_channel="$(json_field "$manifest" channel)"
    log "Prepared requested update target ${marker_channel:-prepared}: $remote_version"
    return 0
  else
    target="$(default_update_channel)"
    url="$(manifest_url)"
  fi

  local manifest remote_version
  manifest="$(fetch_manifest "$url")" || return 1
  remote_version="$(json_field "$manifest" version)"
  if [ -z "$remote_version" ]; then
    log "WARN: release metadata missing 'version' field"; return 1
  fi
  if [ ! -f "$UPDATE_VERSION_FILE" ] && [ ! -f "$UPDATE_CHANNEL_FILE" ] && [ "$remote_version" = "$(current_version)" ]; then
    log "No update available on ${target} — nothing to apply"
    rm -f "$UPDATE_MARKER"
    return 1
  fi
  echo "$manifest" > "$UPDATE_MARKER"
  log "Prepared requested update target ${target}: $remote_version"
}

# ── Poll for updates ─────────────────────────────────────────────────
check_for_update() {
  local url manifest remote_version cur
  url="$(manifest_url)"
  manifest="$(fetch_manifest "$url")" || return 1
  remote_version="$(json_field "$manifest" version)"
  if [ -z "$remote_version" ]; then
    log "WARN: manifest missing 'version' field"; return 1
  fi
  cur="$(current_version)"
  if [ "$remote_version" = "$cur" ]; then return 0; fi

  local severity update_type
  severity="$(json_field "$manifest" severity)"
  update_type="$(json_field "$manifest" updateType)"

  log "Update available: $remote_version (current: $cur, severity: ${severity:-normal})"
  echo "$manifest" > "$UPDATE_MARKER"

  if [ "$severity" = "security" ] || [ "$update_type" = "auto" ]; then
    if [ -f "$AUTO_APPLY_FAILED_MARKER" ] && [ "$(cat "$AUTO_APPLY_FAILED_MARKER" 2>/dev/null)" = "$remote_version" ]; then
      log "Skipping auto-apply for $remote_version — previous attempt failed (use .update-now to retry)"
    else
      log "Auto-apply update $remote_version (severity=${severity:-normal}, updateType=${update_type:-manual})"
      if ! apply_update; then
        echo "$remote_version" > "$AUTO_APPLY_FAILED_MARKER"
        log "Auto-apply failed — will not retry automatically (use .update-now to force)"
      else
        rm -f "$AUTO_APPLY_FAILED_MARKER"
      fi
    fi
  fi
}

# ── Apply update ─────────────────────────────────────────────────────
apply_update() {
  if [ ! -f "$UPDATE_MARKER" ]; then
    log "No update available — nothing to apply"; return 1
  fi
  local manifest version sha256 bundle_url cur bundle_file extract_dir
  local expected_bundle_size actual_bundle_size
  local zellij_candidate=false zellij_expected_sha256="" zellij_actual_sha256="" zellij_next=""
  local terminal_runtime_enable_after_health=false
  if ! manifest="$(sanitize_manifest <"$UPDATE_MARKER")"; then
    log "ERROR: prepared_release_metadata_invalid"
    rm -f "$UPDATE_MARKER"
    return 1
  fi
  version="$(json_field "$manifest" version)"
  sha256="$(json_field "$manifest" sha256)"
  expected_bundle_size="$(json_field "$manifest" size)"
  valid_update_version "$version" || return 1
  bundle_url="$(platform_url)/system-bundles/${version}/matrix-host-bundle.tar.gz"
  cur="$(current_version)"
  log "Starting update from $cur to $version"

  secure_staging_directory || return 1
  ensure_update_headroom "$(json_field "$manifest" size)" "$version" || return 1
  rm -f "$UPDATE_ERROR_MARKER"
  bundle_file="$STAGING_DIR/bundle-${version}.tar.gz"
  extract_dir="$STAGING_DIR/bundle-${version}"

  log "Downloading bundle..."
  if ! curl --fail --location --retry 3 --retry-delay 5 --retry-all-errors \
       --connect-timeout 10 --max-time 1800 --http1.1 \
       --max-filesize "$expected_bundle_size" \
       "$bundle_url" -o "$bundle_file"; then
    log "ERROR: download failed"; rm -f "$bundle_file"; return 1
  fi
  actual_bundle_size="$(stat -c %s "$bundle_file")"
  if [ "$actual_bundle_size" != "$expected_bundle_size" ]; then
    log "ERROR: bundle_size_mismatch"
    rm -f "$bundle_file"; return 1
  fi

  # Verify the required release checksum before inspecting or extracting bytes.
  local actual_sha256
  actual_sha256="$(sha256sum "$bundle_file" | awk '{print $1}')"
  if [ "$actual_sha256" != "$sha256" ]; then
    log "ERROR: bundle_checksum_mismatch"
    rm -f "$bundle_file"; return 1
  fi
  log "Checksum verified"

  # Extract and validate
  if ! "$BIN_DIR/matrix-validate-host-bundle" "$bundle_file"; then
    log "ERROR: bundle_archive_invalid"
    rm -f "$bundle_file"; return 1
  fi
  log "Extracting bundle..."
  install -d -o root -g root -m 0700 "$extract_dir"
  if ! tar --no-same-owner --no-same-permissions -xzf "$bundle_file" -C "$extract_dir"; then
    log "ERROR: extraction failed"; rm -rf "$extract_dir" "$bundle_file"; return 1
  fi
  if [ ! -d "$extract_dir/app" ]; then
    log "ERROR: extracted bundle missing 'app' directory"
    rm -rf "$extract_dir" "$bundle_file"; return 1
  fi
  rm -rf -- "$extract_dir/app/BUNDLE_VERSION"
  printf '%s\n' "$version" >"$extract_dir/app/BUNDLE_VERSION"
  if [ -f "$extract_dir/bin/zellij.build.json" ] || [ -f "$extract_dir/bin/zellij" ]; then
    if [ -f "$extract_dir/bin/zellij.build.json" ]; then
      if [ ! -f "$extract_dir/bin/zellij" ]; then
        log "ERROR: zellij candidate metadata has no binary"
        rm -rf "$extract_dir" "$bundle_file"; return 1
      fi
      if ! zellij_expected_sha256="$(json_field "$(cat "$extract_dir/bin/zellij.build.json")" binarySha256 2>/dev/null)"; then
        log "ERROR: invalid zellij candidate metadata"
        rm -rf "$extract_dir" "$bundle_file"; return 1
      fi
      zellij_actual_sha256="$(sha256sum "$extract_dir/bin/zellij" | awk '{print $1}')"
      if [[ ! "$zellij_expected_sha256" =~ ^[0-9a-f]{64}$ ]] || [ "$zellij_actual_sha256" != "$zellij_expected_sha256" ]; then
        log "ERROR: zellij_candidate_digest_mismatch"
        rm -rf "$extract_dir" "$bundle_file"; return 1
      fi
      zellij_candidate=true
    fi
  fi
  if ! prepare_terminal_runtime_candidate "$extract_dir"; then
    log "ERROR: terminal_runtime_candidate_invalid"
    rm -rf "$extract_dir" "$bundle_file"
    return 1
  fi

  # Any bundle that replaces Zellij extends the existing one-level app rollback
  # to the exact binary and identity record. Candidate status controls only the
  # additional digest checks and atomic candidate install path.
  # Stop services before placing the root-owned snapshot inside the current app;
  # moving that app to app.rollback then commits both as one filesystem rename.
  log "Stopping services..."
  systemctl stop matrix-symphony matrix-gateway matrix-shell || true
  if [ -f "$extract_dir/bin/zellij" ]; then
    backup_zellij_for_rollback
  fi
  if [ -n "$terminal_runtime_candidate" ]; then
    if ! backup_terminal_runtime_for_failed_update; then
      log "ERROR: terminal_runtime_rollback_snapshot_failed"
      rm -rf -- \
        "${TERMINAL_RUNTIME_FAILED_UPDATE_SNAPSHOT}.next" \
        "$TERMINAL_RUNTIME_FAILED_UPDATE_SNAPSHOT"
      systemctl start matrix-gateway matrix-shell
      systemctl start --no-block matrix-symphony || true
      rm -rf "$extract_dir" "$bundle_file"
      return 1
    fi
  fi
  rm -rf "$APP_DIR.rollback"
  if [ -d "$APP_DIR" ]; then
    mv "$APP_DIR" "$APP_DIR.rollback"
    log "Backed up current app to $APP_DIR.rollback"
  fi
  mv "$extract_dir/app" "$APP_DIR"
  chown -R matrix:matrix "$APP_DIR"
  log "Installed app $version"
  if [ -f "$extract_dir/release.json" ]; then
    install -o root -g matrix -m 0644 "$extract_dir/release.json" "$RELEASE_FILE"
    log "Updated release metadata"
  fi
  if ! install_terminal_runtime_generation; then
    log "ERROR: terminal_runtime_generation_install_failed"
    do_rollback failed-update || log "ERROR: rollback after terminal runtime install failure failed"
    rm -rf "$extract_dir" "$bundle_file"
    return 1
  fi
  if [ -d "$extract_dir/bin" ]; then
    if ! install_update_runtime_bins "$extract_dir/bin"; then
      log "ERROR: update_runtime_install_failed"
      do_rollback failed-update || log "ERROR: rollback after update runtime install failure failed"
      rm -rf "$extract_dir" "$bundle_file"
      return 1
    fi
    if [ -n "$terminal_runtime_candidate" ] &&
      ! install_terminal_runtime_wrappers "$extract_dir/bin"; then
      log "ERROR: terminal_runtime_wrapper_install_failed"
      do_rollback failed-update || log "ERROR: rollback after terminal wrapper failure failed"
      rm -rf "$extract_dir" "$bundle_file"
      return 1
    fi
    if [ "$zellij_candidate" = true ]; then
      zellij_next="$BIN_DIR/.zellij.next"
      rm -f -- "$zellij_next"
      if ! install -o root -g root -m 0755 "$extract_dir/bin/zellij" "$zellij_next"; then
        log "ERROR: zellij candidate staging failed"
        do_rollback failed-update || log "ERROR: rollback after zellij staging failure failed"
        rm -rf "$extract_dir" "$bundle_file"
        return 1
      fi
      if ! mv -f "$zellij_next" "$BIN_DIR/zellij"; then
        rm -f -- "$zellij_next"
        log "ERROR: zellij candidate commit failed"
        do_rollback failed-update || log "ERROR: rollback after zellij commit failure failed"
        rm -rf "$extract_dir" "$bundle_file"
        return 1
      fi
      if ! install -o root -g root -m 0644 "$extract_dir/bin/zellij.build.json" "$BIN_DIR/zellij.build.json"; then
        log "ERROR: zellij candidate metadata commit failed"
        do_rollback failed-update || log "ERROR: rollback after zellij metadata failure failed"
        rm -rf "$extract_dir" "$bundle_file"
        return 1
      fi
      zellij_actual_sha256="$(sha256sum "$BIN_DIR/zellij" | awk '{print $1}')"
      if [ "$zellij_actual_sha256" != "$zellij_expected_sha256" ]; then
        log "ERROR: zellij_installed_digest_mismatch"
        do_rollback failed-update || log "ERROR: rollback after zellij digest failure failed"
        rm -rf "$extract_dir" "$bundle_file"
        return 1
      fi
      find "$extract_dir/bin" -maxdepth 1 -type f \
        ! -name 'zellij' \
        ! -name 'zellij.build.json' \
        ! -name 'matrix-terminal-*' \
        ! -name 'matrix-update-service' \
        ! -name 'matrix-sync-agent' \
        ! -name 'matrix-update' \
        ! -name 'matrix-validate-host-bundle' \
        -exec cp -a {} "$BIN_DIR/" \;
    else
      find "$extract_dir/bin" -maxdepth 1 -type f \
        ! -name 'matrix-terminal-*' \
        ! -name 'matrix-update-service' \
        ! -name 'matrix-sync-agent' \
        ! -name 'matrix-update' \
        ! -name 'matrix-validate-host-bundle' \
        -exec cp -a {} "$BIN_DIR/" \;
      if [ -f "$extract_dir/bin/zellij" ]; then
        rm -f -- "$ZELLIJ_BUILD_METADATA"
      fi
    fi
    find "$extract_dir/bin" -maxdepth 1 -type f -exec chmod 0755 {} +
    log "Updated bin scripts"
  fi
  write_symphony_env
  log "Updated Symphony env"

  if [ -d "$extract_dir/systemd" ]; then
    if ! install_systemd_units_atomic "$extract_dir/systemd"; then
      log "ERROR: systemd_unit_install_failed"
      do_rollback failed-update || log "ERROR: rollback after systemd unit failure failed"
      rm -rf "$extract_dir" "$bundle_file"
      return 1
    fi
    systemctl daemon-reload
    log "Installed systemd units"
    if [ -f "$extract_dir/systemd/matrix-terminal-runtime.service" ] &&
      ! systemctl is-enabled --quiet matrix-terminal-runtime.service; then
      terminal_runtime_enable_after_health=true
    fi
    if [ -f "$extract_dir/systemd/matrix-code-server.service" ]; then
      systemctl enable matrix-code-server.service
      systemctl start --no-block matrix-code-server.service || true
      log "Code-server runtime service enabled"
    fi
    if [ -f "$extract_dir/systemd/matrix-developer-tools.service" ]; then
      systemctl enable matrix-developer-tools.service
      systemctl start --no-block matrix-developer-tools.service || true
      log "Developer tools runtime service enabled"
    fi
    if [ -f "$extract_dir/systemd/matrix-code.service" ]; then
      systemctl enable matrix-code.service
      systemctl start --no-block matrix-code.service || true
      log "Code editor service enabled"
    fi
    if [ -f "$extract_dir/systemd/matrix-symphony.service" ]; then
      systemctl enable matrix-symphony.service
      systemctl start --no-block matrix-symphony.service || true
      log "Symphony service enabled"
    fi
    if [ -x /opt/matrix/messaging/bin/synapse ] && [ -x /opt/matrix/messaging/bin/mautrix-telegram ] && [ -x /opt/matrix/messaging/bin/mautrix-whatsapp ]; then
      systemctl enable matrix-homeserver.service matrix-bridge-telegram.service matrix-bridge-whatsapp.service
      systemctl start --no-block matrix-homeserver.service matrix-bridge-telegram.service matrix-bridge-whatsapp.service || true
      log "Messaging services enabled"
    else
      log "Messaging runtimes missing; units installed but not enabled"
    fi
  fi

  # Start services and health-check
  log "Starting services..."
  systemctl start matrix-gateway matrix-shell
  log "Running health check..."
  local healthy=false
  for _ in $(seq 1 18); do
    if curl --fail --silent --max-time 5 "$HEALTH_URL" >/dev/null 2>&1; then
      healthy=true; break
    fi
    sleep 5
  done
  if [ "$healthy" = true ]; then
    if [ "$terminal_runtime_enable_after_health" = true ]; then
      if ! systemctl enable matrix-terminal-runtime.service; then
        log "ERROR: terminal_runtime_supervisor_enable_failed"
        do_rollback failed-update ||
          log "ERROR: rollback after terminal supervisor enable failure failed"
        rm -rf "$extract_dir" "$bundle_file"
        return 1
      fi
      if ! systemctl start matrix-terminal-runtime.service; then
        log "ERROR: terminal_runtime_supervisor_start_failed"
        if ! terminate_new_terminal_runtime_supervisor_after_failed_start; then
          log "ERROR: terminal_runtime_supervisor_cleanup_failed"
          log "WARN: terminal_runtime_supervisor_cleanup_preserved_host_layer"
          do_rollback explicit ||
            log "ERROR: application rollback after supervisor cleanup failure failed"
          rm -rf "$extract_dir" "$bundle_file"
          return 1
        fi
        do_rollback failed-update ||
          log "ERROR: rollback after terminal supervisor start failure failed"
        rm -rf "$extract_dir" "$bundle_file"
        return 1
      fi
      log "Terminal runtime supervisor enabled"
    fi
    if ! systemctl enable matrix-update-runtime.service; then
      log "ERROR: update_runtime_enable_failed"
      do_rollback failed-update ||
        log "ERROR: rollback after update runtime enable failure failed"
      rm -rf "$extract_dir" "$bundle_file"
      return 1
    fi
    if ! systemctl disable matrix-sync-agent.service; then
      log "ERROR: legacy_update_bridge_disable_failed"
      do_rollback failed-update ||
        log "ERROR: rollback after legacy update bridge disable failure failed"
      rm -rf "$extract_dir" "$bundle_file"
      return 1
    fi
    log "Health check passed — update to $version complete"
    rm -f "$UPDATE_MARKER" "$UPDATE_ERROR_MARKER"
    rm -rf -- "$TERMINAL_RUNTIME_FAILED_UPDATE_SNAPSHOT"
  else
    log "ERROR: health check failed — rolling back"
    do_rollback failed-update
    rm -rf "$extract_dir" "$bundle_file"
    return 1
  fi
  rm -rf "$extract_dir" "$bundle_file"
  clean_staging || true
  return 0
}

# ── Rollback ─────────────────────────────────────────────────────────
do_rollback() {
  local rollback_kind="${1:-explicit}"
  case "$rollback_kind" in
    explicit|failed-update) ;;
    *) log "ERROR: invalid rollback kind"; return 1 ;;
  esac
  if [ ! -d "$APP_DIR.rollback" ]; then
    log "ERROR: no rollback available at $APP_DIR.rollback"; return 1
  fi
  log "Rolling back..."
  systemctl stop matrix-symphony matrix-gateway matrix-shell || true
  if [ -d "$APP_DIR" ]; then
    secure_staging_directory || return 1
    mv "$APP_DIR" "$STAGING_DIR/failed-$(date +%s)"
  fi
  mv "$APP_DIR.rollback" "$APP_DIR"
  restore_zellij_after_rollback
  if [ "$rollback_kind" = "failed-update" ]; then
    restore_terminal_runtime_after_failed_update
  else
    rm -rf -- "$TERMINAL_RUNTIME_FAILED_UPDATE_SNAPSHOT"
  fi
  chown -R matrix:matrix "$APP_DIR"
  systemctl start matrix-gateway matrix-shell
  systemctl start --no-block matrix-symphony || true
  local healthy=false
  for _ in $(seq 1 18); do
    if curl --fail --silent --max-time 5 "$HEALTH_URL" >/dev/null 2>&1; then
      healthy=true; break
    fi
    sleep 5
  done
  if [ "$healthy" = true ]; then
    log "Rollback complete (now at $(current_version))"
  else
    log "ERROR: rollback health check failed — services may be down"
    return 1
  fi
}

# Claims one root-published protocol request, unlinks it before execution, and
# emits only a validated operation tuple. The worker never accepts paths,
# URLs, units, commands, or environment values from this file.
claim_typed_request() {
  python3 - "$TYPED_REQUEST" "$INFLIGHT_REQUEST" <<'PY'
import json
import os
import re
import stat
import sys

path, inflight_path = sys.argv[1:3]
try:
    before = os.lstat(path)
    if (
        not stat.S_ISREG(before.st_mode)
        or before.st_uid != 0
        or stat.S_IMODE(before.st_mode) != 0o600
        or before.st_nlink != 1
        or before.st_size < 1
        or before.st_size > 128 * 1024
    ):
        raise ValueError("metadata")
    descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    try:
        after = os.fstat(descriptor)
        if (before.st_dev, before.st_ino) != (after.st_dev, after.st_ino):
            raise ValueError("replacement")
        payload = os.read(descriptor, 128 * 1024 + 1)
    finally:
        os.close(descriptor)
    request = json.loads(payload)
    if not isinstance(request, dict) or request.get("schemaVersion") != 1:
        raise ValueError("schema")
    operation = request.get("operation")
    if operation == "Apply":
        if set(request) != {"schemaVersion", "operation", "target"}:
            raise ValueError("fields")
        target = request.get("target")
        if not isinstance(target, dict) or set(target) != {"kind", "value"}:
            raise ValueError("target")
        kind = target.get("kind")
        value = target.get("value")
        if kind == "channel":
            if value not in {"stable", "canary", "beta", "dev"}:
                raise ValueError("channel")
        elif kind == "version":
            if not isinstance(value, str) or not re.fullmatch(
                r"(?:v[0-9]|main-[A-Za-z0-9])[A-Za-z0-9._-]{0,127}", value
            ):
                raise ValueError("version")
        else:
            raise ValueError("kind")
        output = f"Apply|{kind}|{value}"
    elif operation in {"Repair", "Rollback"}:
        if set(request) != {"schemaVersion", "operation"}:
            raise ValueError("fields")
        output = f"{operation}||"
    else:
        raise ValueError("operation")
    os.link(path, inflight_path, follow_symlinks=False)
    directory = os.open(os.path.dirname(path), os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(directory)
        os.unlink(path)
        os.fsync(directory)
    finally:
        os.close(directory)
    print(output)
except (FileNotFoundError, json.JSONDecodeError, OSError, TypeError, ValueError):
    raise SystemExit(1)
PY
}

claim_legacy_update_target() {
  python3 - "$LEGACY_UPDATE_VERSION_FILE" "$LEGACY_UPDATE_CHANNEL_FILE" <<'PY'
import os
import pwd
import re
import stat
import sys

matrix_uid = pwd.getpwnam("matrix").pw_uid
version_path, channel_path = sys.argv[1:3]

def read_owner_file(path):
    before = os.lstat(path)
    if (
        not stat.S_ISREG(before.st_mode)
        or before.st_uid != matrix_uid
        or before.st_nlink != 1
        or before.st_size < 1
        or before.st_size > 128
    ):
        raise ValueError("metadata")
    descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    try:
        after = os.fstat(descriptor)
        if (before.st_dev, before.st_ino) != (after.st_dev, after.st_ino):
            raise ValueError("replacement")
        return os.read(descriptor, 129).decode("utf-8")
    finally:
        os.close(descriptor)

try:
    if os.path.lexists(version_path):
        value = read_owner_file(version_path)
        if not re.fullmatch(r"(?:v[0-9]|main-[A-Za-z0-9])[A-Za-z0-9._-]{0,127}", value):
            raise ValueError("version")
        print(f"version|{value}")
    elif os.path.lexists(channel_path):
        value = read_owner_file(channel_path)
        if value not in {"stable", "canary", "beta", "dev"}:
            raise ValueError("channel")
        print(f"channel|{value}")
    else:
        print("|")
except (OSError, UnicodeDecodeError, ValueError):
    raise SystemExit(1)
finally:
    for path in (version_path, channel_path):
        try:
            os.unlink(path)
        except (FileNotFoundError, IsADirectoryError):
            pass
PY
}

process_legacy_update_request() {
  local parsed kind value result=0
  if ! parsed="$(claim_legacy_update_target)"; then
    log "WARN: legacy_update_request_invalid"
    return 1
  fi
  set_operation_state running
  IFS='|' read -r kind value <<<"$parsed"
  rm -f "$UPDATE_CHANNEL_FILE" "$UPDATE_VERSION_FILE"
  if [ "$kind" = "channel" ]; then
    printf '%s' "$value" >"$UPDATE_CHANNEL_FILE"
  elif [ "$kind" = "version" ]; then
    printf '%s' "$value" >"$UPDATE_VERSION_FILE"
  fi
  rm -f "$AUTO_APPLY_FAILED_MARKER"
  if prepare_triggered_update && apply_update; then
    rm -f "$UPDATE_CHANNEL_FILE" "$UPDATE_VERSION_FILE"
  else
    log "ERROR: legacy_update_failed"
    result=1
  fi
  set_operation_state idle
  return "$result"
}

process_typed_request() {
  local parsed operation kind value result=0
  if ! parsed="$(claim_typed_request)"; then
    log "WARN: update_request_invalid"
    rm -f -- "$TYPED_REQUEST" "$INFLIGHT_REQUEST"
    set_operation_state failed
    return 1
  fi
  set_operation_state running
  IFS='|' read -r operation kind value <<<"$parsed"
  case "$operation" in
    Apply)
      rm -f "$UPDATE_CHANNEL_FILE" "$UPDATE_VERSION_FILE"
      if [ "$kind" = "channel" ]; then
        printf '%s' "$value" >"$UPDATE_CHANNEL_FILE"
      else
        printf '%s' "$value" >"$UPDATE_VERSION_FILE"
      fi
      rm -f "$AUTO_APPLY_FAILED_MARKER"
      if prepare_triggered_update && apply_update; then
        rm -f "$UPDATE_CHANNEL_FILE" "$UPDATE_VERSION_FILE"
      else
        log "ERROR: typed_update_failed"
        result=1
      fi
      ;;
    Repair)
      perform_update_repair
      if prepare_triggered_update && apply_update; then
        rm -f "$UPDATE_CHANNEL_FILE" "$UPDATE_VERSION_FILE"
      else
        log "ERROR: typed_repair_failed"
        result=1
      fi
      ;;
    Rollback)
      do_rollback explicit || result=1
      ;;
    *)
      log "WARN: update_request_invalid"
      result=1
      ;;
  esac
  if [ "$result" -eq 0 ]; then
    rm -f -- "$INFLIGHT_REQUEST"
    set_operation_state idle
  else
    set_operation_state failed
    rm -f -- "$INFLIGHT_REQUEST"
  fi
  return "$result"
}

# ── Signal handling ──────────────────────────────────────────────────
update_requested=false
on_sigusr1() { update_requested=true; }
trap on_sigusr1 USR1

# ── Staging cleanup ──────────────────────────────────────────────────
clean_staging() {
  [ -d "$STAGING_DIR" ] || return 0
  local count=0 now cutoff path
  now="$(date +%s)"
  cutoff=$((now - STAGING_ARTIFACT_TTL_SECONDS))
  while IFS= read -r -d '' path; do
    [ -e "$path" ] || continue
    [ ! -L "$path" ] || continue
    if [ "$(stat -c %Y "$path" 2>/dev/null || echo "$now")" -gt "$cutoff" ]; then
      continue
    fi
    rm -rf -- "$path"
    count=$((count + 1))
  done < <(find "$STAGING_DIR" -mindepth 1 -maxdepth 1 \( -name 'failed-*' -o -name 'bundle-*' \) -print0)
  if [ "$count" -gt 0 ]; then
    log "Cleaned $count stale staging artifacts"
  fi
  return 0
}

clean_staging_now() {
  [ -d "$STAGING_DIR" ] || return 0
  local count=0 path
  while IFS= read -r -d '' path; do
    [ -e "$path" ] || continue
    [ ! -L "$path" ] || continue
    rm -rf -- "$path"
    count=$((count + 1))
  done < <(find "$STAGING_DIR" -mindepth 1 -maxdepth 1 \( -name 'failed-*' -o -name 'bundle-*' \) -print0)
  if [ "$count" -gt 0 ]; then
    log "Cleaned $count update staging artifacts"
  fi
  return 0
}

clean_legacy_upgrade_artifacts() {
  [ -d "$LEGACY_UPGRADE_DIR" ] || return 0
  local count=0 now cutoff path
  now="$(date +%s)"
  cutoff=$((now - LEGACY_UPGRADE_TTL_SECONDS))
  while IFS= read -r -d '' path; do
    [ -e "$path" ] || continue
    [ ! -L "$path" ] || continue
    if [ "$(stat -c %Y "$path" 2>/dev/null || echo "$now")" -gt "$cutoff" ]; then
      continue
    fi
    rm -f -- "$path"
    count=$((count + 1))
  done < <(find "$LEGACY_UPGRADE_DIR" -maxdepth 1 -type f \( -name 'matrix-host-bundle.tar.gz' -o -name 'matrix-host-bundle.tar.gz.sha256' \) -print0)
  if [ "$count" -gt 0 ]; then
    log "Cleaned $count stale legacy upgrade artifacts"
  fi
  return 0
}

required_update_free_kb() {
  local bundle_size_bytes="${1:-}"
  if [ -z "$bundle_size_bytes" ] || [[ "$bundle_size_bytes" == *[!0-9]* ]]; then
    echo $((UPDATE_FREE_BUFFER_KB + 5242880))
    return 0
  fi
  local bundle_kb
  bundle_kb=$(((bundle_size_bytes + 1023) / 1024))
  echo $((bundle_kb * UPDATE_EXPANSION_FACTOR + UPDATE_FREE_BUFFER_KB))
}

ensure_update_headroom() {
  local bundle_size_bytes="${1:-}" version="${2:-}"
  clean_staging || true
  clean_legacy_upgrade_artifacts || true

  local available required
  required="$(required_update_free_kb "$bundle_size_bytes")"
  available="$(df -Pk "$STAGING_DIR" | awk 'NR==2 {print $4}')"
  if [ -z "$available" ]; then
    log "WARN: could not determine free disk space before update"
    return 0
  fi
  if [ "$available" -lt "$required" ]; then
    log "ERROR: insufficient disk space for update (available: ${available}KB, required: ${required}KB)"
    write_update_error "insufficient_disk_space" "Not enough free disk space to install this update." "$version" "$available" "$required"
    return 1
  fi
  log "Update disk headroom OK (available: ${available}KB, required: ${required}KB)"
  return 0
}

clean_repairable_tmp_artifacts() {
  local staging_device tmp_device
  staging_device="$(df -Pk "$STAGING_DIR" 2>/dev/null | awk 'NR==2 {print $1}')"
  tmp_device="$(df -Pk /tmp 2>/dev/null | awk 'NR==2 {print $1}')"
  if [ -n "$staging_device" ] && [ -n "$tmp_device" ] && [ "$staging_device" != "$tmp_device" ]; then
    log "WARN: /tmp and update staging are on different filesystems; temp cleanup may not free update staging space"
  fi

  local count=0 path
  while IFS= read -r -d '' path; do
    [ -e "$path" ] || continue
    [ ! -L "$path" ] || continue
    rm -f -- "$path"
    count=$((count + 1))
  done < <(find /tmp -xdev -user matrix -type f -mtime +1 \( -name '*.so' -o -path '/tmp/node-compile-cache/*' \) -print0)
  if [ "$count" -gt 0 ]; then
    log "Cleaned $count stale Matrix-owned temp files"
  fi
  return 0
}

set_operation_state() {
  local state="$1" temporary
  case "$state" in
    failed|idle|running) ;;
    *) return 1 ;;
  esac
  temporary="$(mktemp --tmpdir="$UPDATE_RUNTIME_DIR" .operation-state.XXXXXXXXXX)"
  (umask 077; printf '%s' "$state" >"$temporary")
  mv -f -- "$temporary" "$OPERATION_STATE"
}

perform_update_repair() {
  log "Starting safe update repair cleanup"
  clean_staging_now || true
  clean_legacy_upgrade_artifacts || true
  clean_repairable_tmp_artifacts || true
  rm -f "$UPDATE_ERROR_MARKER"
  log "Repair complete; retrying pending update"
}

last_staging_cleanup=0

maybe_clean_staging() {
  local now
  now="$(date +%s)"
  if [ $((now - last_staging_cleanup)) -lt "$STAGING_CLEANUP_INTERVAL_SECONDS" ]; then
    return 0
  fi
  last_staging_cleanup="$now"
  clean_staging || true
}

# ── Main loop ────────────────────────────────────────────────────────
log "Started for ${MATRIX_MACHINE_ID} (version: $(current_version))"
if [ -x "$BIN_DIR/matrix-ensure-swap" ]; then
  "$BIN_DIR/matrix-ensure-swap" || log "WARN: swap ensure failed (non-fatal)"
fi
secure_staging_directory || exit 1
clean_staging
clean_legacy_upgrade_artifacts || true
last_staging_cleanup="$(date +%s)"

while true; do
  # React to trigger files and signals
  if [ -f "$TYPED_REQUEST" ]; then
    update_requested=false
    process_typed_request || true
  fi
  if [ -e "$LEGACY_UPDATE_TRIGGER" ] || [ -L "$LEGACY_UPDATE_TRIGGER" ]; then
    rm -f -- "$LEGACY_UPDATE_TRIGGER"
    process_legacy_update_request || true
  fi
  if [ -e "$LEGACY_ROLLBACK_TRIGGER" ] || [ -L "$LEGACY_ROLLBACK_TRIGGER" ]; then
    rm -f -- "$LEGACY_ROLLBACK_TRIGGER"
    do_rollback explicit || log "Rollback failed"
  fi
  if [ -e "$LEGACY_UPDATE_REPAIR_TRIGGER" ] || [ -L "$LEGACY_UPDATE_REPAIR_TRIGGER" ]; then
    rm -f -- "$LEGACY_UPDATE_REPAIR_TRIGGER"
    perform_update_repair
    if prepare_triggered_update; then
      if apply_update; then
        rm -f "$UPDATE_CHANNEL_FILE" "$UPDATE_VERSION_FILE"
      else
        log "Update repair retry failed — will retry on next trigger"
      fi
    else
      log "Requested release metadata fetch failed after repair — skipping apply"
      rm -f "$UPDATE_MARKER"
    fi
  fi
  if [ "$update_requested" = true ]; then
    update_requested=false
    process_typed_request || true
  fi

  # Poll for new version
  check_for_update || true
  maybe_clean_staging

  # Sleep in 6s increments (50x = 5 min) so we react quickly to triggers
  for _ in $(seq 1 50); do
    sleep 6
    if [ -e "$LEGACY_UPDATE_TRIGGER" ] || [ -L "$LEGACY_UPDATE_TRIGGER" ] ||
      [ -e "$LEGACY_ROLLBACK_TRIGGER" ] || [ -L "$LEGACY_ROLLBACK_TRIGGER" ] ||
      [ -e "$LEGACY_UPDATE_REPAIR_TRIGGER" ] || [ -L "$LEGACY_UPDATE_REPAIR_TRIGGER" ] ||
      [ -f "$TYPED_REQUEST" ] || [ "$update_requested" = true ]; then
      break
    fi
  done
done
