#!/usr/bin/env bash
set -euo pipefail

# Isolated from the sync agent: return success only for explicit platform consent.
# No credentials in logs, redirects, temporary files, or unbounded response buffers.
if [[ ! "${MATRIX_MACHINE_ID:-}" =~ ^[A-Za-z0-9_-]{1,128}$ ]] \
  || [ -z "${PLATFORM_INTERNAL_URL:-}" ] || [ -z "${UPGRADE_TOKEN:-}" ]; then
  echo 'matrix-sync-agent: passive update policy configuration unavailable' >&2
  exit 1
fi
if ! decision="$(curl --fail --silent --max-time 10 --max-filesize 4096 \
  --proto '=http,https' --header "Authorization: Bearer $UPGRADE_TOKEN" \
  "${PLATFORM_INTERNAL_URL%/}/backend-management/machines/$MATRIX_MACHINE_ID/policy" \
  | python3 -c '
import json
import sys
try:
    payload = sys.stdin.buffer.read(4097)
    if len(payload) > 4096:
        raise ValueError("oversized policy")
    policy = json.loads(payload)
    if not isinstance(policy, dict) or type(policy.get("passiveUpdatesAllowed")) is not bool:
        raise ValueError("invalid policy")
    print("allow" if policy["passiveUpdatesAllowed"] else "managed")
except (ValueError, UnicodeError):
    sys.exit(1)
')"; then
  echo 'matrix-sync-agent: passive update policy unavailable; deferring this poll' >&2
  exit 1
fi
[ "$decision" = allow ]
