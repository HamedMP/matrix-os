#!/usr/bin/env bash
set -euo pipefail

source /opt/matrix/env/host.env
if [ -r /opt/matrix/bin/matrix-owner-env ]; then
  source /opt/matrix/bin/matrix-owner-env
fi

NODE_BIN="${MATRIX_NODE_BIN:-/opt/matrix/runtime/node/bin/node}"
APP_DIR="${MATRIX_APP_DIR:-/opt/matrix/app}"
export NODE_ENV="${NODE_ENV:-production}"
export MATRIX_HOME="${MATRIX_HOME:-/home/matrix/home}"
export MATRIX_TERMINAL_RUNTIME_SOCKET="${MATRIX_TERMINAL_RUNTIME_SOCKET:-/run/matrix/terminal-runtime.sock}"
export MATRIX_ZELLIJ_BIN="${MATRIX_ZELLIJ_BIN:-/opt/matrix/bin/zellij}"
if declare -F matrix_export_owner_env >/dev/null 2>&1; then
  matrix_export_owner_env
else
  export HOME="$MATRIX_HOME"
fi

cd "$APP_DIR"
if [ -f "$APP_DIR/packages/terminal-runtime/dist/service.js" ]; then
  exec "$NODE_BIN" "$APP_DIR/packages/terminal-runtime/dist/service.js" "$@"
fi
exec "$NODE_BIN" --import=tsx "$APP_DIR/packages/terminal-runtime/src/service.ts" "$@"
