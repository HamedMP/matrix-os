#!/usr/bin/env bash

# Recovery and rollback functions for matrix-sync-agent.
#
# This file is sourced by the agent after its update primitives are defined. It
# deliberately owns no process lifecycle or mutable globals of its own.

resume_update_transaction_services() {
  local name state
  while IFS=: read -r name state; do
    [ -n "$name" ] || continue
    [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._@-]{0,127}$ ]] || return 1
    update_payload_name_was_added "$name" && continue
    case "$state" in
      active) [ "$name" = matrix-sync-agent.service ] || sudo systemctl start "$name" >/dev/null || return 1 ;;
      inactive) ;;
      *) return 1 ;;
    esac
  done <"$UPDATE_TRANSACTION_DIR/systemd.activity"
}

release_metadata_matches_app() {
  local app_dir="$1" release_file="$2" expected_version actual_version
  [ -d "$app_dir" ] && [ ! -L "$app_dir" ] || return 1
  [ -f "$app_dir/BUNDLE_VERSION" ] && [ ! -L "$app_dir/BUNDLE_VERSION" ] || return 1
  [ -f "$release_file" ] && [ ! -L "$release_file" ] || return 1
  IFS= read -r expected_version <"$app_dir/BUNDLE_VERSION" || return 1
  [[ "$expected_version" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] || return 1
  actual_version="$(python3 - "$release_file" <<'PY'
import json
import os
import stat
import sys

fd = os.open(sys.argv[1], os.O_RDONLY | os.O_NOFOLLOW)
try:
    metadata = os.fstat(fd)
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_size < 2 or metadata.st_size > 65536:
        raise ValueError("invalid rollback release metadata")
    payload = os.read(fd, 65537)
    if len(payload) > 65536:
        raise ValueError("oversized rollback release metadata")
    version = json.loads(payload).get("version")
    if not isinstance(version, str):
        raise ValueError("missing rollback release version")
    print(version)
finally:
    os.close(fd)
PY
  )" || return 1
  [ "$actual_version" = "$expected_version" ]
}

rollback_release_metadata_is_ready() {
  release_metadata_matches_app "$1" "$RELEASE_ROLLBACK_FILE"
}

restore_retired_symphony_after_rollback() {
  [ -x "$APP_DIR/packages/symphony-elixir/release/bin/symphony" ] || return 0
  [ -e "$RETIRED_SYMPHONY_ROLLBACK_DIR" ] || return 0
  [ -d "$RETIRED_SYMPHONY_ROLLBACK_DIR" ] && [ ! -L "$RETIRED_SYMPHONY_ROLLBACK_DIR" ] || return 1
  local unit="$RETIRED_SYMPHONY_ROLLBACK_DIR/unit" masked="$RETIRED_SYMPHONY_ROLLBACK_DIR/masked"
  local enabled_file="$RETIRED_SYMPHONY_ROLLBACK_DIR/enablement"
  local activity_file="$RETIRED_SYMPHONY_ROLLBACK_DIR/activity" enabled_state activity_state file
  if [ -f "$masked" ] && [ ! -L "$masked" ]; then
    [ ! -e "$unit" ] && [ ! -L "$unit" ] || return 1
  else
    [ -f "$unit" ] && [ ! -L "$unit" ] || return 1
  fi
  for file in "$enabled_file" "$activity_file"; do
    [ -f "$file" ] && [ ! -L "$file" ] || return 1
  done
  enabled_state="$(sed -n 's/^matrix-symphony.service://p' "$enabled_file")"
  activity_state="$(sed -n 's/^matrix-symphony.service://p' "$activity_file")"
  case "$enabled_state" in
    enabled|enabled-runtime|disabled|masked|masked-runtime|static|indirect|generated|transient) ;;
    *) return 1 ;;
  esac
  case "$activity_state" in active|inactive) ;; *) return 1 ;; esac
  if [ -f "$masked" ]; then
    [ "$enabled_state" = masked ] && [ "$activity_state" = inactive ] || return 1
    sudo rm -f -- /etc/systemd/system/matrix-symphony.service || return 1
    sudo systemctl mask matrix-symphony.service >/dev/null || return 1
  else
    restore_regular_file_atomic "$unit" /etc/systemd/system/matrix-symphony.service || return 1
  fi
  sudo systemctl daemon-reload || return 1
  case "$enabled_state" in
    enabled) sudo systemctl unmask matrix-symphony.service >/dev/null 2>&1 || true; sudo systemctl enable matrix-symphony.service >/dev/null || return 1 ;;
    enabled-runtime) sudo systemctl unmask matrix-symphony.service >/dev/null 2>&1 || true; sudo systemctl enable --runtime matrix-symphony.service >/dev/null || return 1 ;;
    disabled) sudo systemctl unmask matrix-symphony.service >/dev/null 2>&1 || true; sudo systemctl disable matrix-symphony.service >/dev/null || return 1 ;;
    masked) [ -f "$masked" ] || sudo systemctl mask matrix-symphony.service >/dev/null || return 1 ;;
    masked-runtime) sudo systemctl mask --runtime matrix-symphony.service >/dev/null || return 1 ;;
    static|indirect|generated|transient) ;;
  esac
  if [ "$activity_state" = active ]; then
    sudo systemctl start matrix-symphony.service || return 1
  else
    sudo systemctl stop matrix-symphony.service || return 1
  fi
}

clear_retired_symphony_rollback_after_rollback() {
  [ -x "$APP_DIR/packages/symphony-elixir/release/bin/symphony" ] || return 0
  if [ ! -e "$RETIRED_SYMPHONY_ROLLBACK_DIR" ] && [ ! -L "$RETIRED_SYMPHONY_ROLLBACK_DIR" ]; then
    return 0
  fi
  [ -d "$RETIRED_SYMPHONY_ROLLBACK_DIR" ] && [ ! -L "$RETIRED_SYMPHONY_ROLLBACK_DIR" ] || return 1
  sudo rm -rf -- "$RETIRED_SYMPHONY_ROLLBACK_DIR"
}

recover_interrupted_update() {
  local phase version="" transaction_state=""
  [ -f "$UPDATE_PHASE_MARKER" ] && [ ! -L "$UPDATE_PHASE_MARKER" ] || return 0
  phase="$(cat "$UPDATE_PHASE_MARKER" 2>/dev/null || true)"
  case "$phase" in
    prepare|download|verify|extract|terminal-runtime|app-install|host-bin|health) ;;
    *) phase=unknown ;;
  esac
  if [ -f "$UPDATE_TRANSACTION_STATE" ] && [ ! -L "$UPDATE_TRANSACTION_STATE" ]; then
    transaction_state="$(cat "$UPDATE_TRANSACTION_STATE" 2>/dev/null || true)"
    case "$transaction_state" in
      prepared|mutating)
        log "Recovering interrupted update transaction"
        if [ -f "$UPDATE_TRANSACTION_DIR/candidate-version" ] && [ ! -L "$UPDATE_TRANSACTION_DIR/candidate-version" ]; then
          IFS= read -r version <"$UPDATE_TRANSACTION_DIR/candidate-version" || version=""
          [[ "$version" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] || version=""
        fi
        if transaction_candidate_is_committed "$version"; then
          log "Interrupted update had already committed; finalizing transaction"
          clear_consumed_update_markers
          preserve_host_rollback_transaction
          rm -f -- "$UPDATE_PHASE_MARKER"
          return 0
        fi
        if do_rollback false; then
          write_update_error "apply_interrupted" "The interrupted update was rolled back to the previous runtime." "$version"
        else
          write_update_error "post_install_rollback_failed" "The interrupted update could not be rolled back completely." "$version"
        fi
        return 0
        ;;
      *)
        log "ERROR: update transaction state is invalid"
        return 1
        ;;
    esac
  fi
  [ -f "$UPDATE_MARKER" ] && [ ! -L "$UPDATE_MARKER" ] || {
    case "$phase" in
      host-bin|health)
        version="$(current_version)"
        [[ "$version" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] || version=""
        if [ -d "$APP_DIR.rollback" ] && [ ! -L "$APP_DIR.rollback" ]; then
          if release_metadata_matches_app "$APP_DIR.rollback" "$RELEASE_FILE"; then
            log "Recovering update interrupted after a legacy updater replaced the app"
            if do_rollback false; then
              write_update_error "apply_interrupted" "The interrupted update was rolled back to the previous runtime." "$version"
            else
              write_update_error "post_install_rollback_failed" "The interrupted update could not be rolled back completely." "$version"
            fi
          else
            log "ERROR: interrupted legacy update metadata does not identify the rollback app"
            write_update_error "post_install_rollback_failed" "The interrupted update could not be rolled back completely." "$version"
          fi
          return 0
        fi
        ;;
    esac
    rm -f -- "$UPDATE_PHASE_MARKER"
    return 0
  }
  [ ! -e "$UPDATE_ERROR_MARKER" ] && [ ! -L "$UPDATE_ERROR_MARKER" ] || return 0
  version="$(json_field "$(cat "$UPDATE_MARKER")" version 2>/dev/null || true)"
  log "ERROR: interrupted update recovered at bounded phase $phase"
  write_update_error "apply_interrupted" "The update process was interrupted before completion." "$version"
}

do_rollback() {
  local restore_release_metadata="${1:-true}" has_app_rollback=false funded_target="" failed_dir
  if sudo /usr/bin/test -f /var/lib/matrix-funded-host-config/applied.json; then
    # Check the original argument, before legacy metadata fallback can change it.
    # The protected proof admits only an actual uncommitted candidate restoring
    # the committed config owner, never a manual downgrade or field rollback.
    if [ "$restore_release_metadata" != false ] \
      || ! funded_target="$(funded_host_bootstrap recovery-check)"; then
      log "ERROR: guarded funded configuration rollback and independent readback are required first"
      return 1
    fi
    case "$funded_target" in current|rollback) ;; *) return 1 ;; esac
  fi
  if [ "$funded_target" = current ]; then
    : # Pre-swap failure or an interrupted recovery already restored the app.
  elif [ -d "$APP_DIR.rollback" ] && [ ! -L "$APP_DIR.rollback" ]; then
    has_app_rollback=true
  elif [ ! -f "$UPDATE_TRANSACTION_STATE" ] || [ -L "$UPDATE_TRANSACTION_STATE" ]; then
    log "ERROR: no rollback app or update transaction is available"; return 1
  fi
  if [ "$has_app_rollback" = true ]; then
    if [ "$restore_release_metadata" = true ]; then
      if rollback_release_metadata_is_ready "$APP_DIR.rollback"; then
        :
      elif release_metadata_matches_app "$APP_DIR.rollback" "$RELEASE_FILE"; then
        log "Installed release metadata already identifies the rollback app"
        restore_release_metadata=false
      else
        log "ERROR: rollback release metadata is unavailable or inconsistent"
        return 1
      fi
    elif ! release_metadata_matches_app "$APP_DIR.rollback" "$RELEASE_FILE"; then
      log "ERROR: installed release metadata does not identify the rollback app"
      return 1
    fi
  fi
  log "Rolling back..."
  if ! stop_runtime_services; then
    log "ERROR: rollback could not stop the runtime services safely"
    return 1
  fi
  if [ "$has_app_rollback" = true ] \
    && [ -f "$APP_DIR/$TERMINAL_RUNTIME_GENERATION_FILE" ] \
    && [ ! -f "$APP_DIR.rollback/$TERMINAL_RUNTIME_GENERATION_FILE" ] \
    && [ -f "/home/matrix/home/system/terminal-migration-journal.json" ]; then
    if ! /opt/matrix/bin/matrix-terminal-runtime --rollback; then
      log "ERROR: terminal migration rollback failed while candidate code was available"
      return 1
    fi
  fi
  if [ "$has_app_rollback" = true ] && [ -d "$APP_DIR" ]; then
    sudo mkdir -p "$STAGING_DIR" || return 1
    sudo chown matrix:matrix "$STAGING_DIR" || return 1
    failed_dir="$(mktemp -d "$STAGING_DIR/failed-XXXXXXXX")" || return 1
    sudo mv "$APP_DIR" "$failed_dir/app" || return 1
  fi
  if [ "$has_app_rollback" = true ]; then
    sudo mv "$APP_DIR.rollback" "$APP_DIR" || return 1
    sudo chown -R matrix:matrix "$APP_DIR" || return 1
  fi
  if [ "$restore_release_metadata" = true ] && [ "$has_app_rollback" = true ]; then
    restore_rollback_release_metadata || {
      log "ERROR: rollback release metadata restore failed"
      return 1
    }
  fi
  restore_update_transaction "${funded_target:+defer-services}" || {
    log "ERROR: update transaction artifact restore failed"
    return 1
  }
  if [ -n "$funded_target" ] && ! funded_host_bootstrap recovery-preflight >/dev/null; then
    log "ERROR: restored funded runtime could not be verified; retaining recovery evidence"
    return 1
  fi
  if [ -n "$funded_target" ]; then
    resume_update_transaction_services || return 1
  fi
  if [ -f "$APP_DIR/$TERMINAL_RUNTIME_GENERATION_FILE" ]; then
    activate_terminal_runtime_generation "$(cat "$APP_DIR/$TERMINAL_RUNTIME_GENERATION_FILE")"
  fi
  cleanup_terminal_runtime_generations || log "WARN: terminal generation cleanup remains above cap after rollback"
  if [ -f "$APP_DIR/$TERMINAL_RUNTIME_GENERATION_FILE" ]; then
    sudo systemctl start matrix-terminal-runtime || return 1
  else
    sudo systemctl start matrix-terminal-runtime || true
  fi
  sudo systemctl start matrix-gateway matrix-shell || return 1
  resume_symphony_after_update || return 1
  restore_retired_symphony_after_rollback || {
    log "ERROR: retired Symphony service state could not be restored"
    return 1
  }
  local healthy=false
  for _ in $(seq 1 18); do
    if curl --fail --silent --max-time 5 "$HEALTH_URL" >/dev/null 2>&1; then
      healthy=true; break
    fi
    sleep 5
  done
  if [ "$healthy" = true ]; then
    cleanup_update_transaction
    clear_retired_symphony_rollback_after_rollback || return 1
    log "Rollback complete (now at $(current_version))"
  else
    log "ERROR: rollback health check failed — services may be down"
    return 1
  fi
}

# Fixed transaction sealing and commit classification shared by updater recovery.
same_version_repair_archive_proof() {
  local path="$1" completed_version="${2:-}"
  case "$path" in "$STAGING_DIR"/bundle-*.tar.gz) ;; *) return 1 ;; esac
  [ -f "$UPDATE_TRANSACTION_DIR/same-version-repair.json" ] || { [ -f "$UPDATE_PHASE_MARKER" ] \
    && sudo /usr/bin/test -f /var/lib/matrix-funded-host-config/applied.json; } || return 1
  # Retain only one known archive; validate the root-sealed bounded pin without
  # hashing or importing mutable app code. Other staging TTL/cleanup stays live.
  sudo /usr/bin/timeout --signal=KILL 10 /usr/bin/python3 -I - "$path" "$completed_version" <<'PY_RETAIN_REPAIR'
import hashlib
import fcntl
import grp
import json
import os
import pwd
import re
import stat
import sys

fds = []
try:
    path = '/opt/matrix/staging/update-transaction'
    anchors = []
    def directory(parts, writable=False):
        parent = os.open('/', os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        fds.append(parent)
        for part in parts:
            fd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
            fds.append(fd)
            value = os.fstat(fd)
            matrix_gid = grp.getgrnam('matrix').gr_gid
            allowed = writable and part in ('matrix', 'staging')
            if (allowed and (value.st_uid not in ((0, pwd.getpwnam('matrix').pw_uid) if part == 'staging' else (0,)) or value.st_gid not in (0, matrix_gid) or value.st_mode & 0o002)) or (not allowed and (value.st_uid != 0 or value.st_gid != 0 or value.st_mode & 0o022)):
                raise ValueError('unsealed')
            anchors.append((parent, part, fd))
            parent = fd
        return parent
    transaction = directory(('opt', 'matrix', 'staging', 'update-transaction'), True)
    info = os.fstat(transaction)
    if info.st_uid != 0 or info.st_gid != 0 or info.st_mode & 0o022:
        raise ValueError('unsealed')
    def read(name, limit, parent=transaction, gids=(0,)):
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=parent)
        fds.append(fd)
        value = os.fstat(fd)
        if not stat.S_ISREG(value.st_mode) or value.st_uid != 0 or value.st_gid not in gids or value.st_mode & 0o022 or value.st_nlink != 1 or value.st_size > limit:
            raise ValueError('invalid')
        data = os.read(fd, limit + 1)
        after = os.fstat(fd)
        live = os.stat(name, dir_fd=parent, follow_symlinks=False)
        if len(data) != value.st_size or len(data) > limit or (value.st_dev, value.st_ino, value.st_size, value.st_mtime_ns, value.st_ctime_ns) != (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns, after.st_ctime_ns) or (after.st_dev, after.st_ino) != (live.st_dev, live.st_ino):
            raise ValueError('changed')
        return data
    if read('state', 64) not in (b'prepared\n', b'mutating\n'):
        raise ValueError('inactive')
    def unique_object(pairs):
        value = {}
        for key, item in pairs:
            if key in value:
                raise ValueError('duplicate')
            value[key] = item
        return value
    def verify_anchors():
        for parent, name, fd in anchors:
            held, live = os.fstat(fd), os.stat(name, dir_fd=parent, follow_symlinks=False)
            if (held.st_dev, held.st_ino) != (live.st_dev, live.st_ino):
                raise ValueError('changed')
    def retain_ambiguous_candidate():
        # Interrupted/damaged retirement evidence grants retention only, never
        # commit/recovery/apply authority, for this one sealed candidate.
        candidate = read('candidate-version', 129).decode().rstrip('\n')
        if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]{0,127}', candidate) or sys.argv[1] != '/opt/matrix/staging/bundle-' + candidate + '.tar.gz':
            raise ValueError('invalid')
        state = directory(('var', 'lib', 'matrix-funded-host-config'))
        applied = json.loads(read('applied.json', 131072, state), object_pairs_hook=unique_object)
        if set(applied) != {'rolloutId', 'identity', 'afterSha256'} or not isinstance(applied['identity'], dict) or not re.fullmatch(r'repair-[a-f0-9]{32}', applied['rolloutId']) or not re.fullmatch(r'[a-f0-9]{64}', applied['afterSha256']):
            raise ValueError('invalid')
        phase = os.open('update-phase', os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=anchors[2][2])
        fds.append(phase)
        pinfo = os.fstat(phase)
        if not stat.S_ISREG(pinfo.st_mode) or pinfo.st_nlink != 1 or pinfo.st_uid not in (0, pwd.getpwnam('matrix').pw_uid) or pinfo.st_mode & 0o022 or pinfo.st_size > 64 or os.read(phase, 65) != b'health\n':
            raise ValueError('invalid')
        archive = os.stat('bundle-' + candidate + '.tar.gz', dir_fd=anchors[2][2], follow_symlinks=False)
        if not stat.S_ISREG(archive.st_mode) or archive.st_nlink != 1 or not 0 < archive.st_size <= 2 * 1024 ** 3:
            raise ValueError('invalid')
        verify_anchors()
    if not sys.argv[2] and not os.path.lexists(path + '/same-version-repair.json'):
        retain_ambiguous_candidate()
        sys.exit(0)
    pin_bytes = read('same-version-repair.json', 4096)
    pin = json.loads(pin_bytes, object_pairs_hook=unique_object)
    if set(pin) != {'kind', 'contractVersion', 'receipt', 'appDevice', 'appInode'} or pin['kind'] != 'matrix-same-version-artifact-repair' or type(pin['contractVersion']) is not int or pin['contractVersion'] != 1:
        raise ValueError('invalid')
    receipt = pin['receipt']
    if set(receipt) != {'version', 'sourceSha', 'archiveSha256', 'componentSha256', 'unitSha256'} or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]{0,127}', receipt['version']) or not re.fullmatch(r'[a-f0-9]{40}', receipt['sourceSha']) or not all(re.fullmatch(r'[a-f0-9]{64}', receipt[k]) for k in ('archiveSha256', 'componentSha256', 'unitSha256')):
        raise ValueError('invalid')
    if type(pin['appDevice']) is not int or not 0 <= pin['appDevice'] < 2 ** 64 or type(pin['appInode']) is not int or not 0 < pin['appInode'] < 2 ** 64:
        raise ValueError('invalid')
    if read('candidate-version', 129) != (receipt['version'] + '\n').encode() or sys.argv[1] != '/opt/matrix/staging/bundle-' + receipt['version'] + '.tar.gz':
        raise ValueError('invalid')
    archive = os.stat(sys.argv[1], follow_symlinks=False)
    after = os.stat(path, follow_symlinks=False)
    if not stat.S_ISREG(archive.st_mode) or archive.st_nlink != 1 or not 0 < archive.st_size <= 2 * 1024 ** 3 or (info.st_dev, info.st_ino) != (after.st_dev, after.st_ino):
        raise ValueError('invalid')
    if sys.argv[2]:
        # Completion is derived from fixed committed artifacts, never a caller
        # boolean. All previous app/transaction backups stay available.
        if sys.argv[2] != receipt['version']:
            raise ValueError('mismatch')
        matrix = anchors[1][2]
        current = json.loads(read('release.json', 65536, matrix, (0, grp.getgrnam('matrix').gr_gid)), object_pairs_hook=unique_object)
        saved = json.loads(read('release-metadata', 65536), object_pairs_hook=unique_object)
        state = directory(('var', 'lib', 'matrix-funded-host-config'))
        read('install.lock', 128, state)
        fcntl.flock(fds[-1], fcntl.LOCK_SH | fcntl.LOCK_NB)
        if current.get('version') != receipt['version'] or current.get('gitCommit') != receipt['sourceSha'] or saved.get('version') != receipt['version'] or saved.get('gitCommit') != receipt['sourceSha'] or json.loads(read('receipt.json', 65536, state), object_pairs_hook=unique_object) != receipt:
            raise ValueError('mismatch')
        for parts, name, key in ((('usr', 'local', 'libexec'), 'matrix-funded-host-config.py', 'componentSha256'), (('etc', 'systemd', 'system'), 'matrix-funded-host-config.service', 'unitSha256')):
            if hashlib.sha256(read(name, 2 * 1024 ** 2, directory(parts))).hexdigest() != receipt[key]:
                raise ValueError('mismatch')
        app = os.open('app', os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=matrix)
        fds.append(app)
        version_fd = os.open('BUNDLE_VERSION', os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=app)
        fds.append(version_fd)
        version_info = os.fstat(version_fd)
        old = os.stat('app.rollback', dir_fd=matrix, follow_symlinks=False)
        installed = os.fstat(app)
        if not stat.S_ISREG(version_info.st_mode) or version_info.st_nlink != 1 or version_info.st_size > 129 or os.read(version_fd, 130) != (receipt['version'] + '\n').encode() or not stat.S_ISDIR(old.st_mode) or (old.st_dev, old.st_ino) != (pin['appDevice'], pin['appInode']) or (installed.st_dev, installed.st_ino) == (old.st_dev, old.st_ino):
            raise ValueError('mismatch')
        anchors.append((matrix, 'app', app))
        verify_anchors()
        if read('same-version-repair.json', 4096) != pin_bytes:
            raise ValueError('changed')
        os.fsync(transaction)
        os.unlink('same-version-repair.json', dir_fd=transaction)
        try:
            os.fsync(transaction)
        except OSError:
            # Retain the pin on an uncertain durable cleanup; phase stays active.
            fd = os.open('same-version-repair.json', os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644, dir_fd=transaction)
            fds.append(fd)
            os.fchmod(fd, 0o644)
            os.write(fd, pin_bytes)
            os.fsync(fd)
            raise
except (OSError, ValueError, KeyError, TypeError):
    if not sys.argv[2] and 'retain_ambiguous_candidate' in locals():
        try:
            retain_ambiguous_candidate()
            sys.exit(0)
        except (OSError, ValueError, KeyError, TypeError):
            print('WARN: sealed candidate retention unavailable', file=sys.stderr)
    print('WARN: staged repair retention unavailable', file=sys.stderr)
    sys.exit(1)
finally:
    for fd in reversed(fds):
        os.close(fd)
PY_RETAIN_REPAIR
}

pending_same_version_repair_archive() {
  same_version_repair_archive_proof "$1"
}

retire_completed_same_version_repair() {
  [ -e "$UPDATE_TRANSACTION_DIR/same-version-repair.json" ] || [ -L "$UPDATE_TRANSACTION_DIR/same-version-repair.json" ] || return 0
  same_version_repair_archive_proof "$STAGING_DIR/bundle-$1.tar.gz" "$1"
}

cleanup_staged_update_artifacts() {
  local extracted="$1" archive="$2"
  rm -rf -- "$extracted" || return 1
  if pending_same_version_repair_archive "$archive"; then
    log "Retaining staged archive for unresolved protected repair"
  else
    rm -f -- "$archive"
  fi
}

seal_update_transaction() {
  [ "$(cat "$UPDATE_TRANSACTION_STATE" 2>/dev/null || true)" = prepared ] || return 1
  write_update_transaction_state mutating || return 1
  sudo chown -R root:root "$UPDATE_TRANSACTION_DIR" || return 1
  sudo chmod -R go-w "$UPDATE_TRANSACTION_DIR" || return 1
  if sudo /usr/bin/test -f /var/lib/matrix-funded-host-config/applied.json \
    && [ "$version" = "$(current_version)" ]; then
    # Only an explicit immutable same-version reinstall gets this authority.
    [ "${trigger_source:-passive}" = explicit ] || return 1
    sudo /usr/bin/timeout --signal=KILL 10 /usr/bin/python3 -I - <<'PY_ARTIFACT_REPAIR' || return 1
import json
import os
import stat
import sys

fds = []
try:
    def read(path, limit, root=True):
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        fds.append(fd)
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_size > limit or (root and (info.st_uid != 0 or info.st_mode & 0o022)):
            raise ValueError('deferred')
        return os.read(fd, limit + 1)
    receipt = json.loads(read('/var/lib/matrix-funded-host-config/receipt.json', 65536))
    candidate = read('/opt/matrix/staging/update-transaction/candidate-version', 129).decode().strip()
    current = json.loads(read('/opt/matrix/release.json', 65536))
    if candidate != receipt['version'] or current.get('version') != candidate or current.get('gitCommit') != receipt['sourceSha']:
        raise ValueError('deferred')
    app = os.open('/opt/matrix/app', os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    fds.append(app)
    app_info = os.fstat(app)
    path = '/opt/matrix/staging/update-transaction'
    transaction = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    fds.append(transaction)
    info = os.fstat(transaction)
    if info.st_uid != 0 or info.st_gid != 0 or info.st_mode & 0o022:
        raise ValueError('deferred')
    pin = {'kind': 'matrix-same-version-artifact-repair', 'contractVersion': 1, 'receipt': receipt,
           'appDevice': app_info.st_dev, 'appInode': app_info.st_ino}
    fd = os.open('same-version-repair.json', os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644, dir_fd=transaction)
    fds.append(fd)
    os.fchmod(fd, 0o644)
    data = json.dumps(pin, separators=(',', ':')).encode()
    if len(data) > 4096 or os.write(fd, data) != len(data):
        raise ValueError('deferred')
    os.fsync(fd)
    os.fsync(transaction)
    after = os.stat(path, follow_symlinks=False)
    if (after.st_dev, after.st_ino) != (info.st_dev, info.st_ino):
        raise ValueError('deferred')
except Exception:
    print('ERROR: same-version artifact repair proof deferred', file=sys.stderr)
    sys.exit(1)
finally:
    for fd in reversed(fds):
        os.close(fd)
PY_ARTIFACT_REPAIR
  fi
}

transaction_candidate_is_committed() {
  local expected_version="$1" release_version
  [ -n "$expected_version" ] || return 1
  [ "$(current_version)" = "$expected_version" ] || return 1
  [ -f "$RELEASE_FILE" ] && [ ! -L "$RELEASE_FILE" ] || return 1
  release_version="$(json_field "$(cat "$RELEASE_FILE")" version 2>/dev/null || true)"
  [ "$release_version" = "$expected_version" ] || return 1
  # Matching versions do not prove completion of an active same-version repair.
  # Normal success clears update-phase; a remaining phase requires guarded
  # recovery even if commit_release_metadata happened just before interruption.
  if sudo /usr/bin/test -f /var/lib/matrix-funded-host-config/applied.json; then
    local saved_version
    [ -f "$UPDATE_TRANSACTION_DIR/release-metadata" ] && [ ! -L "$UPDATE_TRANSACTION_DIR/release-metadata" ] || return 1
    saved_version="$(json_field "$(head -c 65537 "$UPDATE_TRANSACTION_DIR/release-metadata")" version 2>/dev/null)" || return 1
    [ -n "$saved_version" ] && [ "$saved_version" != "$expected_version" ] || return 1
  fi
  return 0
}
