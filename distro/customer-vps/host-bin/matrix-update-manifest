#!/usr/bin/env bash
# Platform-verified metadata; owner markers carry only a bounded version request.
fetch_manifest() {
  local url="$1" response status
  if response="$(curl --fail --silent --show-error --max-time 15 --max-filesize 65536 \
    --write-out '\n%{http_code}' "$url" 2>/dev/null)"; then
    printf '%s' "${response%$'\n'*}"
    return 0
  fi
  status="${response##*$'\n'}"
  log "WARN: failed to fetch release metadata"
  case "$status" in 404|410) return 2 ;; *) return 1 ;; esac
}

load_trusted_apply_manifest() {
  local version manifest
  # The marker is owner-writable. Its only authority is the requested version;
  # even that is read without following a symlink and bounded before URL use.
  if ! version="$(python3 - "$UPDATE_MARKER" <<'PY'
import json
import os
import re
import stat
import sys

fd = os.open(sys.argv[1], os.O_RDONLY | os.O_NOFOLLOW)
try:
    metadata = os.fstat(fd)
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_size < 2 or metadata.st_size > 65536:
        raise ValueError("invalid update marker")
    payload = os.read(fd, 65537)
    if len(payload) > 65536:
        raise ValueError("oversized update marker")
    version = json.loads(payload).get("version")
    if not isinstance(version, str) or not re.fullmatch(r"[A-Za-z0-9._-]{1,128}", version):
        raise ValueError("invalid update version")
    print(version)
finally:
    os.close(fd)
PY
  )"; then
    log "ERROR: prepared update marker is invalid"
    return 2
  fi
  if manifest="$(fetch_manifest "$(release_url_for_version "$version")")"; then :;
  else return "$?"; fi
  if ! printf '%s' "$manifest" | python3 -c '
import json
import re
import sys
from urllib.parse import urlsplit

expected_version = sys.argv[1]
payload = json.load(sys.stdin)
if not isinstance(payload, dict) or payload.get("version") != expected_version:
    raise ValueError("immutable release version mismatch")
sha256 = payload.get("sha256")
size = payload.get("size")
url = payload.get("url")
if not isinstance(sha256, str) or not re.fullmatch(r"[0-9a-fA-F]{64}", sha256):
    raise ValueError("immutable release digest missing")
if not isinstance(size, int) or isinstance(size, bool) or not 0 < size <= 20 * 1024**3:
    raise ValueError("invalid release size")
if not isinstance(url, str) or len(url) > 8192:
    raise ValueError("invalid release URL")
parts = urlsplit(url)
if parts.scheme != "https" or not parts.hostname or parts.username or parts.password or parts.fragment:
    raise ValueError("invalid release URL")
print(json.dumps(payload, separators=(",", ":")))
' "$version"; then
    log "ERROR: immutable release metadata is invalid"
    return 2
  fi
}

# Paired Preview hosts have no channel feed. Explicit version requests still use
# the existing verified metadata path and are never suppressed by this policy.
pair_updates_are_controller_managed() {
  local pair_handle="${MATRIX_HANDLE:-}"
  [ "${MATRIX_PREVIEW_RUNTIME:-}" = "true" ] && [ "${MATRIX_RUNTIME_SLOT:-}" = "$pair_handle" ] || return 1
  [[ "$pair_handle" =~ ^cp-([1-9][0-9]{0,8})-([a-f0-9]{8})-([1-9][0-9]{0,2})-([ab])$ ]] || return 1
  local pair_key="${BASH_REMATCH[2]}" pair_generation="${BASH_REMATCH[3]}"
  local pair_base_pattern="^https://cp-${pair_key}-g${pair_generation}-api---matrix-platform-preview-[a-z0-9.-]+\\.run\\.app/preview-pair-updates/${pair_handle}/?$"
  [[ "${MATRIX_UPDATE_MANIFEST_BASE_URL:-}" =~ $pair_base_pattern ]]
}

# Passive channel polling; sourced by the sync agent with the verified metadata helpers.
check_for_update() {
  # Explicit requests take priority until verified, applied, or replaced.
  if [ -e "$UPDATE_TRIGGER" ] || [ -L "$UPDATE_TRIGGER" ]; then return 0; fi
  if pair_updates_are_controller_managed; then return 0; fi
  local url manifest remote_version cur
  url="$(manifest_url)"
  if ! manifest="$(curl --fail --silent --show-error --max-time 15 "$url" 2>&1)"; then
    log "WARN: failed to fetch manifest from $url"; return 1
  fi
  remote_version="$(json_field "$manifest" version)"
  if [ -z "$remote_version" ]; then
    log "WARN: manifest missing 'version' field"; return 1
  fi
  cur="$(current_version)"
  if [ "$remote_version" = "$cur" ]; then
    rm -f "$UPDATE_MARKER"
    return 0
  fi

  local version_comparison
  version_comparison="$(compare_host_bundle_versions "$remote_version" "$cur")"
  if [ "$version_comparison" = "older" ]; then
    log "Ignoring older channel release: $remote_version (current: $cur)"
    rm -f "$UPDATE_MARKER" "$UPDATE_ERROR_MARKER"
    return 0
  fi

  local severity update_type
  severity="$(json_field "$manifest" severity)"
  update_type="$(json_field "$manifest" updateType)"

  log "Update available: $remote_version (current: $cur, severity: ${severity:-normal})"
  write_prepared_update_marker "$manifest" || return 1

  if [ "$severity" = "security" ] || [ "$update_type" = "auto" ]; then
    if [ -f "$AUTO_APPLY_FAILED_MARKER" ] && [ "$(cat "$AUTO_APPLY_FAILED_MARKER" 2>/dev/null)" = "$remote_version" ]; then
      log "Skipping auto-apply for $remote_version — previous attempt failed (use .update-now to retry)"
    else
      log "Auto-apply update $remote_version (severity=${severity:-normal}, updateType=${update_type:-manual})"
      if ! run_apply_update; then
        echo "$remote_version" > "$AUTO_APPLY_FAILED_MARKER"
        log "Auto-apply failed — will not retry automatically (use .update-now to force)"
      else
        rm -f "$AUTO_APPLY_FAILED_MARKER"
      fi
    fi
  fi
}
