[Unit]
Description=Register Matrix OS customer VPS with the platform
After=network-online.target matrix-gateway.service
Wants=network-online.target
ConditionPathExists=/opt/matrix/bin/matrix-register-vps
ConditionPathExists=!/var/lib/matrix-vps-registration/register-complete
# The registration token deadline enforced by matrix-register-vps is the
# lifetime bound. Disable systemd's independent start limiter so it cannot
# suppress a recoverable retry while that token is still valid.
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=matrix
Group=matrix
StateDirectory=matrix-vps-registration
StateDirectoryMode=0750
Environment=MATRIX_REGISTER_FLAG=/var/lib/matrix-vps-registration/register-complete
Environment=MATRIX_REGISTER_LOCK=/var/lib/matrix-vps-registration/register-complete.lock
EnvironmentFile=/opt/matrix/env/host.env
EnvironmentFile=/opt/matrix/env/registration.env
ExecStart=/opt/matrix/bin/matrix-register-vps
Restart=on-failure
RestartSec=60
SuccessExitStatus=64
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
