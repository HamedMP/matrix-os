[Unit]
Description=Matrix OS optional developer tools
After=network-online.target matrix-restore.service
Wants=network-online.target
Requires=matrix-restore.service
ConditionPathExists=/opt/matrix/bin/matrix-install-developer-tools

[Service]
Type=oneshot
User=root
Group=root
# npm CLIs such as Codex start with `#!/usr/bin/env node`; the post-install
# version check needs the bundled Node even where /usr/local/bin has no symlink.
Environment=PATH=/opt/matrix/runtime/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/opt/matrix/env/host.env
ExecStart=/opt/matrix/bin/matrix-install-developer-tools --tools-only
StateDirectory=matrix-developer-tools
TimeoutStartSec=3600
Restart=on-failure
RestartSec=120

[Install]
WantedBy=multi-user.target
