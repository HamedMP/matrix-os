[Unit]
Description=Matrix OS optional developer tools
After=network-online.target matrix-restore.service matrix-linux-tools.service
Wants=network-online.target
Requires=matrix-restore.service
ConditionPathExists=/opt/matrix/bin/matrix-install-developer-tools

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/opt/matrix/env/host.env
ExecStartPre=/opt/matrix/bin/matrix-wait-runtime-ready
ExecStart=/opt/matrix/bin/matrix-install-developer-tools --tools-only
StateDirectory=matrix-developer-tools
CPUWeight=10
IOWeight=10
Nice=10
IOSchedulingClass=idle
MemoryHigh=1G
MemoryMax=1536M
TimeoutStartSec=4800
Restart=on-failure
RestartSec=120

[Install]
WantedBy=multi-user.target
