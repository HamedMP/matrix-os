[Unit]
Description=Matrix OS customer restore gate
After=matrix-postgres.service
Requires=matrix-postgres.service

[Service]
Type=oneshot
User=matrix
Group=matrix
EnvironmentFile=/opt/matrix/env/host.env
ExecStart=/opt/matrix/bin/matrix-restore.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
