[Unit]
Description=Matrix OS customer gateway
After=matrix-restore.service matrix-terminal-runtime.service matrix-scope-runtime.service docker.service
Requires=matrix-restore.service docker.service
Wants=matrix-terminal-runtime.service matrix-scope-runtime.service
ConditionPathExists=/opt/matrix/restore-complete
ConditionPathExists=/opt/matrix/bin/matrix-gateway

[Service]
User=matrix
Group=matrix
EnvironmentFile=/opt/matrix/env/host.env
Environment=SYMPHONY_PORT=4766
Environment=MATRIX_NODE_PREFIX=/opt/matrix/runtime/node
Environment=MATRIX_HOME_MIRROR=true
Environment=MATRIX_CODING_AGENTS_WORKSPACE_PROVIDERS=claude,codex,pi,opencode
WorkingDirectory=/opt/matrix
ExecStartPre=+/opt/matrix/bin/matrix-install-developer-tools --sandbox-only
ExecStart=/opt/matrix/bin/matrix-gateway
TimeoutStartSec=720
Restart=on-failure
RestartSec=5
# Include gateway-launched work while reserving most RAM for the host. Fixed
# 1G/1.5G limits thrash on larger plans when active agent children share this
# cgroup, even though the host has free memory.
MemoryHigh=40%
MemoryMax=50%

[Install]
WantedBy=multi-user.target
