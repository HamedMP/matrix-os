# Cold boot of one Matrix VM (Cloud Hypervisor v54.1) managed by matrix-hostd.
# All per-VM values come from unit.env, written by hostd at create time.
# Lines prefixed with "+" run as root to prepare the tap and disk; the VMM
# itself runs unprivileged as matrix-vm.
[Unit]
Description=Matrix VM %i
After=network-online.target matrix-hostd-nft.service
RequiresMountsFor=/var/lib/matrix-hostd/snapshots
Conflicts=matrix-vm-restore@%i.service

[Service]
Type=simple
EnvironmentFile=/var/lib/matrix-hostd/vms/%i/unit.env
User=matrix-vm
Group=matrix-vm
SupplementaryGroups=kvm
RuntimeDirectory=matrix-vm/%i
RuntimeDirectoryMode=0700
LogsDirectory=matrix-vm
ExecStartPre=+-/usr/sbin/ip link delete ${TAP}
ExecStartPre=+/usr/sbin/ip tuntap add dev ${TAP} mode tap user ${VM_USER} group ${VM_USER}
# The tap is up before the VMM opens it: Cloud Hypervisor then needs no
# CAP_NET_ADMIN (on a down tap it fails enabling it with EPERM).
ExecStartPre=+/usr/sbin/ip link set dev ${TAP} master ${BRIDGE} up
ExecStartPre=+/usr/sbin/bridge link set dev ${TAP} isolated on
# Free-tier egress limit: police everything the VM sends at 50 Mbit/s.
ExecStartPre=+/usr/sbin/tc qdisc add dev ${TAP} handle ffff: ingress
ExecStartPre=+/usr/sbin/tc filter add dev ${TAP} parent ffff: protocol all prio 1 matchall action police rate 50mbit burst 512k conform-exceed drop
ExecStartPre=+/usr/bin/chown ${VM_USER}:${VM_USER} ${DISK}
ExecStart=/usr/local/bin/cloud-hypervisor \
  --api-socket path=${API_SOCKET} \
  --kernel ${KERNEL} \
  --initramfs ${INITRAMFS} \
  --cmdline ${KERNEL_CMDLINE} \
  --cpus boot=${VCPUS} \
  --memory size=${BOOT_MIB}M,hotplug_method=virtio-mem,hotplug_size=${HOTPLUG_MIB}M \
  --balloon size=0,free_page_reporting=on,deflate_on_oom=on \
  --disk path=${DISK},image_type=raw path=${SEED},image_type=raw,readonly=on \
  --net tap=${TAP},mac=${MAC} \
  --vsock cid=${VSOCK_CID},socket=${VSOCK_SOCKET} \
  --serial file=${SERIAL_PATH} \
  --console off
ExecStopPost=+-/usr/sbin/ip link delete ${TAP}
Restart=no
KillMode=mixed
TimeoutStopSec=30
CPUQuota=200%
CPUWeight=100
IOWeight=100
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/matrix-hostd/snapshots /var/log/matrix-vm

