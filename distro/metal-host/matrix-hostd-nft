#!/usr/bin/env bash
# Loads hostd's nftables tables (see nftables.conf), the host firewall of a
# metal host, without touching any other table. Before loading it checks the
# rendered ruleset still accepts SSH on the public interface, so a template
# or parameter mistake cannot lock the host out.
#
#   matrix-hostd-nft render --template T --wan IF --ingress-port N --api-port N
#   matrix-hostd-nft check FILE --wan IF   # exit 0 only if SSH on IF is accepted
#   matrix-hostd-nft apply                 # uses /etc/matrix-hostd/nft.env
#   matrix-hostd-nft remove
set -euo pipefail

readonly ENV_FILE=/etc/matrix-hostd/nft.env
readonly TEMPLATE=/usr/local/share/matrix-hostd/nftables.conf
readonly RENDERED=/etc/matrix-hostd/nftables.nft

die() { printf 'matrix-hostd-nft: %s\n' "$*" >&2; exit 1; }

valid_port() { [[ "$1" =~ ^[0-9]{1,5}$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }
valid_iface() { [[ "$1" =~ ^[A-Za-z0-9_.-]{1,15}$ ]]; }

render() {
  local template="$1" wan="$2" ingress="$3" api="$4"
  valid_iface "$wan" || die "invalid WAN interface"
  valid_port "$ingress" || die "invalid ingress port"
  valid_port "$api" || die "invalid API port"
  [ -f "$template" ] || die "template missing"
  grep -v '^[[:space:]]*#' "$template" | sed \
    -e "s/@WAN@/${wan}/g" \
    -e "s/@INGRESS_PORT@/${ingress}/g" \
    -e "s/@API_PORT@/${api}/g"
}

# The input chain must accept new SSH on the public interface before any rule
# that drops. Checked on the exact text that will be loaded.
check_ssh() {
  local file="$1" wan="$2"
  valid_iface "$wan" || die "invalid WAN interface"
  python3 -I - "$file" "$wan" <<'PY' || die "ruleset does not accept SSH on $wan; refusing to load it"
import re, sys
path, wan = sys.argv[1:]
text = open(path).read()
m = re.search(r"table inet matrix_hostd \{.*?chain input \{(.*?)\n  \}", text, re.S)
if not m:
    sys.exit(1)
for line in (l.strip() for l in m.group(1).splitlines()):
    if line == f'iifname "{wan}" tcp dport 22 accept':
        sys.exit(0)
    if line != "ct state invalid drop" and (line.endswith(" drop") or line.endswith(" reject")):
        sys.exit(1)
sys.exit(1)
PY
}

load_env() {
  [ -f "$ENV_FILE" ] || die "missing $ENV_FILE"
  WAN="$(sed -n 's/^WAN=//p' "$ENV_FILE")"
  INGRESS_PORT="$(sed -n 's/^INGRESS_PORT=//p' "$ENV_FILE")"
  API_PORT="$(sed -n 's/^API_PORT=//p' "$ENV_FILE")"
}

cmd="${1:-}"
[ "$#" -gt 0 ] && shift
case "$cmd" in
  render)
    template="" wan="" ingress="" api=""
    while [ "$#" -gt 0 ]; do
      [ "$#" -ge 2 ] || die "missing value for $1"
      case "$1" in
        --template) template="$2" ;;
        --wan) wan="$2" ;;
        --ingress-port) ingress="$2" ;;
        --api-port) api="$2" ;;
        *) die "unknown option $1" ;;
      esac
      shift 2
    done
    render "$template" "$wan" "$ingress" "$api"
    ;;
  check)
    if [ "$#" -ne 3 ] || [ "$2" != --wan ]; then die "usage: matrix-hostd-nft check FILE --wan IF"; fi
    check_ssh "$1" "$3"
    ;;
  apply)
    load_env
    umask 022
    render "$TEMPLATE" "$WAN" "$INGRESS_PORT" "$API_PORT" >"$RENDERED.tmp"
    check_ssh "$RENDERED.tmp" "$WAN"
    nft -c -f "$RENDERED.tmp"
    mv -f "$RENDERED.tmp" "$RENDERED"
    nft -f "$RENDERED"
    ;;
  remove)
    if nft list table inet matrix_hostd >/dev/null 2>&1; then nft delete table inet matrix_hostd; fi
    if nft list table ip matrix_hostd_nat >/dev/null 2>&1; then nft delete table ip matrix_hostd_nat; fi
    ;;
  *) die "usage: matrix-hostd-nft render|check|apply|remove" ;;
esac
