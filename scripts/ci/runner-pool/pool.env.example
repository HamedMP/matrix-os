# /etc/matrix-ci-pool/pool.env (root:root, 0600). See scripts/ci/runner-pool/README.md.
REPOSITORY=HamedMP/matrix-os
# The existing Matrix CI gate app (vars MATRIX_CI_GATE_APP_ID / _INSTALLATION_ID) with repository
# Administration (write) and Variables (write) added to its permissions.
APP_ID=5271502
INSTALLATION_ID=170192752
APP_KEY_FILE=/etc/matrix-ci-pool/app.pem
# 4 slots x 8 CPUs fits a 32-CPU host; keep SLOTS * SLOT_CPUS <= logical CPUs.
SLOTS=4
SLOT_CPUS=8
SLOT_MEMORY=28g
IMAGE=matrix-ci-runner:current
LABEL=matrix-ci
JOB_TIMEOUT_SECONDS=7200
