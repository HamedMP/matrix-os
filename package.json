{
  "name": "matrix-os",
  "version": "0.9.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "bin": {
    "matrixos": "./bin/matrixos.mjs",
    "matrix": "./bin/matrixos.mjs",
    "mos": "./bin/matrixos.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "postinstall": "node scripts/fix-node-pty-perms.mjs",
    "dev": "pnpm --filter '@matrix-os/observability' --filter '@matrix-os/brand' --filter '@matrix-os/kernel' build && pnpm --parallel --filter '@matrix-os/gateway' --filter '@matrix-os/proxy' --filter './shell' dev",
    "dev:kernel": "pnpm --filter '@matrix-os/kernel' dev",
    "dev:gateway": "pnpm --filter '@matrix-os/observability' --filter '@matrix-os/kernel' build && pnpm --filter '@matrix-os/gateway' dev",
    "dev:speech": "node scripts/dev-speech-stack.mjs",
    "dev:speech:fixture": "node --import=tsx scripts/dev-speech-fixture.ts",
    "dev:shell": "pnpm --filter '@matrix-os/observability' --filter '@matrix-os/brand' build && pnpm --filter './shell' dev",
    "dev:mobile-shell": "pnpm --filter '@matrix-os/observability' build && pnpm --filter '@matrix-os/kernel' build && echo 'Mobile shell: http://localhost:3000/?launch=__terminal__' && (MATRIX_AUTH_ALLOW_INSECURE_DEV=1 pnpm --filter '@matrix-os/gateway' dev & E2E_TEST_BYPASS=1 NEXT_PUBLIC_E2E_TEST_BYPASS=1 pnpm --filter './shell' dev)",
    "dev:desktop": "pnpm --filter desktop dev",
    "build:desktop": "pnpm --filter desktop build",
    "generate:desktop-dmg-background": "node scripts/generate-desktop-dmg-background.mjs",
    "build:shell:production": "pnpm --filter './shell' build",
    "dev:proxy": "pnpm --filter '@matrix-os/observability' build && pnpm --filter '@matrix-os/proxy' dev",
    "dev:platform": "pnpm --filter '@matrix-os/observability' --filter '@matrix-os/brand' build && pnpm --filter '@matrix-os/platform' dev",
    "docker:prepare": "docker volume create matrixos-ai-auth",
    "docker": "bun run docker:prepare && docker compose --env-file .env.docker -f docker-compose.dev.yml up",
    "docker:full": "bun run docker:prepare && docker compose --env-file .env.docker -f docker-compose.dev.yml --profile full up",
    "docker:full:smoke": "node scripts/dev-stack-smoke.mjs",
    "docker:all": "bun run docker:prepare && docker compose --env-file .env.docker -f docker-compose.dev.yml --profile full --profile obs up",
    "docker:multi": "bun run docker:prepare && docker compose --env-file .env.docker -f docker-compose.dev.yml --profile full --profile multi up",
    "docker:stop": "docker compose --env-file .env.docker -f docker-compose.dev.yml --profile full --profile obs --profile multi stop",
    "docker:restart": "docker compose --env-file .env.docker -f docker-compose.dev.yml restart dev",
    "docker:logs": "docker compose --env-file .env.docker -f docker-compose.dev.yml logs -f dev",
    "docker:shell": "docker compose --env-file .env.docker -f docker-compose.dev.yml exec -u matrixos dev sh",
    "docker:build": "docker compose --env-file .env.docker -f docker-compose.dev.yml build --no-cache",
    "cleanup:local-artifacts": "node scripts/cleanup-local-artifacts.mjs",
    "observability:posthog-alerts": "node scripts/observability/setup-posthog-alerts.mjs",
    "spike:agent-sdk": "node scripts/spikes/agent-sdk-gateway/run.mjs",
    "release:enqueue-golden-snapshot": "node scripts/enqueue-golden-snapshot.mjs",
    "test": "node packages/gateway/native/build.mjs && sh -c 'pnpm --filter @matrix-os/observability build && pnpm --filter @matrix-os/brand build && pnpm --filter @matrix-os/kernel build && pnpm --filter @matrix-os/integrations-mcp build && vitest run \"$@\"' --",
    "test:isolated": "node scripts/dev/isolated-test-job.mjs -- bun run test -- --maxWorkers=1",
    "test:prepare": "node packages/gateway/native/build.mjs && pnpm --filter @matrix-os/observability build && pnpm --filter @matrix-os/brand build && pnpm --filter @matrix-os/kernel build && pnpm --filter @matrix-os/integrations-mcp build",
    "test:golden-snapshots": "bun run test -- --maxWorkers=1 --no-file-parallelism tests/platform/golden-snapshot-*.test.ts tests/platform/host-bundle-snapshot-workflow.test.ts tests/platform/host-bundle-route.test.ts tests/platform/r2-client.test.ts tests/platform/ci-workflows.test.ts tests/platform/customer-vps.test.ts tests/platform/customer-vps-cloud-init.test.ts tests/platform/customer-vps-hetzner.test.ts tests/platform/customer-vps-host-bundle.test.ts tests/platform/customer-vps-config-contracts.test.ts tests/platform/customer-vps-preview-slots.test.ts tests/platform/customer-vps-resize.test.ts tests/platform/customer-vps-bundle-provisioning.test.ts tests/platform/customer-vps-deploy.test.ts tests/platform/customer-vps-registration-delete.test.ts tests/platform/customer-vps-recovery.test.ts tests/platform/customer-vps-reconcile-billing.test.ts",
    "test:watch": "node packages/gateway/native/build.mjs && sh -c 'pnpm --filter @matrix-os/observability build && pnpm --filter @matrix-os/kernel build && vitest \"$@\"' --",
    "test:integration": "node packages/gateway/native/build.mjs && vitest run --config vitest.integration.config.ts",
    "test:coverage": "node packages/gateway/native/build.mjs && sh -c 'pnpm --filter @matrix-os/observability build && pnpm --filter @matrix-os/kernel build && pnpm --filter @matrix-os/integrations-mcp build && vitest run --coverage \"$@\"' --",
    "test:e2e": "node packages/gateway/native/build.mjs && sh -c 'pnpm --filter @matrix-os/observability build && pnpm --filter @matrix-os/brand build && pnpm --filter @matrix-os/kernel build && vitest run --config vitest.e2e.config.ts \"$@\"' --",
    "test:e2e:run": "vitest run --config vitest.e2e.config.ts",
    "typecheck:build-kernel": "pnpm --filter '@matrix-os/observability' build && pnpm --filter '@matrix-os/kernel' build && pnpm --filter '@matrix-os/integrations-mcp' build",
    "typecheck": "bun run typecheck:build-kernel && bun run typecheck:run",
    "typecheck:run": "node scripts/typecheck.mjs",
    "typecheck:legacy": "node scripts/typecheck.mjs legacy",
    "check:patterns": "./scripts/review/check-patterns.sh",
    "check:patterns:diff": "./scripts/review/check-patterns.sh --diff main",
    "lint": "bun run --filter './shell' lint"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "node-pty",
      "esbuild",
      "electron",
      "sharp",
      "unrs-resolver",
      "@next/swc-linux-arm64-musl",
      "@next/swc-linux-x64-musl"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "kysely-codegen>kysely": "^0.28.0"
      }
    },
    "packageExtensions": {
      "react-native-webview@*": {
        "dependencies": {
          "@types/react": "^19.2.14"
        }
      },
      "eslint-config-next@16.2.3": {
        "dependencies": {
          "next": "16.4.1"
        }
      },
      "electron-vite@*": {
        "dependencies": {
          "electron": "^41.0.3"
        }
      },
      "node-pty@*": {
        "dependencies": {
          "node-gyp": "12.3.0"
        }
      },
      "@react-native/jest-preset@*": {
        "dependencies": {
          "react-native": "0.86.3",
          "@babel/runtime": "^7.29.0"
        }
      },
      "react-native-worklets@*": {
        "dependencies": {
          "@babel/generator": "^7.29.0",
          "@babel/traverse": "^7.29.0"
        }
      },
      "react-native-edge-to-edge@*": {
        "dependencies": {
          "@expo/config-plugins": "57.0.9"
        }
      },
      "langium@4.2.1": {
        "dependencies": {
          "@chevrotain/regexp-to-ast": "11.1.2",
          "vscode-jsonrpc": "8.2.0",
          "vscode-languageserver-protocol": "3.17.5",
          "vscode-languageserver-types": "3.17.5"
        }
      }
    },
    "patchedDependencies": {
      "app-builder-lib@26.15.3": "patches/app-builder-lib@26.15.3.patch"
    },
    "overrides": {
      "@earendil-works/pi-ai": "1.0.0",
      "@earendil-works/chord": "1.0.0",
      "@earendil-works/pi-telemetry": "1.0.0",
      "electron-vite>vite": "npm:rolldown-vite@7.3.1",
      "git-diff@>=2.0.0 <2.0.7": "2.0.7",
      "dompurify@>=3.0.0 <3.4.17": "3.4.17",
      "proxy-addr@>=2.0.0 <2.0.8": "2.0.8",
      "tar@>=7.0.0 <7.5.21": "7.5.21",
      "protobufjs@>=7.0.0 <7.6.5": "7.6.5",
      "@clerk/shared@>=3.0.0 <3.47.5": "3.47.5",
      "undici@>=6.0.0 <6.29.1": "6.29.1",
      "undici@>=7.0.0 <7.30.1": "7.30.1",
      "vitest@>=4.0.0 <4.1.12": "4.1.12",
      "shell-quote@>=1.1.0 <1.11.0": "1.11.0",
      "node-forge@>=1.0.0 <1.4.0": "1.4.0",
      "picomatch@>=2.0.0 <2.3.2": "2.3.2",
      "path-to-regexp@>=8.0.0 <8.4.0": "8.4.0",
      "@xmldom/xmldom@>=0.8.0 <0.8.15": "0.8.15",
      "fast-xml-builder@>=1.0.0 <1.1.7": "1.1.7",
      "@clerk/clerk-react@>=5.0.0 <5.61.6": "5.61.6",
      "@clerk/clerk-js@>=5.0.0 <5.125.10": "5.125.10",
      "@clerk/backend@>=2.0.0 <2.33.3": "2.33.3",
      "@grpc/grpc-js@>=1.0.0 <1.14.5": "1.14.5",
      "js-cookie@>=3.0.0 <3.0.7": "3.0.7",
      "form-data@>=2.0.0 <2.5.6": "2.5.6",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "nanoid@>=5.0.0 <5.1.16": "5.1.16",
      "browserslist@>=4.0.0 <4.28.7": "4.28.7",
      "immutable@>=4.0.0 <4.3.9": "4.3.9",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "compression@>=1.0.0 <1.8.2": "1.8.2",
      "prosemirror-view@>=1.0.0 <1.42.3": "1.42.3",
      "@modelcontextprotocol/sdk@>=1.0.0 <1.32.0": "1.32.0",
      "viem>ws": "8.21.0",
      "jsdom>ws": "8.21.0",
      "react-devtools-core>ws": "7.5.11",
      "miniflare>ws": "8.21.0",
      "qs@>=6.0.0 <6.16.1": "6.16.1",
      "yaml@>=1.0.0 <1.10.3": "1.10.3",
      "yaml@>=2.0.0 <2.8.3": "2.8.3",
      "fast-xml-parser@>=5.0.0 <5.7.0": "5.7.0",
      "mermaid@>=11.0.0 <11.16.1": "11.16.1",
      "postcss@>=8.0.0 <8.5.23": "8.5.23",
      "@humanfs/node@>=0.16.0 <0.16.8": "0.16.8",
      "fflate@>=0.4.0 <0.4.9": "0.4.9",
      "fflate@>=0.6.0 <0.6.11": "0.6.11",
      "fflate@>=0.8.0 <0.8.3": "0.8.3",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": "2.11.0",
      "ip-address@>=10.0.0 <10.7.4": "10.7.4",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "brace-expansion@>=1.0.0 <1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "brace-expansion@>=5.0.0 <5.0.12": "5.0.12",
      "postcss-selector-parser@>=7.0.0 <7.1.6": "7.1.6",
      "@modelcontextprotocol/sdk>hono": "^4.13.11",
      "@modelcontextprotocol/sdk>@hono/node-server": "^1.19.15",
      "lodash@>=4.0.0 <4.18.1": "4.18.1",
      "lodash-es@>=4.0.0 <4.18.1": "4.18.1"
    }
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@matrix-os/gateway": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "4.1.12",
    "better-sqlite3": "^12.10.0",
    "chess.js": "1.4.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.25",
    "lexical": "0.41.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vite": "^6.4.4",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.9",
    "@types/pg": "^8.18.0",
    "ink": "^6.2.3",
    "pg": "^8.21.0",
    "yaml": "^2.8.3"
  }
}
